        echo "checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] }}"
        echo "lerobot: {{ lerobot_repo }}@{{ lerobot_commit[:8] }}"
        echo "benchmark: robotwin2"
        echo "suite: ${SUITE}"
        echo "setting: ${SETTING}"
        echo "task_config: ${TASK_CONFIG}"
        echo "robotwin_task: ${RT_TASK}"
        echo "n_episodes_per_task: ${N_EPISODES}"
        echo "success_rate: ${SR}"
        echo "n_success: $(jq -r '.overall.n_success // empty' "${INFO_JSON}" 2>/dev/null)"
        echo "n_episodes: $(jq -r '.overall.n_episodes // empty' "${INFO_JSON}" 2>/dev/null)"
        echo "condition: {{ protocol }}"
        echo "episode_length: ${EPISODE_LENGTH}"
        echo "seed: ${SEED}"
        echo "unstable_seeds_skipped: ${UNSTABLE_SEEDS}"
        echo "eval_exit: ${EVAL_EXIT}"

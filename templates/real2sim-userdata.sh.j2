#!/bin/bash
# Real2Sim 1-Click UserData Script (capture -> 3DGS -> collision meshes -> MuJoCo grasp replay)
# Input:      {% if input_source == 'hope' %}HOPE-Video scene {{ '%04d' % hope_scene }} (CC BY-NC-SA 4.0, research / non-commercial; downloaded at run time){% else %}your capture zip (input.capture_s3_uri in models/{{ vla }}.yaml){% endif %}
# 3DGS:       nerfstudio {{ nerfstudio_version }} splatfacto, gsplat {{ gsplat_version }}, torch {{ torch_version }} (Python {{ splat_python }})
# Sim:        MuJoCo + Menagerie UR5e / Robotiq 2F-85 @ {{ menagerie_commit[:8] }} (Python {{ sim_python }})
# Stages:     assets/real2sim/*.py (embedded below)
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName}       — results S3 bucket
#   ${SnsTopicArn}        — completion notification SNS topic
#   ${StackName}          — CDK stack name
#   ${WaitConditionUrl}   — CFN WaitConditionHandle presigned URL
#   ${Region}             — deployment region
#   ${AutoTerminate}      — "true" to auto-terminate EC2 after completion

set -euo pipefail

W=/opt/r2s
ASSETS_DIR="${W}/assets"
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

# UserData runs as root; HOME must be set so uv puts caches in a stable place.
export HOME=/root
# uv installs into ~/.local/bin
export PATH="/root/.local/bin:${PATH}"
mkdir -p "${W}/out" "${W}/videos"

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a /var/log/{{ vla }}-userdata.log; }

# Stage markers: one line per finished stage, mirrored to s3://<bucket>/<run>/STAGES so a run can be
# followed (and a failure located) without opening the logs.
stage() {
    echo "$(date -u '+%H:%M:%S') $*" >> "${W}/out/STAGES"
    aws s3 cp "${W}/out/STAGES" "s3://${S3_BUCKET}/${RUN_ID}/STAGES" --region "$REGION" >/dev/null 2>&1 || true
}

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/{{ vla }}-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

die() {
    log "ERROR: $*"
    stage "FAILED: $*"
    # Best-effort: dump diagnostics to S3 before CFN rollback eats the instance
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ]; then
        local _diag_prefix="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag-fail"
        log "  Uploading logs to ${_diag_prefix}..."
        aws s3 cp /var/log/{{ vla }}-userdata.log "${_diag_prefix}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ vla }}_*.log "${W}"/out/*.txt "${W}"/out/*.json; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag_prefix}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
    fi
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        stage "FAILED: abnormal exit (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}) ====="
stage boot

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/8] System dependencies ──────────────────────────────────────
log "[1/8] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive

systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
pkill -9 -f "apt-get" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a 2>&1 | tee /tmp/{{ vla }}_dpkg_fix.log || true

# Boot hardening (2026-10): the command-not-found apt hook hung apt-get update for 3 h on a g6e, and the
# apt-daily timers re-launch unattended-upgrades mid-boot (held the dpkg lock past 5 min). Drop / mask both.
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 2>&1 | tee /tmp/{{ vla }}_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    log "[warn] apt-get update failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    git curl ca-certificates awscli jq unzip \
    libgl1-mesa-glx libegl1 libgles2 libosmesa6 \
    libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
    ffmpeg \
    2>&1 | tee /tmp/{{ vla }}_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    log "[warn] apt-get install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# ── [1.5/8] CloudWatch Logs agent setup ──────────────────────────
log "[1.5/8] Setting up CloudWatch Logs agent..."
# Log group MUST match the stack's IAM grant (/${vla}/* → /{{ vla }}/*).
CW_LOG_GROUP="/{{ vla }}/userdata"
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s 2>&1 | tee /tmp/{{ vla }}_cwagent.log \
        && log "  CW agent started (log group: ${CW_LOG_GROUP})" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi
stage packages_ok

# ── [2/8] NVIDIA driver check + VRAM / host-RAM floors ───────────────
log "[2/8] Checking GPU driver..."
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv 2>&1 | tee "${W}/out/gpu.txt" \
    || log "[warn] nvidia-smi failed — verify DLAMI"
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || echo "0")
log "  GPU0 memory: ${GPU_MEM_MIB} MiB"
if [ "${GPU_MEM_MIB:-0}" -lt {{ min_gpu_mib }} ]; then
    die "{{ display_name }} needs a single GPU >= {{ min_gpu_mib }} MiB; GPU0 has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
log "  Host RAM: ${HOST_MEM_MIB} MiB"
if [ "${HOST_MEM_MIB:-0}" -lt {{ min_host_mib }} ]; then
    die "{{ display_name }} needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi

# ── [3/8] Stage scripts + uv + geometry/simulation venv + Menagerie (pinned) ──
log "[3/8] Writing the stage scripts to ${ASSETS_DIR}..."
mkdir -p "${ASSETS_DIR}"
{% for name, b64 in assets %}
base64 -d > "${ASSETS_DIR}/{{ name }}" << 'R2S_ASSET_EOF'
{{ b64 -}}
R2S_ASSET_EOF
{% endfor %}
log "  assets: $(ls -1 "${ASSETS_DIR}" | tr '\n' ' ')"

log "[3/8] Installing uv (DLAMI does not pre-install)..."
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh 2>&1 | tee /tmp/{{ vla }}_uv_install.log \
        || die "uv install failed"
fi
log "  $(uv --version)"

log "[3/8] Geometry + simulation venv (Python {{ sim_python }})..."
SIM_PY="${W}/sim/bin/python"
uv venv -q -p {{ sim_python }} "${W}/sim" 2>&1 | tee /tmp/{{ vla }}_sim_venv.log || die "uv venv (sim) failed"
# shellcheck disable=SC2086
uv pip install -q --python "${SIM_PY}" {{ sim_pins }} 2>&1 | tee /tmp/{{ vla }}_sim_pip.log \
    || die "sim venv install failed (see /tmp/{{ vla }}_sim_pip.log)"
"${SIM_PY}" -c "import open3d, trimesh, mujoco, pxr; print('open3d', open3d.__version__, 'trimesh', trimesh.__version__, 'mujoco', mujoco.__version__)" \
    2>&1 | tee -a "${W}/out/versions.txt" || die "sim venv import check failed"

log "[3/8] MuJoCo Menagerie @ {{ menagerie_commit[:8] }} (robotiq_2f85 + universal_robots_ur5e only)..."
MENAGERIE="${W}/menagerie"
rm -rf "${MENAGERIE}"
git init -q "${MENAGERIE}"
git -C "${MENAGERIE}" remote add origin {{ menagerie_repo }}
git -C "${MENAGERIE}" sparse-checkout set robotiq_2f85 universal_robots_ur5e
timeout 600 git -C "${MENAGERIE}" fetch -q --depth 1 --filter=blob:none origin {{ menagerie_commit }} 2>&1 | tee /tmp/{{ vla }}_menagerie.log \
    || die "Menagerie fetch failed"
git -C "${MENAGERIE}" checkout -q FETCH_HEAD || die "Menagerie checkout failed"
[ "$(git -C "${MENAGERIE}" rev-parse HEAD)" = "{{ menagerie_commit }}" ] || die "Menagerie commit mismatch"
[ -f "${MENAGERIE}/robotiq_2f85/2f85.xml" ] && [ -f "${MENAGERIE}/universal_robots_ur5e/ur5e.xml" ] || die "Menagerie models missing"

# MuJoCo renders the grasp videos offscreen: EGL on the NVIDIA driver, OSMesa (CPU) if EGL is not usable.
export MUJOCO_GL=egl
if ! "${SIM_PY}" -c "import mujoco; m = mujoco.MjModel.from_xml_string('<mujoco/>'); mujoco.Renderer(m, 64, 64).render()" >/tmp/{{ vla }}_gl_probe.log 2>&1; then
    log "[warn] MuJoCo EGL render probe failed — falling back to OSMesa (slower)"
    export MUJOCO_GL=osmesa
    export PYOPENGL_PLATFORM=osmesa
fi
log "  MUJOCO_GL=${MUJOCO_GL}"
stage "sim_venv_ok MUJOCO_GL=${MUJOCO_GL}"

# ── [4/8] Input capture → nerfstudio data dir ──────────────────────
DATA="${W}/data"
GT_ARGS=""
{% if input_source == 'hope' %}
INPUT_LABEL="hope-video-scene-{{ '%04d' % hope_scene }}"
log "[4/8] Downloading HOPE-Video scene {{ hope_scene }} + GT meshes (CC BY-NC-SA 4.0, research / non-commercial)..."
PATH="${W}/sim/bin:${PATH}" timeout 2400 "${SIM_PY}" "${ASSETS_DIR}/hope_fetch.py" --scene {{ hope_scene }} --out "${W}/hope" \
    2>&1 | tee /tmp/{{ vla }}_hope_fetch.log || die "HOPE-Video download failed (Google Drive quota? see /tmp/{{ vla }}_hope_fetch.log)"
SCENE_DIR="${W}/hope/scene_{{ '%04d' % hope_scene }}"
GT_ARGS="--gt-scene ${SCENE_DIR} --gt-meshes ${W}/hope/meshes/eval"
"${SIM_PY}" "${ASSETS_DIR}/prep_capture.py" --hope "${SCENE_DIR}" --out "${DATA}" \
    2>&1 | tee /tmp/{{ vla }}_prep.log || die "prep_capture failed"
{% else %}
INPUT_LABEL="capture"
log "[4/8] Fetching your capture {{ capture_s3_uri }}..."
aws s3 cp "{{ capture_s3_uri }}" "${W}/capture.zip" --region "$REGION" 2>&1 | tee /tmp/{{ vla }}_capture.log \
    || die "could not read {{ capture_s3_uri }} (the instance role may read exactly this object)"
"${SIM_PY}" "${ASSETS_DIR}/prep_capture.py" --capture "${W}/capture.zip" --out "${DATA}" \
    2>&1 | tee /tmp/{{ vla }}_prep.log || die "prep_capture failed (expected a zip with images/ + transforms.json)"
{% endif %}
cp "${DATA}/capture_info.json" "${W}/out/capture_info.json"
stage "data_ok $(jq -c . "${DATA}/capture_info.json" 2>/dev/null | head -c 300)"

# ── [5/8] 3D Gaussian Splatting (nerfstudio splatfacto) ──────────────
log "[5/8] 3DGS venv (Python {{ splat_python }}, torch {{ torch_version }}, gsplat {{ gsplat_version }}, nerfstudio {{ nerfstudio_version }})..."
NS="${W}/ns"
uv venv -q -p {{ splat_python }} "${NS}" 2>&1 | tee /tmp/{{ vla }}_ns_venv.log || die "uv venv (3dgs) failed"
uv pip install -q --python "${NS}/bin/python" torch=={{ torch_version }} torchvision=={{ torchvision_version }} \
    --index-url {{ torch_index }} 2>&1 | tee /tmp/{{ vla }}_torch.log || die "torch install failed"
uv pip install -q --python "${NS}/bin/python" "gsplat=={{ gsplat_version }}" --extra-index-url {{ gsplat_index }} \
    2>&1 | tee /tmp/{{ vla }}_gsplat.log || die "gsplat wheel install failed (no prebuilt wheel for this torch/CUDA?)"
uv pip install -q --python "${NS}/bin/python" "nerfstudio=={{ nerfstudio_version }}" imageio-ffmpeg "numpy<2" \
    2>&1 | tee /tmp/{{ vla }}_nerfstudio.log || die "nerfstudio install failed"
command -v ffmpeg >/dev/null 2>&1 || ln -sf "$("${NS}/bin/python" -c 'import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())')" /usr/local/bin/ffmpeg
"${NS}/bin/python" -c "import torch, gsplat, nerfstudio; print('torch', torch.__version__, 'cuda', torch.cuda.is_available(), 'gsplat', gsplat.__version__)" \
    2>&1 | tee -a "${W}/out/versions.txt" || die "3dgs venv import check failed"
"${NS}/bin/python" -c "import torch; assert torch.cuda.is_available()" || die "torch sees no CUDA GPU"
stage "splat_venv_ok"

log "[5/8] ns-train splatfacto ({{ max_iterations }} iterations)..."
T0=$(date +%s)
set +e
trap - ERR
timeout {{ train_timeout_s }} "${NS}/bin/ns-train" splatfacto --vis tensorboard --max-num-iterations {{ max_iterations }} \
    --output-dir "${W}/runs" --experiment-name r2s --timestamp run \
    --viewer.quit-on-train-completion True nerfstudio-data --data "${DATA}" > "${W}/out/train.txt" 2>&1
TRAIN_RC=$?
set -e
trap '_trap_handler' ERR
T1=$(date +%s)
stage "train_rc_${TRAIN_RC} sec_$((T1 - T0))"
CFG="${W}/runs/r2s/splatfacto/run/config.yml"
[ -f "${CFG}" ] || CFG=$(ls "${W}"/runs/*/splatfacto/*/config.yml 2>/dev/null | head -1 || true)
[ "${TRAIN_RC}" -eq 0 ] && [ -n "${CFG}" ] && [ -f "${CFG}" ] || die "splatfacto training failed (rc=${TRAIN_RC}, see out/train.txt)"
RUN_DIR=$(dirname "${CFG}")
cp "${RUN_DIR}/dataparser_transforms.json" "${W}/out/dataparser_transforms.json" || die "no dataparser_transforms.json"

"${NS}/bin/ns-eval" --load-config "${CFG}" --output-path "${W}/out/metrics.json" > "${W}/out/eval.txt" 2>&1 \
    || log "[warn] ns-eval failed (see out/eval.txt)"
"${NS}/bin/ns-export" gaussian-splat --load-config "${CFG}" --output-dir "${W}/out/ply" > "${W}/out/export.txt" 2>&1 \
    || die "ns-export gaussian-splat failed (see out/export.txt)"
"${NS}/bin/ns-render" interpolate --load-config "${CFG}" --pose-source train --interpolation-steps 1 --frame-rate 30 \
    --output-format video --output-path "${W}/videos/splat_orbit.mp4" > "${W}/out/render.txt" 2>&1 \
    || log "[warn] ns-render failed (see out/render.txt) — no orbit video"
NG=$(head -c 2000 "${W}/out/ply/splat.ply" 2>/dev/null | grep -a 'element vertex' | awk '{print $3}' || true)
printf '{"train_sec": %d, "train_rc": %d, "max_iterations": %d, "gaussians": "%s", "gpu": "%s"}\n' \
    $((T1 - T0)) "${TRAIN_RC}" {{ max_iterations }} "${NG}" "$(tail -1 "${W}/out/gpu.txt" 2>/dev/null)" > "${W}/out/train.json"
stage "splat_ok gaussians_${NG} $(jq -c '.results | {psnr, ssim, lpips}' "${W}/out/metrics.json" 2>/dev/null || echo no-metrics)"

# ── [6/8] Splat → capture frame → table + per-object collision meshes ──
log "[6/8] Splat centres back to the metric capture frame + segmentation..."
CHECK_ARGS=""
[ -f "${DATA}/sparse_pc.ply" ] && CHECK_ARGS="--check-cloud ${DATA}/sparse_pc.ply"
# shellcheck disable=SC2086
"${SIM_PY}" "${ASSETS_DIR}/ns_to_world.py" "${W}/out/ply/splat.ply" "${W}/out/dataparser_transforms.json" \
    "${W}/out/splat_world.ply" --min-opacity {{ splat_min_opacity }} ${CHECK_ARGS} | tee "${W}/out/frame.json" \
    || die "ns_to_world failed"
# shellcheck disable=SC2086
"${SIM_PY}" "${ASSETS_DIR}/r2s_segment.py" --cloud "${W}/out/splat_world.ply" --out "${W}/out/segment" \
    --cameras "${DATA}/transforms.json" ${GT_ARGS} {{ segment_args }} 2>&1 | tee /tmp/{{ vla }}_segment.log \
    || die "segmentation failed"
N_OBJ=$(jq -r '.n_objects' "${W}/out/segment/segment.json" 2>/dev/null || echo 0)
stage "segment_ok n_objects_${N_OBJ}"
[ "${N_OBJ:-0}" -gt 0 ] || die "segmentation found no objects on the table (see out/segment/segment.json)"

# ── [7/8] Scripted grasp replay in MuJoCo (recon / scenehull{% if input_source == 'hope' %} / gt{% endif %}) ──
log "[7/8] Grasp replay, floating Robotiq 2F-85..."
# shellcheck disable=SC2086
timeout 1800 "${SIM_PY}" "${ASSETS_DIR}/r2s_grasp_mj.py" --seg "${W}/out/segment" --menagerie "${MENAGERIE}" \
    --out "${W}/out/grasp" ${GT_ARGS} --video --max-videos {{ max_video_targets }} 2>&1 | tee /tmp/{{ vla }}_grasp.log \
    || die "grasp replay failed"
stage "grasp_hand_ok $(jq -c '.summary' "${W}/out/grasp/grasp.json" 2>/dev/null)"
{% if grasp_ur5e %}
log "[7/8] Grasp replay, UR5e + Robotiq 2F-85..."
# shellcheck disable=SC2086
timeout 2400 "${SIM_PY}" "${ASSETS_DIR}/r2s_grasp_ur5e.py" --seg "${W}/out/segment" --menagerie "${MENAGERIE}" \
    --out "${W}/out/grasp" ${GT_ARGS} --video --max-videos {{ max_video_targets }} 2>&1 | tee /tmp/{{ vla }}_grasp_ur5e.log \
    || log "[warn] UR5e replay failed (the floating-hand result stands)"
stage "grasp_ur5e_ok $(jq -c '.summary' "${W}/out/grasp/grasp_ur5e.json" 2>/dev/null || echo none)"
{% endif %}
cp "${W}"/out/grasp/*.mp4 "${W}/videos/" 2>/dev/null || true

# ── [8/8] Report + S3 upload ───────────────────────────────────────
log "[8/8] Report + S3 upload..."
"${SIM_PY}" "${ASSETS_DIR}/r2s_report.py" --work "${W}/out" --videos "${W}/videos" --label "${INPUT_LABEL}" \
    --meta "instance=${INSTANCE_TYPE}" "menagerie={{ menagerie_commit[:8] }}" "nerfstudio={{ nerfstudio_version }}" \
    2>&1 | tee "${W}/out/report.txt" || die "report failed"
SR=$(grep -E '^success_rate:' "${W}/out/summary.txt" | awk '{print $2}' || echo unknown)

# Results layout = the other targets: <run>/task-0/{summary.txt, videos/*.mp4 + *.txt}; the full stage outputs
# (results.json, segment/ with obj_XX.obj + scene_collision.usda + segment.json, grasp/*.json, the splat ply,
# metrics, logs) go to <run>/real2sim/.
S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-0"
UPLOAD_COUNT=0
VIDEO_COUNT=$(find "${W}/videos" -name "*.mp4" 2>/dev/null | wc -l)
while IFS= read -r mp4_file || [[ -n "$mp4_file" ]]; do
    [ -f "$mp4_file" ] || continue
    fname=$(basename "$mp4_file")
    base="${fname%.mp4}"
    txt_file="${W}/videos/${base}.txt"
    {
        if [ -f "$txt_file" ]; then cat "$txt_file"; fi
        echo ""
        echo "--- Run ---"
        printf "Input:    %s\n" "${INPUT_LABEL}"
        printf "run_id:   %s\n" "${RUN_ID}"
        printf "Instance: %s (%s)\n" "${INSTANCE_ID}" "${INSTANCE_TYPE}"
        printf "Region:   %s\n" "${REGION}"
        printf "Stack:    %s (CDK)\n" "${STACK_NAME}"
        printf "License:  %s\n" "{{ license }}"
    } > "${txt_file}.full"
    if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" --region "$REGION" 2>&1 | tee -a /var/log/{{ vla }}-userdata.log; then
        UPLOAD_COUNT=$((UPLOAD_COUNT + 1))
        aws s3 cp "${txt_file}.full" "${S3_TASK_PREFIX}/videos/${base}.txt" --region "$REGION" 2>/dev/null || true
    else
        log "  [warn] Upload failed: $fname"
    fi
done < <(find "${W}/videos" -name "*.mp4" 2>/dev/null | sort)
log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"
aws s3 cp "${W}/out/summary.txt" "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true
{% from "_protocol-card.sh.j2" import protocol_card with context %}{{ protocol_card('"${W}/out/summary.txt"', '"${S3_TASK_PREFIX}"') }}
cp /var/log/{{ vla }}-userdata.log "${W}/out/userdata.log" 2>/dev/null || true
for _f in /tmp/{{ vla }}_*.log; do
    if [ -f "$_f" ]; then cp "$_f" "${W}/out/logs-$(basename "$_f")"; fi
done
aws s3 cp "${W}/out/" "s3://${S3_BUCKET}/${RUN_ID}/real2sim/" --recursive --region "$REGION" \
    --exclude "*.mp4" 2>&1 | tail -3 | tee -a /var/log/{{ vla }}-userdata.log || log "[warn] artefact upload incomplete"
stage "done"

SUMMARY_ALL="$(cat "${W}/out/summary.txt")"

# ── SNS notification + cfn-signal ──────────────────────────────────
log "[8/8] Sending SNS notification..."

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} run complete (RUN_ID: ${RUN_ID})
grasp success in the reconstructed collision world: ${SR}

${SUMMARY_ALL}

Pipeline: {{ policy_desc }}
Input: ${INPUT_LABEL}{% if input_source == 'hope' %} (HOPE-Video, CC BY-NC-SA 4.0: research / non-commercial){% endif %}
3DGS: nerfstudio {{ nerfstudio_version }} splatfacto ({{ max_iterations }} iterations), gsplat {{ gsplat_version }}
Simulation: MuJoCo, Menagerie UR5e + Robotiq 2F-85 @ {{ menagerie_commit[:8] }}
Instance: ${INSTANCE_TYPE}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} run complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[8/8] Sending cfn-signal..."
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

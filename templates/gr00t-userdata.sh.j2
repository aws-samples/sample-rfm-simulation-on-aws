{% if sim_id == 'simpler' %}VENV="${ISAAC_GROOT_DIR}/gr00t/eval/sim/SimplerEnv/simpler_uv/.venv"   # SimplerEnv rollout venv
{% else %}VENV="${ISAAC_GROOT_DIR}/gr00t/eval/sim/LIBERO/libero_uv/.venv"   # LIBERO rollout venv
{% endif %}SERVER_VENV="${ISAAC_GROOT_DIR}/.venv"                              # GR00T server venv (set to .venv after uv sync)
VIDEO_BASE_DIR=/tmp/gr00t-videos
RUN_ID=$(date '+%Y-%m-%d-%H%M')

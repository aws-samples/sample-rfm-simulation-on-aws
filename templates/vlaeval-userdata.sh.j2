#!/bin/bash
# {{ display_name }} 1-Click UserData Script
# Harness:    vla-eval=={{ harness_version }} (PyPI) + configs/ from {{ harness_repo }} @ {{ harness_tag }} ({{ harness_commit[:8] }}), unmodified
# Benchmarks: {% for b in benches %}{{ b.image }}{{ ', ' if not loop.last else '' }}{% endfor %}
# Servers:    {% for s in servers %}{{ s.config }}{% if s.hf_repo %} ({{ s.hf_repo }}@{{ s.hf_model_revision[:8] }}){% endif %}{{ ', ' if not loop.last else '' }}{% endfor %}
# License:    {{ license }}
# Pattern:    the harness's own split on ONE instance: `vla-eval serve` (model server, uv-managed env, GPU) on
#             localhost:{{ port }} + `vla-eval run` (benchmark container from the image above) per tasks: entry.
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}{{ (' --task-set ' ~ task_set) if task_set else '' }}
#
# Bootstrap-exported env vars (set by cdk/lib/vla-simulator-stack.ts via Fn::Sub):
#   ${S3BucketName} ${SnsTopicArn} ${StackName} ${WaitConditionUrl} ${Region} ${AutoTerminate}

set -euo pipefail

WORK=/opt/{{ vla }}
VENV="${WORK}/venv"
HARNESS_DIR="${WORK}/vla-evaluation-harness"
EVAL_BASE_DIR={{ eval_dir }}
VIDEO_BASE_DIR=/tmp/{{ vla }}-videos
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

# UserData runs as root; uv (and `vla-eval serve`, which calls uv) need a stable HOME and PATH.
export HOME=/root
export PATH="/root/.local/bin:${PATH}"
export HF_HOME="${HF_CACHE_DIR}"
export DEBIAN_FRONTEND=noninteractive
LOG=/var/log/{{ vla }}-userdata.log

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a "$LOG"; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status -> WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a "$LOG" \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

SERVER_PID=""
stop_server() {
    if [ -n "${SERVER_PID}" ]; then
        kill -TERM -- "-${SERVER_PID}" 2>/dev/null || kill -TERM "${SERVER_PID}" 2>/dev/null || true
        sleep 5
        kill -KILL -- "-${SERVER_PID}" 2>/dev/null || true
        SERVER_PID=""
    fi
}

die() {
    log "ERROR: $*"
    stop_server
    # Best-effort: dump diagnostics to S3 before CFN rollback eats the instance
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ]; then
        local _diag_prefix="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag-fail"
        aws s3 cp "$LOG" "${_diag_prefix}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ vla }}_*.log; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag_prefix}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
    fi
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        stop_server
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/8] System packages + Docker / NVIDIA runtime of the DLAMI ───────────────────────────────
log "[1/8] System packages..."
systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
# apt-daily-upgrade's systemctl daemon-reload revokes GPU access from running containers on this
# cgroup-v2 host; stop and mask the timers before any GPU container starts.
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl disable apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.service apt-daily-upgrade.service unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a > /tmp/{{ vla }}_dpkg_fix.log 2>&1 || true
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
APT_RETRY=0
until timeout 2400 apt-get update -qq -o DPkg::Lock::Timeout=1800 > /tmp/{{ vla }}_apt_update.log 2>&1; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    sleep 30
done
APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=1800 \
    git curl ca-certificates awscli jq python3 > /tmp/{{ vla }}_apt.log 2>&1; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    sleep 30
done
command -v docker >/dev/null 2>&1 || die "docker not found (the Deep Learning AMI ships Docker + the NVIDIA Container Toolkit)"

log "[1.5/8] CloudWatch Logs agent..."
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s > /tmp/{{ vla }}_cwagent.log 2>&1 \
        && log "  CW agent started (log group /{{ vla }}/userdata)" || log "[warn] CW agent start failed"
fi

# Docker: cgroupfs driver so a stray daemon-reload cannot revoke GPU device access mid-run (same fix as
# robolab / cosmos-policy), and the NVIDIA runtime registered (`vla-eval run` starts the benchmark with --gpus).
nvidia-ctk runtime configure --runtime=docker > /dev/null 2>&1 || true
python3 - <<'PYEOF' || die "could not set the Docker cgroup driver"
import json, os
p = "/etc/docker/daemon.json"
cfg = json.load(open(p)) if os.path.exists(p) and os.path.getsize(p) else {}
opts = [o for o in cfg.get("exec-opts", []) if not o.startswith("native.cgroupdriver=")]
cfg["exec-opts"] = opts + ["native.cgroupdriver=cgroupfs"]
json.dump(cfg, open(p, "w"), indent=2)
PYEOF
systemctl restart docker 2>/dev/null || true
docker info > /tmp/{{ vla }}_docker_info.log 2>&1 || die "docker daemon not reachable (see /tmp/{{ vla }}_docker_info.log)"

# ── [2/8] GPU, VRAM and host RAM floors ────────────────────────────────────────────────────────
log "[2/8] GPU check..."
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv 2>&1 | tee -a "$LOG" || true
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || echo 0)
DRIVER_VERSION=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ' || echo unknown)
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
log "  GPU0 ${GPU_MEM_MIB} MiB, driver ${DRIVER_VERSION}, host RAM ${HOST_MEM_MIB} MiB"
[ "${GPU_MEM_MIB:-0}" -ge {{ min_gpu_mib }} ] || die "needs a GPU >= {{ min_gpu_mib }} MiB; GPU0 has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml"
[ "${HOST_MEM_MIB:-0}" -ge {{ min_host_mib }} ] || die "needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml"

# ── [3/8] Hugging Face token (gated repos are checked BEFORE anything is installed) ──────────────
log "[3/8] HF token..."
HF_TOKEN=$(aws ssm get-parameter --name /vla-simulator/hf-token --with-decryption \
    --query 'Parameter.Value' --output text --region "$REGION" 2>/dev/null || echo "")
if [ -z "$HF_TOKEN" ] || [ "$HF_TOKEN" = "None" ]; then HF_TOKEN=""; fi
{%- if gated_repos %}
[ -n "$HF_TOKEN" ] || die "SSM /vla-simulator/hf-token is empty or missing in ${REGION}: the model server loads gated {{ gated_repos|join(', ') }}. Accept the license on huggingface.co with the token's account, then: aws ssm put-parameter --region ${REGION} --name /vla-simulator/hf-token --type SecureString --value <HF_TOKEN>"
{%- for g in gated_repos %}
_code=$(curl -s -o /dev/null -w '%{http_code}' -I -L -H "Authorization: Bearer ${HF_TOKEN}" \
    "https://huggingface.co/{{ g }}/resolve/main/config.json" || echo 000)
case "${_code}" in
    200|302|304) log "  gated {{ g }}: token has access (HTTP ${_code})" ;;
    401|403) die "the HF token in SSM /vla-simulator/hf-token has no access to gated {{ g }} (HTTP ${_code}): accept its license on huggingface.co with that account" ;;
    *) log "[warn] gated {{ g }}: access check returned HTTP ${_code} (continuing; the server load will tell)" ;;
esac
{%- endfor %}
{%- endif %}
export HF_TOKEN

# ── [4/8] uv, Python {{ python_version }} venv, vla-eval=={{ harness_version }}, harness configs @ {{ harness_tag }} ──
log "[4/8] uv + vla-eval=={{ harness_version }}..."
mkdir -p "${WORK}" "${EVAL_BASE_DIR}" "${VIDEO_BASE_DIR}" "${HF_CACHE_DIR}"
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh > /tmp/{{ vla }}_uv_install.log 2>&1 || die "uv install failed"
fi
log "  $(uv --version)"
# The DLAMI ships Python 3.10; vla-eval needs >= 3.11 (and SQLite JSON) -> a uv-managed interpreter.
[ -x "${VENV}/bin/python" ] || uv venv -q --python {{ python_version }} "${VENV}" > /tmp/{{ vla }}_venv.log 2>&1 \
    || die "uv venv --python {{ python_version }} failed (see /tmp/{{ vla }}_venv.log)"
# Install from ${WORK}, OUTSIDE the harness checkout: its pyproject pins uv exclude-newer to a date before the
# {{ harness_version }} upload, so `uv pip install` inside the checkout reports "no version {{ harness_version }}".
( cd "${WORK}" && uv pip install -q --python "${VENV}/bin/python" "vla-eval=={{ harness_version }}" ) \
    > /tmp/{{ vla }}_pip.log 2>&1 || die "uv pip install vla-eval=={{ harness_version }} failed (see /tmp/{{ vla }}_pip.log)"
VLAEVAL_VERSION=$("${VENV}/bin/python" -c 'import importlib.metadata as m; print(m.version("vla-eval"))' 2>/dev/null || echo unknown)
[ "${VLAEVAL_VERSION}" = "{{ harness_version }}" ] || die "vla-eval ${VLAEVAL_VERSION} installed, {{ harness_version }} pinned"
# configs/ (benchmark and model-server YAML, the server scripts' paths) are not in the wheel: clone the tag.
if [ ! -d "${HARNESS_DIR}/.git" ]; then
    git clone -q --branch {{ harness_tag }} {{ harness_repo }} "${HARNESS_DIR}" > /tmp/{{ vla }}_clone.log 2>&1 \
        || die "clone {{ harness_repo }} @ {{ harness_tag }} failed"
fi
HARNESS_COMMIT=$(git -C "${HARNESS_DIR}" rev-parse HEAD)
[ "${HARNESS_COMMIT}" = "{{ harness_commit }}" ] || die "harness tag {{ harness_tag }} is ${HARNESS_COMMIT}, pinned {{ harness_commit }}"
log "  vla-eval ${VLAEVAL_VERSION}, harness ${HARNESS_COMMIT:0:8}, $("${VENV}/bin/python" --version)"
{%- for s in servers %}
[ -f "${HARNESS_DIR}/{{ s.config }}" ] || die "model-server config {{ s.config }} not in the harness checkout"
{%- endfor %}
# torch >= 2.11 wheels on PyPI are built for CUDA 13 (driver >= 580); the DLAMI ships 570 (CUDA 12.8). A server
# script that leaves torch open (xvla.py: torch>=2.2) then resolves 2.15 and dies at model load with "NVIDIA driver
# on your system is too old" (measured 2026-11-09, X-VLA x CALVIN). On such drivers, lock each script this run
# uses and add a torch<2.11 constraint only where the lock pulls CUDA 13 wheels: lerobot.py already resolves
# 2.11.0+cu128 and stays as published (a blanket constraint moved it to 2.10, measured). Goes into every summary.
TORCH_CONSTRAINT="none"
DRIVER_MAJOR="${DRIVER_VERSION%%.*}"
if [[ "${DRIVER_MAJOR}" =~ ^[0-9]+$ ]] && [ "${DRIVER_MAJOR}" -lt 580 ]; then
    _patched=""
    # checked assignment: a resolver error inside `for ... in $(...)` would be swallowed and skip every lock
    SERVER_SCRIPTS=$("${VENV}/bin/python" - "${HARNESS_DIR}" {% for s in servers %}"{{ s.config }}" {% endfor %}<<'PYEOF'
import pathlib, sys, yaml
root, found = pathlib.Path(sys.argv[1]), set()
for cfg in sys.argv[2:]:
    p = root / cfg
    while p is not None:
        d = yaml.safe_load(p.read_text()) or {}
        if "script" in d:
            found.add(d["script"])
            break
        p = p.parent / d["extends"] if "extends" in d else None
print("\n".join(sorted(found)))
PYEOF
    ) || die "could not resolve the model-server scripts of {% for s in servers %}{{ s.config }} {% endfor %}"
    for _rel in ${SERVER_SCRIPTS}; do
        _f="${HARNESS_DIR}/${_rel}"
        [ -f "${_f}" ] || die "model-server script ${_rel} not in the harness checkout"
        grep -q '^# \[tool\.uv\]$' "${_f}" || continue
        if grep -qxF '# constraint-dependencies = ["torch<2.11"]' "${_f}"; then
            _patched="${_patched:+${_patched},}$(basename "${_f}")"   # patched by an earlier run of this script
            continue
        fi
        grep -q 'constraint-dependencies' "${_f}" && continue
        rm -f "${_f}.lock"
        ( cd "${HARNESS_DIR}" && uv lock -q --script "${_f}" ) > "/tmp/{{ vla }}_lock_$(basename "${_f}" .py).log" 2>&1 \
            || die "uv lock --script ${_rel} failed (see /tmp/{{ vla }}_lock_$(basename "${_f}" .py).log)"
        if grep -qE '^name = "nvidia-[a-z-]+-cu13"$|nvidia_cuda_runtime-13\.' "${_f}.lock"; then
            sed -i 's|^# \[tool\.uv\]$|# [tool.uv]\n# constraint-dependencies = ["torch<2.11"]|' "${_f}"
            _patched="${_patched:+${_patched},}$(basename "${_f}")"
        fi
        rm -f "${_f}.lock"     # `uv run` resolves from the header as before
    done
    [ -z "${_patched}" ] || TORCH_CONSTRAINT="torch<2.11 (${_patched})"
    log "  driver ${DRIVER_VERSION} (< 580, CUDA 12): torch constraint ${TORCH_CONSTRAINT}"
fi

# Results adapter (assets/vlaeval/vlaeval_results.py, stdlib only): aggregate JSON -> summary.txt + videos.
base64 -d > "${WORK}/vlaeval_results.py" <<'B64EOF'
{{ adapter_b64 }}B64EOF

# ── [5/8] Benchmark images, pulled by digest ───────────────────────────────────────────────────
{%- for b in benches %}
log "[5/8] docker pull {{ b.image }}..."
for _i in 1 2 3; do
    timeout 3600 docker pull -q "{{ b.image }}" > /tmp/{{ vla }}_pull_{{ b.name }}.log 2>&1 && break
    [ "${_i}" -eq 3 ] && die "docker pull {{ b.image }} failed (see /tmp/{{ vla }}_pull_{{ b.name }}.log)"
    log "[warn] docker pull attempt ${_i} failed, retrying in 60s"; sleep 60
done
docker image inspect "{{ b.image }}" > /dev/null 2>&1 || die "image {{ b.image }} not present after pull"
{%- endfor %}

# ── [6/8] Checkpoints at pinned revisions (the server gets the snapshot path, not a moving Hub ref) ──
export HF_XET_CLIENT_READ_TIMEOUT=60 HF_XET_CLIENT_CONNECT_TIMEOUT=30
{%- for s in servers if s.hf_repo %}
log "[6/8] {{ s.hf_repo }} @ {{ s.hf_model_revision[:8] }}..."
_ok=""
for _i in 1 2; do
    if timeout --kill-after=60 2700 uv run -q --no-project --python {{ python_version }} \
        --with "huggingface_hub=={{ hf_hub_version }}" python - > "/tmp/{{ vla }}_ckpt_{{ s.name }}.path" \
        2>> /tmp/{{ vla }}_hf_download.log <<'PYEOF'
from huggingface_hub import snapshot_download
{%- if s.checkpoint_pass == "repo_id" %}
import pathlib
_p = snapshot_download("{{ s.hf_repo }}", revision="{{ s.hf_model_revision }}")
# The server is started with HF_HUB_OFFLINE=1 and calls snapshot_download("{{ s.hf_repo }}") (revision main): offline,
# main resolves through refs/main of the cache, which a download by commit does not write. Point it at the pin.
pathlib.Path(_p).parent.parent.joinpath("refs").mkdir(exist_ok=True)
pathlib.Path(_p).parent.parent.joinpath("refs", "main").write_text("{{ s.hf_model_revision }}")
print(_p)
{%- else %}
print(snapshot_download("{{ s.hf_repo }}", revision="{{ s.hf_model_revision }}"{% if s.hf_allow_patterns %}, allow_patterns={{ s.hf_allow_patterns|tojson }}{% endif %}))
{%- endif %}
PYEOF
    then _ok=1; break; fi
    log "[warn] checkpoint download attempt ${_i} failed (resumes from the partial cache)"
done
[ -n "${_ok}" ] || die "checkpoint download {{ s.hf_repo }}@{{ s.hf_model_revision[:8] }} failed (see /tmp/{{ vla }}_hf_download.log)"
_path=$(tail -1 "/tmp/{{ vla }}_ckpt_{{ s.name }}.path")
[ -f "${_path}/{{ s.checkpoint_marker or 'config.json' }}" ] || die "{{ s.hf_repo }} snapshot ${_path} has no {{ s.checkpoint_marker or 'config.json' }}"
log "  snapshot: ${_path} ($(du -sh "${_path}/" 2>/dev/null | cut -f1))"
{%- for x in s.hf_offline_repos or [] %}
# loaded by id by the {{ s.name }} server (HF_HUB_OFFLINE=1): cached at its pin, refs/main pointed at it
log "  offline repo {{ x.repo }} @ {{ x.revision[:8] }}..."
_ok=""
for _i in 1 2; do
    if timeout --kill-after=60 1800 uv run -q --no-project --python {{ python_version }} \
        --with "huggingface_hub=={{ hf_hub_version }}" python - >> /tmp/{{ vla }}_hf_download.log 2>&1 <<'PYEOF'
import pathlib
from huggingface_hub import snapshot_download
_p = snapshot_download("{{ x.repo }}", revision="{{ x.revision }}"{% if x.allow_patterns %}, allow_patterns={{ x.allow_patterns|tojson }}{% endif %})
pathlib.Path(_p).parent.parent.joinpath("refs").mkdir(exist_ok=True)
pathlib.Path(_p).parent.parent.joinpath("refs", "main").write_text("{{ x.revision }}")
print(_p)
PYEOF
    then _ok=1; break; fi
    log "[warn] download attempt ${_i} of {{ x.repo }} failed"
done
[ -n "${_ok}" ] || die "download {{ x.repo }}@{{ x.revision[:8] }} failed (see /tmp/{{ vla }}_hf_download.log)"
{%- endfor %}
{%- endfor %}

# Model server: `vla-eval serve` from the harness checkout (its config paths are relative to it). The server's
# PEP 723 script resolves its own env with uv on first start (torch + LeRobot ~2 min). Started per server name,
# kept up while consecutive tasks use the same one.
CURRENT_SERVER=""
start_server() {
    local _name=$1 _config=$2 _ckpt_arg=$3 _ckpt=$4{% if offline_servers %} _pass=${5:-path}{% endif %}
    stop_server
    if [ -n "${CURRENT_SERVER}" ]; then
        # switching servers: the next health check must not be answered by the one just stopped
        local _w=0
        while curl -sf -o /dev/null "http://localhost:{{ port }}/health"; do
            _w=$((_w + 1))
            [ "${_w}" -lt 30 ] || die "model server ${CURRENT_SERVER} still answers on :{{ port }} 60 s after it was stopped"
            sleep 2
        done
        CURRENT_SERVER=""
    fi
    local _args=(serve --config "${_config}")
    [ -z "${_ckpt_arg}" ] || _args+=(--arg "${_ckpt_arg}=${_ckpt}")
    log "  vla-eval ${_args[*]}"
{%- if offline_servers %}
    # checkpoint_pass repo_id: the server gets the repo id and resolves it from the pinned cache only
    [ "${_pass}" != "repo_id" ] || log "  (HF_HUB_OFFLINE=1: ${_ckpt} and the server's other Hub repos from the cache)"
    ( cd "${HARNESS_DIR}" && if [ "${_pass}" = "repo_id" ]; then export HF_HUB_OFFLINE=1; fi \
        && exec setsid "${VENV}/bin/vla-eval" "${_args[@]}" ) \
{%- else %}
    ( cd "${HARNESS_DIR}" && exec setsid "${VENV}/bin/vla-eval" "${_args[@]}" ) \
{%- endif %}
        > "/tmp/{{ vla }}_server_${_name}.log" 2>&1 < /dev/null &
    SERVER_PID=$!
    local _t0=$SECONDS
    until curl -sf -o /dev/null "http://localhost:{{ port }}/health"; do
        # a server that cannot start fails its tasks only: the other servers' tasks still run
        if ! kill -0 "${SERVER_PID}" 2>/dev/null; then
            log "ERROR: model server ${_name} exited before it was healthy (see /tmp/{{ vla }}_server_${_name}.log)"
            return 1
        fi
        if [ $((SECONDS - _t0)) -ge 3600 ]; then
            log "ERROR: model server ${_name} not healthy after 60 min (see /tmp/{{ vla }}_server_${_name}.log)"
            stop_server
            return 1
        fi
        sleep 5
    done
    log "  server ${_name} healthy after $((SECONDS - _t0)) s"
    CURRENT_SERVER="${_name}"
}

# ── [7/8] One `vla-eval run` per tasks: entry (one benchmark suite x one model server) ───────────
TASKS_JSON='{{ tasks_json }}'
TASK_COUNT=$(echo "$TASKS_JSON" | jq length)
SUMMARY_ALL=""
FAILED=""

for TASK_IDX in $(seq 0 $((TASK_COUNT - 1))); do
    TASK=$(echo "$TASKS_JSON" | jq -c ".[$TASK_IDX]")
    SUITE=$(echo "$TASK" | jq -r '.suite')
    SERVER_NAME=$(echo "$TASK" | jq -r '.model_server')
    SERVER_CONFIG=$(echo "$TASK" | jq -r '.server_config')
    CKPT_ARG=$(echo "$TASK" | jq -r '.checkpoint_arg')
    HF_REPO=$(echo "$TASK" | jq -r '.hf_repo')
    HF_REV=$(echo "$TASK" | jq -r '.hf_model_revision')
    IMAGE=$(echo "$TASK" | jq -r '.image')
    EPISODES=$(echo "$TASK" | jq -r '.episodes_per_task')
    SEED=$(echo "$TASK" | jq -r '.seed')
    COND=$(echo "$TASK" | jq -r '.condition')
    ACTION_TYPE=$(echo "$TASK" | jq -r '.action_type')
    DESCRIPTION=$(echo "$TASK" | jq -r '.description')
    PUBLISHED=$(echo "$TASK" | jq -r '.published')
    EXPECT_VIDEOS=$(echo "$TASK" | jq -r 'if .expect_videos == false then "false" else "true" end')
    INIT_STATES=$(echo "$TASK" | jq -r '.init_states // ""')
    OUT_DIR="${EVAL_BASE_DIR}/task-${TASK_IDX}"
    VIDEO_DIR="${VIDEO_BASE_DIR}/task-${TASK_IDX}"
    S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}"
    rm -rf "${OUT_DIR}" "${VIDEO_DIR}"
    mkdir -p "${OUT_DIR}" "${VIDEO_DIR}"
    log "[7/8] Task $((TASK_IDX+1))/${TASK_COUNT}: ${SUITE} x ${SERVER_NAME} (${EPISODES} ep/task, seed ${SEED})"

    CKPT_PATH=""
    if [ -n "${HF_REPO}" ]; then
        CKPT_PATH=$(tail -1 "/tmp/{{ vla }}_ckpt_${SERVER_NAME}.path")
    fi
{%- if offline_servers %}
    CKPT_PASS=$(echo "$TASK" | jq -r '.checkpoint_pass // "path"')
    [ "${CKPT_PASS}" != "repo_id" ] || CKPT_PATH="${HF_REPO}"    # the server downloads by id: give it the id
{%- endif %}
    if [ "${CURRENT_SERVER}" != "${SERVER_NAME}" ]; then
        if ! start_server "${SERVER_NAME}" "${SERVER_CONFIG}" "${CKPT_ARG}" "${CKPT_PATH}"{% if offline_servers %} "${CKPT_PASS}"{% endif %}; then
            FAILED="${FAILED} task-${TASK_IDX}"
            SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${SUITE} x ${SERVER_NAME} — model server did not start (${S3_TASK_PREFIX}/server.log)"
            aws s3 cp "/tmp/{{ vla }}_server_${SERVER_NAME}.log" "${S3_TASK_PREFIX}/server.log" --quiet || true
            continue
        fi
    fi

    EVAL_CONFIG="${WORK}/eval-task-${TASK_IDX}.json"   # JSON is YAML: the harness's loader reads it as is
    echo "$TASK" | jq '.eval_config' > "${EVAL_CONFIG}"

    set +e
    trap - ERR
    T_EVAL0=$SECONDS
    ( cd "${HARNESS_DIR}" && timeout --kill-after=120 5400 "${VENV}/bin/vla-eval" run --config "${EVAL_CONFIG}" --yes ) \
        < /dev/null > "/tmp/{{ vla }}_task${TASK_IDX}.log" 2>&1
    EVAL_EXIT=$?
    EVAL_SEC=$((SECONDS - T_EVAL0))
    set -e
    trap '_trap_handler' ERR
    log "  vla-eval run exit=${EVAL_EXIT} after ${EVAL_SEC} s"

    SUMMARY_FILE="/tmp/{{ vla }}_task${TASK_IDX}_summary.txt"
    rm -f "${SUMMARY_FILE}"
    # chunk executed open loop = the server config's chunk_size (protocol card chunk_rule)
    CHUNK=$(sed -nE 's/^[[:space:]]*chunk_size:[[:space:]]*([0-9]+).*/\1/p' "${HARNESS_DIR}/${SERVER_CONFIG}" | head -1 || true)
    KN=$(python3 "${WORK}/vlaeval_results.py" --output-dir "${OUT_DIR}" --summary "${SUMMARY_FILE}" \
        --video-dir "${VIDEO_DIR}" --suite "${SUITE}" --init-states "${INIT_STATES}" \
        --caption "{{ display_name }}: ${SUITE} x ${SERVER_NAME} (run ${RUN_ID}, task-${TASK_IDX})" \
        --meta "model=${SERVER_NAME}" \
        --meta "checkpoint=${HF_REPO:-from server config}@${HF_REV:0:8}" \
        --meta "condition=${COND}" \
        --meta "action_type=${ACTION_TYPE}" \
        --meta "published=${PUBLISHED}" \
        --meta "description=${DESCRIPTION}" \
        --meta "n_action_steps=${CHUNK:-server default}" \
        --meta "instruction=benchmark default task language" \
        --meta "num_envs=1" \
        --meta "eval_exit=${EVAL_EXIT}" \
        --meta "eval_seconds=${EVAL_SEC}" \
        --meta "stack_vla_eval_version=${VLAEVAL_VERSION}" \
        --meta "stack_vla_eval_commit=${HARNESS_COMMIT}" \
        --meta "stack_vla_eval_server_config=${SERVER_CONFIG}" \
        --meta "stack_vla_eval_benchmark_image=${IMAGE}" \
        --meta "stack_nvidia_driver=${DRIVER_VERSION}" \
        --meta "stack_torch_constraint=${TORCH_CONSTRAINT}" \
        2>> "/tmp/{{ vla }}_task${TASK_IDX}.log" | tail -1) || KN=""
    log "  result: ${KN:-no aggregate}"

    log "  S3 upload: ${S3_TASK_PREFIX}"
    # Harness output as written (aggregate JSON, recording SQLite, per-step jsonl); its mp4s go up once, renamed
    # under videos/ (every .mp4 in the bucket feeds the gallery).
    aws s3 cp --recursive "${OUT_DIR}" "${S3_TASK_PREFIX}/vla-eval/" --exclude "*.mp4" --region "$REGION" \
        > /dev/null 2>&1 || log "[warn] harness output upload failed"
    UPLOAD_COUNT=0
    VIDEO_COUNT=$(find "${VIDEO_DIR}" -name '*.mp4' | wc -l)
    while IFS= read -r mp4_file; do
        fname=$(basename "$mp4_file")
        if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" --region "$REGION" >> "$LOG" 2>&1; then
            UPLOAD_COUNT=$((UPLOAD_COUNT + 1))
            aws s3 cp "${mp4_file%.mp4}.txt" "${S3_TASK_PREFIX}/videos/${fname%.mp4}.txt" --region "$REGION" > /dev/null 2>&1 || true
        fi
    done < <(find "${VIDEO_DIR}" -name '*.mp4' | sort)
    log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"
    [ "${EXPECT_VIDEOS}" = "true" ] || log "  (no episode videos expected: this benchmark's observations have no frame)"
    aws s3 cp "${EVAL_CONFIG}" "${S3_TASK_PREFIX}/eval-config.json" --region "$REGION" > /dev/null 2>&1 || true
    aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}.log" "${S3_TASK_PREFIX}/eval.log" --region "$REGION" > /dev/null 2>&1 || true
    aws s3 cp "/tmp/{{ vla }}_server_${SERVER_NAME}.log" "${S3_TASK_PREFIX}/server.log" --region "$REGION" > /dev/null 2>&1 || true
    SUMMARY_UP=0
    if [ -f "${SUMMARY_FILE}" ]; then
        for _try in 1 2 3; do
            aws s3 cp "${SUMMARY_FILE}" "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" > /dev/null 2>&1 \
                && { SUMMARY_UP=1; break; }
            sleep 10
        done
    fi
    {% from "_protocol-card.sh.j2" import protocol_card with context %}{{ protocol_card('"${SUMMARY_FILE}"', '"${S3_TASK_PREFIX}"') }}

    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${SUITE} x ${SERVER_NAME} — ${KN:-no result} (${EPISODES} ep/task, ${EVAL_SEC} s)"
    if [ "${EVAL_EXIT}" -ne 0 ] || [ -z "${KN}" ]; then
        FAILED="${FAILED} task-${TASK_IDX}"
        log "  [error] task ${TASK_IDX}: vla-eval exit ${EVAL_EXIT}, result '${KN}' (see ${S3_TASK_PREFIX}/eval.log)"
    elif [ "${VIDEO_COUNT}" -eq 0 ] && [ "${EXPECT_VIDEOS}" = "true" ]; then
        FAILED="${FAILED} task-${TASK_IDX}"
        log "  [error] task ${TASK_IDX}: no episode videos (recording.record_video is on)"
    elif [ "${SUMMARY_UP}" -ne 1 ] || [ "${UPLOAD_COUNT}" -ne "${VIDEO_COUNT}" ]; then
        # the instance is terminated after the run: a result that is not in S3 is lost
        FAILED="${FAILED} task-${TASK_IDX}"
        log "  [error] task ${TASK_IDX}: upload incomplete (summary.txt ${SUMMARY_UP}/1, videos ${UPLOAD_COUNT}/${VIDEO_COUNT})"
    fi
done
stop_server
[ -z "${FAILED}" ] || die "failed:${FAILED} (summary.txt and logs are in s3://${S3_BUCKET}/${RUN_ID}/)"

# ── [8/8] SNS notification + cfn-signal ────────────────────────────────────────────────────────
log "[8/8] Sending SNS notification..."

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} evaluation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}

Harness: vla-eval {{ harness_version }} ({{ harness_repo }} @ {{ harness_commit[:8] }}), unmodified
Benchmarks: {% for b in benches %}{{ b.image }}{{ ', ' if not loop.last else '' }}{% endfor %}
Model servers: {% for s in servers %}{{ s.config }}{% if s.hf_repo %} ({{ s.hf_repo }}@{{ s.hf_model_revision[:8] }}){% endif %}{{ ', ' if not loop.last else '' }}{% endfor %}
License: {{ license }}
Instance: ${INSTANCE_TYPE}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} evaluation complete - ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[8/8] Sending cfn-signal..."
aws s3 cp "$LOG" "s3://${S3_BUCKET}/${RUN_ID}/userdata.log" --region "$REGION" > /dev/null 2>&1 || true
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

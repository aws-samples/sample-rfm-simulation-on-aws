{% if needs_vulkan %}# ── [2.5/6] FIX 8: Vulkan loader + NVIDIA ICD ({{ sim_id }} renders via SAPIEN) ──
# The DLAMI ships the NVIDIA driver (libGLX_nvidia.so.0) but NOT the Vulkan loader,
# so SAPIEN's `import sapien.core` dies with `ImportError: libvulkan.so.1`. LIBERO/MuJoCo
# sims skip this block (needs_vulkan empty). Same block as templates/rldx-userdata.sh.j2 FIX 8. Source of truth (verified, not guessed):
# simpler-env/ManiSkill2_real2sim/docker/{Dockerfile,nvidia_icd.json,nvidia_layers.json}.
log "[2.5/6] FIX 8: installing Vulkan loader + NVIDIA ICD ({{ sim_id }} needs SAPIEN/Vulkan)..."
APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    libvulkan1 vulkan-tools \
    2>&1 | tee /tmp/gr00t_fix8_vulkan.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "FIX 8: libvulkan1 install failed after 3 retries"
    log "[warn] FIX 8 apt install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done
# ICD: tell the loader where the NVIDIA driver's Vulkan entry point is (api_version per
# the verified ManiSkill2_real2sim docker asset; libGLX_nvidia.so.0 = DLAMI-preinstalled).
mkdir -p /usr/share/vulkan/icd.d /etc/vulkan/implicit_layer.d
cat > /usr/share/vulkan/icd.d/nvidia_icd.json << 'VKICDEOF'
{
    "file_format_version" : "1.0.0",
    "ICD": {
        "library_path": "libGLX_nvidia.so.0",
        "api_version" : "1.2.155"
    }
}
VKICDEOF
cat > /etc/vulkan/implicit_layer.d/nvidia_layers.json << 'VKLAYEREOF'
{
    "file_format_version" : "1.0.0",
    "layer": {
        "name": "VK_LAYER_NV_optimus",
        "type": "INSTANCE",
        "library_path": "libGLX_nvidia.so.0",
        "api_version" : "1.2.155",
        "implementation_version" : "1",
        "description" : "NVIDIA Optimus layer",
        "functions": {
            "vkGetInstanceProcAddr": "vk_optimusGetInstanceProcAddr",
            "vkGetDeviceProcAddr": "vk_optimusGetDeviceProcAddr"
        },
        "enable_environment": {
            "__NV_PRIME_RENDER_OFFLOAD": "1"
        },
        "disable_environment": {
            "DISABLE_LAYER_NV_OPTIMUS_1": ""
        }
    }
}
VKLAYEREOF
# Sanity-probe the Vulkan device (non-fatal: SAPIEN can still fall back to EGL/CPU; the
# real gate is setup_SimplerEnv.sh's own gym.make sanity check in [3/6]).
vulkaninfo --summary 2>&1 | grep -iE "deviceName|driverName|apiVersion" | head -5 \
    | tee -a /tmp/gr00t_fix8_vulkan.log \
    || log "[warn] vulkaninfo probe inconclusive — relying on the [3/6] setup sanity check"
log "  FIX 8 applied — Vulkan loader + NVIDIA ICD installed"
{% endif %}
# ── [3/6] uv install + Isaac-GR00T setup ──────────────────────────

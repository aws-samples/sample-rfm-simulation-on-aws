#!/bin/bash
# {{ display_name }} 1-Click UserData Script (RoboTwin 2.0 bimanual benchmark, local in-process lerobot-eval)
# Shared template for upstream-LeRobot policies evaluated with `lerobot-eval --env.type=robotwin`.
# Model:      {{ hf_repo }} (rev {{ hf_model_revision[:8] }}) — {{ license }}
# LeRobot:    {{ lerobot_repo }} @ {{ lerobot_commit[:8] }} (uv sync --locked{% for e in uv_extras %} --extra {{ e }}{% endfor %})
# RoboTwin:   {{ robotwin_repo }} @ {{ robotwin_commit[:8] }} (MIT) + assets {{ assets_repo }} @ {{ assets_revision[:8] }}
# CuRobo:     {{ curobo_repo }} @ {{ curobo_ref }} (NVIDIA License, non-commercial: research / evaluation only)
# Simulator:  SAPIEN {{ sapien_version }} (Vulkan render) + mplib {{ mplib_version }} + CuRobo motion planner
# Plan:       {{ protocol }}{% if shard %} shard {{ shard }}{% endif %} — {{ n_units }} lerobot-eval call(s), {{ n_episodes }} episode(s)
# Pattern:    SINGLE process — lerobot-eval loads the policy in-process on the sim GPU.
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}{% if protocol != 'subset' %} --robotwin-protocol {{ protocol }}{% endif %}{% if shard %} --robotwin-shard {{ shard }}{% endif %}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName}       — results S3 bucket
#   ${SnsTopicArn}        — completion notification SNS topic
#   ${StackName}          — CDK stack name
#   ${WaitConditionUrl}   — CFN WaitConditionHandle presigned URL
#   ${Region}             — deployment region
#   ${AutoTerminate}      — "true" to auto-terminate EC2 after completion

set -euo pipefail

LEROBOT_DIR=/home/ubuntu/lerobot
ROBOTWIN_DIR=/home/ubuntu/robotwin
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
EVAL_BASE_DIR=/tmp/{{ vla }}-eval
VIDEO_BASE_DIR=/tmp/{{ vla }}-videos
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

# UserData runs as root; HOME must be set so uv puts caches in a stable place.
export HOME=/root
export HF_HOME="${HF_CACHE_DIR}"
# uv installs into ~/.local/bin
export PATH="/root/.local/bin:${PATH}"

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a /var/log/{{ vla }}-userdata.log; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/{{ vla }}-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

die() {
    log "ERROR: $*"
    # Best-effort: dump diagnostics to S3 before CFN rollback eats the instance
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ]; then
        local _diag_prefix="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag-fail"
        log "  Uploading /tmp/{{ vla }}_*.log to ${_diag_prefix}..."
        aws s3 cp /var/log/{{ vla }}-userdata.log "${_diag_prefix}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ vla }}_*.log; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag_prefix}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
    fi
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/8] System dependencies (+ Vulkan loader for SAPIEN) ─────────
log "[1/8] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive

systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
pkill -9 -f "apt-get" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a 2>&1 | tee /tmp/{{ vla }}_dpkg_fix.log || true

# Boot hardening (2026-10): the command-not-found apt hook hung apt-get update for 3 h on a g6e, and the
# apt-daily timers re-launch unattended-upgrades mid-boot (held the dpkg lock past 5 min). Drop / mask both.
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 2>&1 | tee /tmp/{{ vla }}_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    log "[warn] apt-get update failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# libvulkan1 + vulkan-tools: SAPIEN renders every camera through Vulkan and the DLAMI ships the NVIDIA
# driver but not the Vulkan loader (`import sapien` -> ImportError: libvulkan.so.1). unzip: RoboTwin assets.
APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    git git-lfs curl ca-certificates awscli jq unzip \
    libgl1-mesa-glx libegl1 libgles2 \
    libglib2.0-0 libsm6 libxext6 libxrender1 \
    libvulkan1 vulkan-tools \
    ffmpeg build-essential \
    2>&1 | tee /tmp/{{ vla }}_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    log "[warn] apt-get install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done
# NVIDIA Vulkan ICD → the DLAMI driver's libGLX_nvidia.so.0. Same JSON as LeRobot's RoboTwin benchmark
# image (docker/Dockerfile.benchmark.robotwin @{{ lerobot_commit[:8] }}).
mkdir -p /usr/share/vulkan/icd.d
if [ ! -f /usr/share/vulkan/icd.d/nvidia_icd.json ]; then
    echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.0"}}' \
        > /usr/share/vulkan/icd.d/nvidia_icd.json
fi
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
vulkaninfo --summary 2>&1 | grep -iE "deviceName|driverName|apiVersion" | head -5 | tee /tmp/{{ vla }}_vulkan.log \
    || log "[warn] vulkaninfo probe inconclusive — the [5/8] SAPIEN reset smoke test is the real gate"

# ── [1.5/8] CloudWatch Logs agent setup ──────────────────────────
log "[1.5/8] Setting up CloudWatch Logs agent..."
# Log group MUST match the stack's IAM grant (/${vla}/* → /{{ vla }}/*).
CW_LOG_GROUP="/{{ vla }}/userdata"
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s 2>&1 | tee /tmp/{{ vla }}_cwagent.log \
        && log "  CW agent started (log group: ${CW_LOG_GROUP})" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi

# ── [2/8] NVIDIA driver check + VRAM / host-RAM floor guard ───────────
log "[2/8] Checking GPU driver..."
nvidia-smi -L 2>&1 | tee /tmp/{{ vla }}_nvidia.log \
    || log "[warn] nvidia-smi failed — verify DLAMI"
# Fail-fast VRAM / host-RAM floors (models/{{ vla }}.yaml: min_gpu_mib / min_host_mib). Without them an
# undersized instance silently burns the full creationpolicy_timeout before the WaitCondition times out.
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || echo "0")
log "  GPU0 memory: ${GPU_MEM_MIB} MiB"
if [ "${GPU_MEM_MIB:-0}" -lt {{ min_gpu_mib }} ]; then
    die "{{ display_name }} needs a single GPU >= {{ min_gpu_mib }} MiB; GPU0 has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
log "  Host RAM: ${HOST_MEM_MIB} MiB"
if [ "${HOST_MEM_MIB:-0}" -lt {{ min_host_mib }} ]; then
    die "{{ display_name }} needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
# CuRobo compiles its CUDA kernels for this GPU only (TORCH_CUDA_ARCH_LIST), e.g. 8.9 on L4 / L40S.
GPU_CC=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ' || echo "")
log "  GPU0 compute capability: ${GPU_CC:-unknown}"
[[ "${GPU_CC}" =~ ^[0-9]+\.[0-9]+$ ]] || die "could not read the GPU compute capability (nvidia-smi --query-gpu=compute_cap)"

# ── [3/8] uv install + LeRobot clone (pinned) ──────────────────
log "[3/8] Installing uv (DLAMI does not pre-install)..."
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh 2>&1 | tee /tmp/{{ vla }}_uv_install.log \
        || die "uv install failed"
fi
log "  $(uv --version)"

log "[3/8] Cloning {{ lerobot_repo }} @ {{ lerobot_commit[:8] }}..."
if [ ! -d "${LEROBOT_DIR}" ]; then
    git clone {{ lerobot_repo }} "${LEROBOT_DIR}" \
        2>&1 | tee /tmp/{{ vla }}_clone.log \
        || die "lerobot clone failed"
    git -C "${LEROBOT_DIR}" checkout "{{ lerobot_commit }}" \
        || die "lerobot: checkout pinned commit {{ lerobot_commit[:8] }} failed"
fi
ACTUAL_COMMIT=$(git -C "${LEROBOT_DIR}" rev-parse HEAD)
log "  lerobot commit: ${ACTUAL_COMMIT}"
if [ "${ACTUAL_COMMIT}" != "{{ lerobot_commit }}" ]; then
    die "lerobot commit mismatch: expected {{ lerobot_commit }}, got ${ACTUAL_COMMIT}"
fi

log "[3/8] Cloning {{ robotwin_repo }} @ {{ robotwin_commit[:8] }}..."
if [ ! -d "${ROBOTWIN_DIR}" ]; then
    git clone {{ robotwin_repo }} "${ROBOTWIN_DIR}" \
        2>&1 | tee /tmp/{{ vla }}_robotwin_clone.log \
        || die "RoboTwin clone failed"
    git -C "${ROBOTWIN_DIR}" checkout "{{ robotwin_commit }}" \
        || die "RoboTwin: checkout pinned commit {{ robotwin_commit[:8] }} failed"
fi
ROBOTWIN_COMMIT=$(git -C "${ROBOTWIN_DIR}" rev-parse HEAD)
[ "${ROBOTWIN_COMMIT}" = "{{ robotwin_commit }}" ] \
    || die "RoboTwin commit mismatch: expected {{ robotwin_commit }}, got ${ROBOTWIN_COMMIT}"
# The LeRobot env wrapper reads task_config/{demo_clean,demo_randomized,_embodiment_config,_camera_config}.yml
# and imports envs.<task>; RoboTwin main after 2026-04 moved to env_cfg/ and breaks it, hence the pin.
for _f in task_config/demo_clean.yml task_config/demo_randomized.yml task_config/_eval_step_limit.yml \
          script/update_embodiment_config_path.py envs/robot/planner.py; do
    [ -f "${ROBOTWIN_DIR}/${_f}" ] || die "RoboTwin @{{ robotwin_commit[:8] }} has no ${_f}"
done

# ── [4/8] uv sync (pinned uv.lock) + RoboTwin simulator stack into the same venv ──
# --python {{ python_version }}: LeRobot requires >=3.12; without the pin uv may pick 3.14, whose argparse
# rejects draccus' `type=str | None` (lerobot-eval CLI parse crash). ~15-30min on a fresh instance.
log "[4/8] uv sync --locked --python {{ python_version }}{% for e in uv_extras %} --extra {{ e }}{% endfor %} (~15-30min)..."
cd "${LEROBOT_DIR}"
uv sync --locked --python {{ python_version }}{% for e in uv_extras %} --extra {{ e }}{% endfor %} 2>&1 | tee /tmp/{{ vla }}_uv_sync.log \
    || die "uv sync failed (see /tmp/{{ vla }}_uv_sync.log)"
VENV_PY="${LEROBOT_DIR}/.venv/bin/python"
PY_VER=$("${VENV_PY}" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)
log "  venv python: ${PY_VER}"
[ "${PY_VER}" = "{{ python_version }}" ] || die "venv python ${PY_VER} != pinned {{ python_version }} (uv ignored --python)"
# From here on NOTHING calls `uv run` (a synced run re-installs locked versions over the packages added
# below); every step calls the venv interpreter / console scripts directly.

# Freeze the locked set as constraints: the RoboTwin stack is added on top of it and may not move any
# locked package. mplib 0.2.1 declares numpy<2 and sapien 3.0.0b1 declares opencv-python, so both go in
# with --no-deps: installed with their metadata, mplib downgrades numpy 2.2.6 -> 1.26.4 and pyarrow then
# refuses to import (lerobot-eval dies at `import datasets`; observed in LeRobot's own RoboTwin CI job,
# 2026-10-30). Their binaries are built with a numpy-2-aware pybind11 (they probe numpy._core), and
# cv2 comes from LeRobot's opencv-python-headless.
uv pip freeze --python "${VENV_PY}" | grep -vE '^(-e |#)| @ ' > /tmp/{{ vla }}_constraints.txt \
    || die "uv pip freeze failed"
NUMPY_LOCKED=$("${VENV_PY}" -c 'import numpy; print(numpy.__version__)')
log "  locked numpy: ${NUMPY_LOCKED} ($(wc -l < /tmp/{{ vla }}_constraints.txt) constraints)"

log "[4/8] Installing the RoboTwin simulator stack (SAPIEN {{ sapien_version }}, mplib {{ mplib_version }}, ...)..."
uv pip install --python "${VENV_PY}" --no-deps \
    "sapien=={{ sapien_version }}" "mplib=={{ mplib_version }}" \
    2>&1 | tee /tmp/{{ vla }}_robotwin_pip.log || die "sapien / mplib install failed"
uv pip install --python "${VENV_PY}" --constraint /tmp/{{ vla }}_constraints.txt \
{%- for p in robotwin_pip %}
    "{{ p }}" \
{%- endfor %}
    2>&1 | tee -a /tmp/{{ vla }}_robotwin_pip.log || die "RoboTwin Python deps install failed (see /tmp/{{ vla }}_robotwin_pip.log)"
# Upstream patches (RoboTwin script/_install.sh, mirrored by LeRobot's benchmark image): mplib 0.2.1
# drops a broken `or collide` clause; sapien 3.0.0b1 URDF loader gets utf-8 + the ".srdf" extension.
"${VENV_PY}" - << 'PATCHEOF' 2>&1 | tee /tmp/{{ vla }}_robotwin_patch.log || die "mplib / sapien source patch failed"
import pathlib, re, site
done = set()
for d in site.getsitepackages():
    p = pathlib.Path(d) / "mplib" / "planner.py"
    if p.exists():
        src = p.read_text()
        new = re.sub(r"\bor collide\b ", "", src, count=1)
        assert new != src or "or collide" not in src, "mplib patch did not apply"
        p.write_text(new)
        done.add("mplib")
    p = pathlib.Path(d) / "sapien" / "wrapper" / "urdf_loader.py"
    if p.exists():
        src = p.read_text()
        p.write_text(src.replace("with open(srdf_path) as f:", 'with open(srdf_path, encoding="utf-8") as f:')
                        .replace('"srdf"', '".srdf"'))
        done.add("sapien")
assert done == {"mplib", "sapien"}, f"patched only {done}"
print("mplib / sapien patches applied")
PATCHEOF

# CuRobo (NVlabs) — RoboTwin's Robot.set_planner() builds a CuroboPlanner per arm on every reset, so the
# eval needs it even for joint-space policies. It compiles CUDA kernels → nvcc of torch's CUDA version.
TORCH_CUDA=$("${VENV_PY}" -c 'import torch; print(torch.version.cuda or "")')
log "[4/8] torch CUDA ${TORCH_CUDA}; looking for a matching nvcc..."
[[ "${TORCH_CUDA}" =~ ^[0-9]+\.[0-9]+$ ]] || die "torch in the venv has no CUDA build (torch.version.cuda='${TORCH_CUDA}')"
CUDA_HOME="/usr/local/cuda-${TORCH_CUDA}"
if [ ! -x "${CUDA_HOME}/bin/nvcc" ]; then
    _cu="${TORCH_CUDA//./-}"
    if ! apt-cache policy "cuda-nvcc-${_cu}" 2>/dev/null | grep -q "Candidate: [0-9]"; then
        # shellcheck disable=SC1091
        _ubu=$(. /etc/os-release && echo "ubuntu${VERSION_ID//./}")
        log "  adding the NVIDIA CUDA apt repository (${_ubu}) for cuda-nvcc-${_cu}..."
        curl -fsSL -o /tmp/cuda-keyring.deb \
            "https://developer.download.nvidia.com/compute/cuda/repos/${_ubu}/x86_64/cuda-keyring_1.1-1_all.deb" \
            && dpkg -i /tmp/cuda-keyring.deb && timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 \
            || die "could not add the NVIDIA CUDA apt repository"
    fi
    apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
        "cuda-nvcc-${_cu}" "cuda-cudart-dev-${_cu}" 2>&1 | tee /tmp/{{ vla }}_nvcc_apt.log \
        || die "cuda-nvcc-${_cu} install failed (see /tmp/{{ vla }}_nvcc_apt.log)"
fi
[ -x "${CUDA_HOME}/bin/nvcc" ] || die "no nvcc at ${CUDA_HOME}/bin/nvcc"
export CUDA_HOME
export PATH="${CUDA_HOME}/bin:${PATH}"
log "  $(nvcc --version | tail -1)"

log "[4/8] Building CuRobo {{ curobo_ref }} for sm_${GPU_CC//./} (~5-10 min)..."
if [ ! -d "${ROBOTWIN_DIR}/envs/curobo" ]; then
    git clone --branch {{ curobo_ref }} --depth 1 {{ curobo_repo }} "${ROBOTWIN_DIR}/envs/curobo" \
        2>&1 | tee /tmp/{{ vla }}_curobo_clone.log || die "CuRobo clone failed"
fi
CUROBO_COMMIT=$(git -C "${ROBOTWIN_DIR}/envs/curobo" rev-parse HEAD)
[ "${CUROBO_COMMIT}" = "{{ curobo_commit }}" ] \
    || die "CuRobo {{ curobo_ref }} resolves to ${CUROBO_COMMIT}, expected {{ curobo_commit }}"
# --no-build-isolation builds against the venv's torch; a uv venv has no setuptools, so add the build deps.
uv pip install --python "${VENV_PY}" --constraint /tmp/{{ vla }}_constraints.txt \
    setuptools wheel "setuptools_scm>=6.2" ninja pybind11 2>&1 | tee /tmp/{{ vla }}_curobo_build.log \
    || die "CuRobo build deps install failed"
( cd "${ROBOTWIN_DIR}/envs/curobo" && TORCH_CUDA_ARCH_LIST="${GPU_CC}" MAX_JOBS="$(nproc)" \
    uv pip install --python "${VENV_PY}" --constraint /tmp/{{ vla }}_constraints.txt --no-build-isolation -e . ) \
    2>&1 | tee -a /tmp/{{ vla }}_curobo_build.log || die "CuRobo build failed (see /tmp/{{ vla }}_curobo_build.log)"

# NVIDIA Warp (CuRobo's kernels), pinned to 1.9.1. Two problems with the version the resolver picks (1.18.0):
# its PyPI wheel is built for CUDA 13 and needs a 13.0 driver (the DLAMI has 570 = CUDA 12.8, so Warp sees no
# device and CuRobo dies in warp.from_torch), and 1.18 dropped the public `warp.torch` module that CuRobo
# v0.7.8 calls (`wp.torch.device_from_torch`). 1.9.1 is the last release whose PyPI wheel is a CUDA 12.8
# build and still has `warp.torch` (first two RoboTwin GPU runs failed on these in turn).
WARP_WHL=/tmp/warp_lang-1.9.1-py3-none-manylinux_2_28_x86_64.whl
curl -fsSL --retry 3 -o "${WARP_WHL}" \
    "https://files.pythonhosted.org/packages/py3/w/warp-lang/warp_lang-1.9.1-py3-none-manylinux_2_28_x86_64.whl" \
    || die "Warp 1.9.1 wheel download failed"
echo "2211e0cd9332ca44193801285cd1293c0b7580932da8da32e18d70b832adac12  ${WARP_WHL}" | sha256sum -c - \
    || die "Warp 1.9.1 wheel sha256 mismatch"
uv pip install --python "${VENV_PY}" --no-deps --reinstall "${WARP_WHL}" 2>&1 | tee /tmp/{{ vla }}_warp.log \
    || die "Warp 1.9.1 install failed"
"${VENV_PY}" -c "import warp as wp, warp.torch; wp.init(); assert wp.get_cuda_device_count() > 0, 'Warp sees no CUDA device'; assert hasattr(wp.torch, 'device_from_torch'); print('warp', wp.__version__, 'cuda devices', wp.get_cuda_device_count())" \
    2>&1 | tee -a /tmp/{{ vla }}_warp.log || die "Warp check failed (see /tmp/{{ vla }}_warp.log)"

NUMPY_NOW=$("${VENV_PY}" -c 'import numpy; print(numpy.__version__)')
[ "${NUMPY_NOW}" = "${NUMPY_LOCKED}" ] || die "numpy moved ${NUMPY_LOCKED} -> ${NUMPY_NOW} while installing RoboTwin deps"

# LeRobot RoboTwin wrapper patches (lerobot/envs/robotwin.py @{{ lerobot_commit[:8] }}), each asserted to match once:
#  (a) settings: the wrapper hard-codes task_config = "demo_clean"; read it from LEROBOT_ROBOTWIN_TASK_CONFIG
#      (default demo_clean = unchanged) so the randomized (Hard) setting can run.
#  (b) unstable seeds: RoboTwin's setup_demo() raises UnStableError when a seed spawns a falling object.
#      RoboTwin's own eval skips such seeds; LeRobot's reset() does not, so one bad seed kills the whole
#      task. Retry with seed + 100003 (outside every other episode's seed range), log RFM-UNSTABLE-SEED.
log "[4/8] Patching lerobot/envs/robotwin.py (task_config from env, unstable-seed retry)..."
"${VENV_PY}" - "${LEROBOT_DIR}/src/lerobot/envs/robotwin.py" << 'PATCHEOF' 2>&1 | tee /tmp/{{ vla }}_lerobot_patch.log \
    || die "lerobot robotwin.py patch failed (see /tmp/{{ vla }}_lerobot_patch.log)"
import sys
path = sys.argv[1]
src = open(path, encoding="utf-8").read()
a_old = '    task_config = "demo_clean"\n'
a_new = '    task_config = os.environ.get("LEROBOT_ROBOTWIN_TASK_CONFIG", "demo_clean")\n'
b_old = ("        with torch.enable_grad():\n"
         "            self._env.setup_demo(**setup_kwargs)\n")
b_new = ("        with torch.enable_grad():\n"
         "            for _rfm_try in range(10):\n"
         "                try:\n"
         "                    self._env.setup_demo(**setup_kwargs)\n"
         "                    break\n"
         "                except Exception as _rfm_e:  # RoboTwin UnStableError: skip the seed like its own eval\n"
         "                    if type(_rfm_e).__name__ != \"UnStableError\" or _rfm_try == 9:\n"
         "                        raise\n"
         "                    logger.warning(\"RFM-UNSTABLE-SEED task=%s seed=%s: %s\", self.task_name, setup_kwargs[\"seed\"], _rfm_e)\n"
         "                    print(f\"RFM-UNSTABLE-SEED task={self.task_name} seed={setup_kwargs['seed']}\", flush=True)\n"
         "                    try:\n"
         "                        self._env.close_env()\n"
         "                    except Exception:\n"
         "                        pass\n"
         "                    setup_kwargs[\"seed\"] = setup_kwargs[\"seed\"] + 100003\n")
for name, old, new in (("task_config", a_old, a_new), ("unstable-seed", b_old, b_new)):
    n = src.count(old)
    if n == 0 and src.count(new) == 1:
        print(f"{name}: already applied")
        continue
    assert n == 1, f"{name}: expected 1 match, found {n} (LeRobot pin changed?)"
    src = src.replace(old, new)
    print(f"{name}: applied")
open(path, "w", encoding="utf-8").write(src)
PATCHEOF

# ── [4.5/8] RoboTwin assets (pinned dataset revision) ──
# ── XET STALL GUARD: bound stalled Xet downloads ──────────────────────────────
# Xet-backed blobs are fetched by the hf_xet Rust client, so HF_HUB_DOWNLOAD_TIMEOUT does NOT apply;
# only the HF_XET_CLIENT_* knobs below do. hf-xet < 1.5.2 has an exponential-backoff defect that turns
# the first retry after a stalled socket into a multi-hour sleep, so raise it first (the venv is never
# re-synced after this point, see [4/8]).
export HF_XET_CLIENT_READ_TIMEOUT=60
export HF_XET_CLIENT_CONNECT_TIMEOUT=30
export HF_XET_CLIENT_RETRY_MAX_DURATION=120
export HF_XET_FIXED_DOWNLOAD_CONCURRENCY=8
log "[4.5/8] XET STALL GUARD: raising hf-xet to >= 1.5.2 if the lockfile pins older..."
uv pip install --python "${VENV_PY}" "hf-xet>=1.5.2" >> /tmp/{{ vla }}_hfxet_bump.log 2>&1 \
    || die "hf-xet upgrade failed (see /tmp/{{ vla }}_hfxet_bump.log)"
"${VENV_PY}" -c "
from huggingface_hub.utils._runtime import get_xet_version, is_xet_available
v = get_xet_version()
print('hf_xet:', v, 'xet path active:', is_xet_available())
assert tuple(int(x) for x in v.split('.')[:3]) >= (1, 5, 2), f'hf_xet not upgraded: {v}'
" >> /tmp/{{ vla }}_hfxet_bump.log 2>&1 \
    || die "hf-xet still below 1.5.2 after upgrade (see /tmp/{{ vla }}_hfxet_bump.log)"

# Wall-clock guard: a wedged Xet download emits nothing and returns nothing, so `|| die` never fires.
# Retry once — a dead CDN connection recovers in a fresh process and downloads resume from the cache.
HF_DOWNLOAD_TIMEOUT_SECS=2700
hf_dl_guard() {
    local _label="$1" _log="$2"; shift 2
    [ "${1:-}" = "--" ] && shift
    local _attempt _rc
    for _attempt in 1 2; do
        _rc=0
        timeout --signal=TERM --kill-after=60 "${HF_DOWNLOAD_TIMEOUT_SECS}" "$@" < /dev/null >> "${_log}" 2>&1 || _rc=$?
        [ "${_rc}" -eq 0 ] && return 0
        { echo "[hf-dl] ${_label} attempt ${_attempt} rc=${_rc} (wall-clock cap ${HF_DOWNLOAD_TIMEOUT_SECS}s)"
          [ "${_attempt}" -eq 1 ] && echo "[hf-dl] retrying ${_label} (resumes from the partial HF cache)"
        } >> "${_log}" 2>/dev/null || true
    done
    return 1
}

mkdir -p "${HF_CACHE_DIR}" "${ROBOTWIN_DIR}/assets"

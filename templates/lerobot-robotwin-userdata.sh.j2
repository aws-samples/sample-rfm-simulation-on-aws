# ── [7/8] RoboTwin eval: one lerobot-eval call per (setting, task) ──
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
mkdir -p "${EVAL_BASE_DIR}" "${VIDEO_BASE_DIR}"
# Official per-task step limits of the pinned RoboTwin (what its own eval uses as the episode cap).
STEP_LIMITS_JSON=$("${VENV_PY}" -c "import json, yaml; print(json.dumps(yaml.safe_load(open('${ROBOTWIN_DIR}/task_config/_eval_step_limit.yml'))))") \
    || die "could not read task_config/_eval_step_limit.yml"
STACK_SAPIEN=$("${VENV_PY}" -c 'import importlib.metadata as m; print(m.version("sapien"))' 2>/dev/null || echo unknown)

TASKS_JSON='{{ tasks_json }}'
TASK_COUNT=$(echo "$TASKS_JSON" | jq length)
SUMMARY_ALL=""
FAILED_TASKS=""

for TASK_IDX in $(seq 0 $((TASK_COUNT - 1))); do
    TASK=$(echo "$TASKS_JSON" | jq -r ".[$TASK_IDX]")
    SETTING=$(echo "$TASK" | jq -r '.setting')
    RT_TASK=$(echo "$TASK" | jq -r '.task')
    N_EPISODES=$(echo "$TASK" | jq -r '.n_episodes')
    SEED=$(echo "$TASK" | jq -r '.seed')
    DESCRIPTION=$(echo "$TASK" | jq -r '.description // ""')
    TASK_CONFIG=$(echo "$TASK" | jq -r '.task_config')
    SUITE="RoboTwin2/${SETTING}"
    {%- if episode_length %}
    EPISODE_LENGTH={{ episode_length }}
    {%- else %}
    EPISODE_LENGTH=$(echo "$STEP_LIMITS_JSON" | jq -r --arg t "${RT_TASK}" '.[$t] // 1000')
    {%- endif %}
    # Wall-clock cap per call: every episode at its step limit x {{ sec_per_step }} s/step + 30 min for the
    # policy load and env build. A wedged SAPIEN / CuRobo call then fails this task instead of the run.
    EVAL_TIMEOUT=$(awk -v n="${N_EPISODES}" -v s="${EPISODE_LENGTH}" -v p="{{ sec_per_step }}" 'BEGIN{printf "%d", n*s*p + 1800}')

    OUT_DIR="${EVAL_BASE_DIR}/task-${TASK_IDX}"
    rm -rf "${OUT_DIR}"
    mkdir -p "${OUT_DIR}"

    log "[7/8] Task $((TASK_IDX+1))/${TASK_COUNT}: ${SUITE} ${RT_TASK}, ${N_EPISODES} ep, seed ${SEED}, episode_length ${EPISODE_LENGTH}, cap ${EVAL_TIMEOUT}s"
    touch /tmp/{{ vla }}_task${TASK_IDX}_start.marker

    EVAL_ARGS=(
        --policy.path={{ hf_repo }}
        --policy.device=cuda
{%- for a in policy_args %}
        '{{ a }}'
{%- endfor %}
        --env.type=robotwin
        --env.task="${RT_TASK}"
        --env.episode_length="${EPISODE_LENGTH}"
{%- for a in env_args %}
        '{{ a }}'
{%- endfor %}
        '--rename_map={{ rename_map_json }}'
        --eval.batch_size=1
        --eval.use_async_envs=false
        --eval.n_episodes="${N_EPISODES}"
        --output_dir="${OUT_DIR}"
        --seed="${SEED}"
    )

    # Disable BOTH errexit AND the ERR trap around the eval: a failed task is recorded and the loop goes on
    # (one bad task must not throw away a multi-hour shard); the run fails at the end instead.
    set +e
    trap - ERR
    (
        cd "${ROBOTWIN_DIR}"
        LEROBOT_ROBOTWIN_TASK_CONFIG="${TASK_CONFIG}" timeout --signal=TERM --kill-after=120 "${EVAL_TIMEOUT}" \
            "${LEROBOT_DIR}/.venv/bin/lerobot-eval" "${EVAL_ARGS[@]}"
    ) 2>&1 | tr '\r' '\n' | grep -v '^step: ' | tee "/tmp/{{ vla }}_task${TASK_IDX}.log"
    EVAL_EXIT=${PIPESTATUS[0]}
    set -e

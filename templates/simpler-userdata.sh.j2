#!/bin/bash
# {{ display_name }} 1-Click UserData Script (SimplerEnv, the authors' own evaluation, in-process on one GPU)
# Checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] }}
# License:    {{ license }}
# Harness:    {{ harness_repo }} @ {{ harness_commit[:8] }} (ManiSkill2_real2sim @ {{ maniskill_commit[:8] }})
{%- if plugin %}
# Plugin:     {{ plugin.plugin_repo }} @ {{ plugin.plugin_commit[:8] }}: {{ plugin.plugin_src }} copied over simpler_env/
{%- endif %}
# Entry:      python {{ entry }} --policy-model {{ policy_model }} (one call per task variant)
# venv:       Python {{ python_version }} from assets/simpler/{{ requirements_name }} (embedded below)
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}{{ (' --task-set ' ~ task_set) if task_set else '' }}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName}       — results S3 bucket
#   ${SnsTopicArn}        — completion notification SNS topic
#   ${StackName}          — CDK stack name
#   ${WaitConditionUrl}   — CFN WaitConditionHandle presigned URL
#   ${Region}             — deployment region
#   ${AutoTerminate}      — "true" to auto-terminate EC2 after completion

set -euo pipefail

W=/home/ubuntu/{{ vla }}
HARNESS_DIR="${W}/harness"
VENV_DIR="${W}/venv"
CKPT_DIR="${W}/ckpt/{{ ckpt_name }}"
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
EVAL_BASE_DIR=/tmp/{{ vla }}-eval
VIDEO_BASE_DIR=/tmp/{{ vla }}-videos
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

# UserData runs as root; HOME must be set so uv puts caches in a stable place.
export HOME=/root
export HF_HOME="${HF_CACHE_DIR}"
# uv installs into ~/.local/bin
export PATH="/root/.local/bin:${PATH}"
mkdir -p "${W}"

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a /var/log/{{ vla }}-userdata.log; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/{{ vla }}-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

die() {
    log "ERROR: $*"
    # Best-effort: dump diagnostics to S3 before CFN rollback eats the instance
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ]; then
        local _diag_prefix="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag-fail"
        log "  Uploading /tmp/{{ vla }}_*.log to ${_diag_prefix}..."
        aws s3 cp /var/log/{{ vla }}-userdata.log "${_diag_prefix}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ vla }}_*.log; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag_prefix}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
    fi
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/7] System dependencies ──────────────────────────────────────
log "[1/7] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive

systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
pkill -9 -f "apt-get" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a 2>&1 | tee /tmp/{{ vla }}_dpkg_fix.log || true

# Boot hardening (2026-10): the command-not-found apt hook hung apt-get update for 3 h on a g6e, and the
# apt-daily timers re-launch unattended-upgrades mid-boot (held the dpkg lock past 5 min). Drop / mask both.
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 2400 apt-get update -qq -o DPkg::Lock::Timeout=1800 2>&1 | tee /tmp/{{ vla }}_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    log "[warn] apt-get update failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# libvulkan1 / vulkan-tools: SAPIEN 2.2 renders through Vulkan; the DLAMI ships the NVIDIA driver but not the
# Vulkan loader (`import sapien.core` fails with libvulkan.so.1). ffmpeg: mediapy writes the episode videos.
APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=1800 \
    git curl ca-certificates awscli jq \
    libvulkan1 vulkan-tools libgl1-mesa-glx libegl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    ffmpeg build-essential \
    2>&1 | tee /tmp/{{ vla }}_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    log "[warn] apt-get install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# ── [1.5/7] CloudWatch Logs agent setup ──────────────────────────
log "[1.5/7] Setting up CloudWatch Logs agent..."
# Log group MUST match the stack's IAM grant (/${vla}/* → /{{ vla }}/*).
CW_LOG_GROUP="/{{ vla }}/userdata"
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s 2>&1 | tee /tmp/{{ vla }}_cwagent.log \
        && log "  CW agent started (log group: ${CW_LOG_GROUP})" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi

# ── [2/7] NVIDIA driver, VRAM / host-RAM floors, Vulkan ICD ───────────────
log "[2/7] Checking GPU driver..."
nvidia-smi -L 2>&1 | tee /tmp/{{ vla }}_nvidia.log \
    || log "[warn] nvidia-smi failed — verify DLAMI"
# Fail-fast floors (models/{{ vla }}.yaml: min_gpu_mib / min_host_mib). Without them an undersized instance silently
# burns the full creationpolicy_timeout before the WaitCondition times out.
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || echo "0")
GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || echo "unknown")
log "  GPU0: ${GPU_NAME} ${GPU_MEM_MIB} MiB"
if [ "${GPU_MEM_MIB:-0}" -lt {{ min_gpu_mib }} ]; then
    die "{{ display_name }} needs a single GPU >= {{ min_gpu_mib }} MiB; GPU0 has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
log "  Host RAM: ${HOST_MEM_MIB} MiB"
if [ "${HOST_MEM_MIB:-0}" -lt {{ min_host_mib }} ]; then
    die "{{ display_name }} needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
# Vulkan ICD / layer JSON for the NVIDIA driver (source: simpler-env/ManiSkill2_real2sim docker/nvidia_icd.json and
# nvidia_layers.json; libGLX_nvidia.so.0 is the DLAMI driver). Same block as the rldx-simpler target.
mkdir -p /usr/share/vulkan/icd.d /etc/vulkan/implicit_layer.d
cat > /usr/share/vulkan/icd.d/nvidia_icd.json << 'VKICDEOF'
{
    "file_format_version" : "1.0.0",
    "ICD": {
        "library_path": "libGLX_nvidia.so.0",
        "api_version" : "1.2.155"
    }
}
VKICDEOF
cat > /etc/vulkan/implicit_layer.d/nvidia_layers.json << 'VKLAYEREOF'
{
    "file_format_version" : "1.0.0",
    "layer": {
        "name": "VK_LAYER_NV_optimus",
        "type": "INSTANCE",
        "library_path": "libGLX_nvidia.so.0",
        "api_version" : "1.2.155",
        "implementation_version" : "1",
        "description" : "NVIDIA Optimus layer",
        "functions": {
            "vkGetInstanceProcAddr": "vk_optimusGetInstanceProcAddr",
            "vkGetDeviceProcAddr": "vk_optimusGetDeviceProcAddr"
        },
        "enable_environment": {
            "__NV_PRIME_RENDER_OFFLOAD": "1"
        },
        "disable_environment": {
            "DISABLE_LAYER_NV_OPTIMUS_1": ""
        }
    }
}
VKLAYEREOF
vulkaninfo --summary 2>&1 | grep -iE "deviceName|driverName|apiVersion" | head -5 | tee -a /tmp/{{ vla }}_vulkan.log \
    || log "[warn] vulkaninfo probe inconclusive — the [4/7] SAPIEN renderer check is the gate"

# ── [3/7] uv + SimplerEnv harness (pinned, with its ManiSkill2_real2sim submodule) ──────────
log "[3/7] Installing uv (DLAMI does not pre-install)..."
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh 2>&1 | tee /tmp/{{ vla }}_uv_install.log \
        || die "uv install failed"
fi
log "  $(uv --version)"

log "[3/7] Cloning {{ harness_repo }} @ {{ harness_commit[:8] }}..."
if [ ! -d "${HARNESS_DIR}/.git" ]; then
    git clone {{ harness_repo }} "${HARNESS_DIR}" 2>&1 | tee /tmp/{{ vla }}_clone.log \
        || die "harness clone failed"
    git -C "${HARNESS_DIR}" checkout "{{ harness_commit }}" \
        || die "harness: checkout pinned commit {{ harness_commit[:8] }} failed"
    git -C "${HARNESS_DIR}" submodule update --init --recursive 2>&1 | tee -a /tmp/{{ vla }}_clone.log \
        || die "harness: ManiSkill2_real2sim submodule checkout failed"
fi
HARNESS_HEAD=$(git -C "${HARNESS_DIR}" rev-parse HEAD)
MANISKILL_HEAD=$(git -C "${HARNESS_DIR}/ManiSkill2_real2sim" rev-parse HEAD 2>/dev/null || echo none)
log "  harness: ${HARNESS_HEAD}  ManiSkill2_real2sim: ${MANISKILL_HEAD}"
[ "${HARNESS_HEAD}" = "{{ harness_commit }}" ] || die "harness commit mismatch: expected {{ harness_commit }}, got ${HARNESS_HEAD}"
[ "${MANISKILL_HEAD}" = "{{ maniskill_commit }}" ] \
    || die "ManiSkill2_real2sim commit mismatch: expected {{ maniskill_commit }}, got ${MANISKILL_HEAD}"
{%- if plugin %}

# The authors' SimplerEnv plugin: {{ plugin.plugin_src }} of {{ plugin.plugin_repo }} copied over the harness
# simpler_env/ ("copy './simpler_env' to the corresponding folder under 'SimplerEnv/simpler_env'").
PLUGIN_DIR="${W}/plugin"
log "[3/7] Cloning {{ plugin.plugin_repo }} @ {{ plugin.plugin_commit[:8] }} (SimplerEnv plugin)..."
if [ ! -d "${PLUGIN_DIR}/.git" ]; then
    git clone {{ plugin.plugin_repo }} "${PLUGIN_DIR}" 2>&1 | tee -a /tmp/{{ vla }}_clone.log \
        || die "plugin clone failed"
    git -C "${PLUGIN_DIR}" checkout "{{ plugin.plugin_commit }}" \
        || die "plugin: checkout pinned commit {{ plugin.plugin_commit[:8] }} failed"
fi
PLUGIN_HEAD=$(git -C "${PLUGIN_DIR}" rev-parse HEAD)
[ "${PLUGIN_HEAD}" = "{{ plugin.plugin_commit }}" ] || die "plugin commit mismatch: expected {{ plugin.plugin_commit }}, got ${PLUGIN_HEAD}"
[ -d "${PLUGIN_DIR}/{{ plugin.plugin_src }}" ] || die "plugin: {{ plugin.plugin_src }} not found at {{ plugin.plugin_commit[:8] }}"
cp -r "${PLUGIN_DIR}/{{ plugin.plugin_src }}/." "${HARNESS_DIR}/simpler_env/" || die "plugin copy failed"
log "  plugin copied: $(cd "${PLUGIN_DIR}/{{ plugin.plugin_src }}" && find . -type f | sort | tr '\n' ' ')"
{%- if plugin.shim_file %}
# The harness evaluator calls model.visualize_epoch(...) after every episode; {{ plugin.shim_class }} has none
# (AttributeError after episode 1, measured) -> no-op method appended. Episode videos are written by the evaluator.
SHIM_PY="${HARNESS_DIR}/simpler_env/{{ plugin.shim_file }}"
[ -f "${SHIM_PY}" ] || die "plugin shim target {{ plugin.shim_file }} not found"
grep -q 'def visualize_epoch' "${SHIM_PY}" || printf '\n\n# added by the deploy: the harness evaluator calls this after every episode\n{{ plugin.shim_class }}.visualize_epoch = lambda self, *args, **kwargs: None\n' >> "${SHIM_PY}"
log "  plugin shim: {{ plugin.shim_class }}.visualize_epoch (no-op)"
{%- endif %}
{%- endif %}
[ -f "${HARNESS_DIR}/{{ entry }}" ] || die "entry {{ entry }} not found in the harness"

# ── [4/7] venv from the lock file (assets/simpler/{{ requirements_name }}) + harness, checked ──────────
log "[4/7] uv venv --python {{ python_version }} + lock install (~10-20 min)..."
REQ_FILE="${W}/{{ requirements_name }}"
base64 -d > "${REQ_FILE}" << 'REQEOF'
{{ requirements_b64 }}REQEOF
uv venv --python {{ python_version }} "${VENV_DIR}" 2>&1 | tee /tmp/{{ vla }}_venv.log || die "uv venv failed"
PY="${VENV_DIR}/bin/python"
export UV_HTTP_TIMEOUT=300
timeout 3600 uv pip install --python "${PY}" -r "${REQ_FILE}" 2>&1 | tee /tmp/{{ vla }}_pip.log \
    || die "lock install failed (see /tmp/{{ vla }}_pip.log)"
# The harness and ManiSkill2_real2sim are editable installs WITHOUT dependencies: the lock already holds them (an
# unpinned resolve would pull gymnasium 1.x / numpy 2 into the SimplerEnv stack).
timeout 900 uv pip install --python "${PY}" --no-deps -e "${HARNESS_DIR}/ManiSkill2_real2sim" -e "${HARNESS_DIR}" \
    2>&1 | tee -a /tmp/{{ vla }}_pip.log || die "harness install failed (see /tmp/{{ vla }}_pip.log)"

export MUJOCO_GL=egl
export TOKENIZERS_PARALLELISM=false
export TF_CPP_MIN_LOG_LEVEL=2

log "[4/7] Verifying the venv (torch CUDA, policy wrapper + simulator imports, SAPIEN renderer)..."
# Quoted heredoc: the JSON list carries double quotes that bash would strip inside python -c "...".
( cd "${HARNESS_DIR}" && "${PY}" - <<'PYCHECK' ) 2>&1 | tee /tmp/{{ vla }}_import_check.log \
    || die "venv check failed (see /tmp/{{ vla }}_import_check.log)"
import importlib
import importlib.metadata
import torch
print('torch:', torch.__version__, 'cuda:', torch.version.cuda, 'available:', torch.cuda.is_available())
assert torch.cuda.is_available(), 'CUDA not visible to torch'
for m in {{ import_check_json }}:
    importlib.import_module(m)
    print('import OK:', m)
import numpy, gymnasium, transformers
print('numpy', numpy.__version__, 'gymnasium', gymnasium.__version__, 'transformers', transformers.__version__)
import sapien.core as sapien
engine = sapien.Engine()
renderer = sapien.SapienRenderer()  # as ManiSkill2_real2sim sapien_env.py builds it
engine.set_renderer(renderer)
print('SAPIEN renderer OK:', importlib.metadata.version('sapien'))
PYCHECK
STACK_VERSIONS=$("${PY}" -c "
import importlib.metadata as m
print(' '.join(f'{p}=={m.version(p)}' for p in ('torch', 'transformers', 'tensorflow', 'sapien', 'gymnasium', 'numpy')))
" 2>/dev/null || echo unknown)
log "  stack: ${STACK_VERSIONS}"

# ── [5/7] Checkpoint (pinned revision) into a local dir ──
# Xet / CDN stall guard: a wedged download emits nothing and returns nothing, so `|| die` never fires. Bound every
# fetch by wall clock and retry once (snapshot_download resumes from the partial cache). hf_xet ignores
# HF_HUB_DOWNLOAD_TIMEOUT; the HF_XET_CLIENT_* knobs below are the ones it reads.
export HF_XET_CLIENT_READ_TIMEOUT=60
export HF_XET_CLIENT_CONNECT_TIMEOUT=30
export HF_XET_CLIENT_RETRY_MAX_DURATION=120
export HF_XET_FIXED_DOWNLOAD_CONCURRENCY=8
HF_DOWNLOAD_TIMEOUT_SECS=2700
hf_dl_guard() {
    local _label="$1" _log="$2"; shift 2
    [ "${1:-}" = "--" ] && shift
    local _attempt _rc
    for _attempt in 1 2; do
        _rc=0
        timeout --signal=TERM --kill-after=60 "${HF_DOWNLOAD_TIMEOUT_SECS}" "$@" < /dev/null >> "${_log}" 2>&1 || _rc=$?
        [ "${_rc}" -eq 0 ] && return 0
        echo "[hf-dl] ${_label} attempt ${_attempt} rc=${_rc} (wall-clock cap ${HF_DOWNLOAD_TIMEOUT_SECS}s)" >> "${_log}"
    done
    return 1
}
mkdir -p "${HF_CACHE_DIR}" "$(dirname "${CKPT_DIR}")"
# Local dir named after the repo ({{ ckpt_name }}): the policy wrappers take the path as model id, and the name is
# what SimplerEnv puts in its result paths.
log "[5/7] Checkpoint {{ hf_repo }} (rev {{ hf_model_revision[:8] }}) -> ${CKPT_DIR}..."
hf_dl_guard "checkpoint {{ hf_repo }}" /tmp/{{ vla }}_hf_download.log -- "${PY}" -c "
from huggingface_hub import snapshot_download
print('checkpoint:', snapshot_download('{{ hf_repo }}', revision='{{ hf_model_revision }}', local_dir='${CKPT_DIR}'))
" || die "checkpoint download failed: {{ hf_repo }} (see /tmp/{{ vla }}_hf_download.log)"
{%- for p in prefetch %}
log "[5/7] Prefetch {{ p.repo }} (rev {{ p.revision[:8] }}) into the HF cache..."
hf_dl_guard "prefetch {{ p.repo }}" /tmp/{{ vla }}_hf_download.log -- "${PY}" -c "
from huggingface_hub import snapshot_download
print('prefetch:', snapshot_download('{{ p.repo }}', revision='{{ p.revision }}'))
" || die "prefetch failed: {{ p.repo }} (see /tmp/{{ vla }}_hf_download.log)"
{%- endfor %}
log "  checkpoint files: $(ls "${CKPT_DIR}" | tr '\n' ' ')"

# ── [6/7] One main_inference call per task variant; outcome from the video names ──
mkdir -p "${EVAL_BASE_DIR}" "${VIDEO_BASE_DIR}"
POLICY_ARGS=({% for a in policy_args %}"{{ a }}" {% endfor %})
TASKS_JSON='{{ tasks_json }}'
TASK_COUNT=$(echo "$TASKS_JSON" | jq length)
SUMMARY_ALL=""
log "[6/7] ${TASK_COUNT} task(s), {{ n_episodes_total }} episode(s) in total"

for TASK_IDX in $(seq 0 $((TASK_COUNT - 1))); do
    TASK=$(echo "$TASKS_JSON" | jq -r ".[$TASK_IDX]")
    TASK_NAME=$(echo "$TASK" | jq -r '.name')
    ENV_NAME=$(echo "$TASK" | jq -r '.env_name')
    SUITE=$(echo "$TASK" | jq -r '.suite')
    POLICY_SETUP=$(echo "$TASK" | jq -r '.policy_setup')
    ACTION_TYPE=$(echo "$TASK" | jq -r '.action_type // "other"')   # task_sets.py tag, carried into summary.txt
    DESCRIPTION=$(echo "$TASK" | jq -r '.description // ""')
    SOURCE=$(echo "$TASK" | jq -r '.source // ""')
    N_EXPECTED=$(echo "$TASK" | jq -r '.n_episodes')
    N_VARIANTS=$(echo "$TASK" | jq -r '.variants | length')
    mapfile -t TASK_ARGS < <(echo "$TASK" | jq -r '.args[]')
    MAX_STEPS=$(echo "$TASK" | jq -r '.args as $a | ($a | index("--max-episode-steps")) as $i | if $i then $a[$i+1] else "80" end')

    OUT_DIR="${EVAL_BASE_DIR}/task-${TASK_IDX}"
    rm -rf "${OUT_DIR}"
    mkdir -p "${OUT_DIR}"
    log "[6/7] Task $((TASK_IDX+1))/${TASK_COUNT}: ${TASK_NAME} (${ENV_NAME}, ${POLICY_SETUP}), ${N_VARIANTS} variant(s), ${N_EXPECTED} ep"
    : > "/tmp/{{ vla }}_task${TASK_IDX}.log"
    EVAL_EXIT=0
    for VI in $(seq 0 $((N_VARIANTS - 1))); do
        mapfile -t VARIANT_ARGS < <(echo "$TASK" | jq -r ".variants[$VI][]")
        EVAL_ARGS=(
            --policy-model "{{ policy_model }}"
            --ckpt-path "${CKPT_DIR}"
            --policy-setup "${POLICY_SETUP}"
            --env-name "${ENV_NAME}"
            --logging-dir "${OUT_DIR}/v${VI}"
            "${POLICY_ARGS[@]}"
            "${TASK_ARGS[@]}"
            "${VARIANT_ARGS[@]}"
        )
        echo "[variant ${VI}] python {{ entry }} ${EVAL_ARGS[*]}" >> "/tmp/{{ vla }}_task${TASK_IDX}.log"
        set +e
        trap - ERR
        ( cd "${HARNESS_DIR}" && timeout 14400 "${PY}" {{ entry }} "${EVAL_ARGS[@]}" ) \
            >> "/tmp/{{ vla }}_task${TASK_IDX}.log" 2>&1
        VRC=$?
        set -e
        trap '_trap_handler' ERR
        if [ "${VRC}" -ne 0 ]; then
            log "  [error] variant ${VI} exit=${VRC}"
            EVAL_EXIT=${VRC}
            break
        fi
    done

    # SimplerEnv names every episode video <success|failure>_obj_..._<episode stats>.mp4 under
    # <logging dir>/<scene>/<control mode>/<env>/<robot pose + overlay>/ (maniskill2_evaluator.py). Count and copy
    # them as <task name>--<success|failure>-NNN.mp4, NNN in the evaluator's order (variant, then path).
    VIDEO_DIR="${VIDEO_BASE_DIR}/task-${TASK_IDX}"
    rm -rf "${VIDEO_DIR}"
    mkdir -p "${VIDEO_DIR}"
    N_SUCCESS=0
    N_DONE=0
    while IFS= read -r -d '' _mp4; do
        case "$(basename "$_mp4")" in
            success_*) _tag=success; N_SUCCESS=$((N_SUCCESS + 1)) ;;
            failure_*) _tag=failure ;;
            *) continue ;;
        esac
        N_DONE=$((N_DONE + 1))
        cp "$_mp4" "${VIDEO_DIR}/$(printf '%s--%s-%03d.mp4' "${TASK_NAME}" "${_tag}" "${N_DONE}")" || true
    done < <(find "${OUT_DIR}" -name "*.mp4" -print0 2>/dev/null | sort -z)
    if [ "${N_DONE}" -gt 0 ]; then
        SR=$(awk -v k="${N_SUCCESS}" -v n="${N_DONE}" 'BEGIN{printf "%.3f", k/n}')
    else
        SR="unknown"
    fi
    VIDEO_COUNT=$(find "${VIDEO_DIR}" -name "*.mp4" 2>/dev/null | wc -l)
    log "  ${TASK_NAME}: ${N_SUCCESS}/${N_DONE} success (expected ${N_EXPECTED} episodes), success_rate=${SR}"

    {
        echo "model: {{ vla }}"
        echo "checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] }}"
        echo "policy_model: {{ policy_model }}"
        echo "harness: {{ harness_repo }}@{{ harness_commit[:8] }}"
{%- if plugin %}
        echo "plugin: {{ plugin.plugin_repo }}@{{ plugin.plugin_commit[:8] }} ({{ plugin.plugin_src }})"
{%- endif %}
        echo "suite: ${SUITE}"
        echo "env_name: ${TASK_NAME}"
        echo "simpler_env: ${ENV_NAME}"
        echo "policy_setup: ${POLICY_SETUP}"
        echo "action_type: ${ACTION_TYPE}"
        echo "n_episodes_per_task: ${N_EXPECTED}"
        echo "success_rate: ${SR}"
        echo "n_success: ${N_SUCCESS}"
        echo "n_episodes: ${N_DONE}"
        echo "max_episode_steps: ${MAX_STEPS}"
        echo "init_states: SimplerEnv fixed grid, ${N_VARIANTS} variant(s) (task args in summary)"
        echo "condition: S0"
        echo "source: ${SOURCE}"
        echo "stack_harness_commit: ${HARNESS_HEAD}"
        echo "stack_maniskill2_real2sim_commit: ${MANISKILL_HEAD}"
        echo "stack_versions: ${STACK_VERSIONS}"
        echo "stack_gpu: ${GPU_NAME}"
        echo "stack_eval_args: ${POLICY_ARGS[*]} ${TASK_ARGS[*]}"
        echo "description: ${DESCRIPTION}"
    } > "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt"

    S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}"
    log "  S3 upload: ${S3_TASK_PREFIX}"
    UPLOAD_COUNT=0
    while IFS= read -r mp4_file || [[ -n "$mp4_file" ]]; do
        [ -f "$mp4_file" ] || continue
        fname=$(basename "$mp4_file")
        base="${fname%.mp4}"
        txt_file="/tmp/{{ vla }}_ctx_task${TASK_IDX}_ep${UPLOAD_COUNT}.txt"
        {
            echo "=== {{ display_name }} Simulation Context ==="
            printf "Video:      %s\n"  "${fname}"
            printf "Date:       %s\n"  "$(date '+%Y-%m-%d')"
            echo ""
            echo "--- Environment ---"
            printf "Task:       %s (%s)\n" "${TASK_NAME}" "${ENV_NAME}"
            printf "Robot:      %s\n" "{{ robot_label }}"
            printf "Simulator:  %s\n" "{{ sim_label }}"
            printf "Action:     %s\n" "${ACTION_TYPE}"
            echo ""
            echo "--- Model ---"
            printf "Checkpoint: %s (rev %s)\n" "{{ hf_repo }}" "{{ hf_model_revision[:8] }}"
            printf "Harness:    %s@%s\n" "{{ harness_repo }}" "{{ harness_commit[:8] }}"
            printf "License:    %s\n" "{{ license }}"
            echo ""
            echo "--- Rollout ---"
            printf "run_id:        %s\n"  "${RUN_ID}"
            printf "task_idx:      %s\n"  "${TASK_IDX}"
            printf "task_success:  %s (%s of %s episodes)\n" "${SR}" "${N_SUCCESS}" "${N_DONE}"
            echo ""
            echo "--- Infrastructure ---"
            printf "Instance: %s (%s)\n"  "${INSTANCE_ID}" "${INSTANCE_TYPE}"
            printf "Region:   %s\n"  "${REGION}"
            printf "Stack:    %s (CDK)\n" "${STACK_NAME}"
        } > "$txt_file"
        if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" \
            --region "$REGION" >> /var/log/{{ vla }}-userdata.log 2>&1; then
            UPLOAD_COUNT=$((UPLOAD_COUNT+1))
            aws s3 cp "$txt_file" "${S3_TASK_PREFIX}/videos/${base}.txt" \
                --region "$REGION" 2>/dev/null || true
        else
            log "  [warn] Upload failed: $fname"
        fi
    done < <(find "$VIDEO_DIR" -name "*.mp4" 2>/dev/null | sort)
    log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"

    aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}.log" \
        "${S3_TASK_PREFIX}/eval.log" --region "$REGION" || true
    [ -f "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" ] && \
        aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" \
        "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true
    {% from "_protocol-card.sh.j2" import protocol_card with context %}{{ protocol_card('"/tmp/' ~ vla ~ '_task${TASK_IDX}_summary.txt"', '"${S3_TASK_PREFIX}"') }}

    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${TASK_NAME} (${ACTION_TYPE}) — ${N_SUCCESS}/${N_DONE} success (success_rate=${SR})"
    log "  Task $((TASK_IDX+1)) done"

    if [ "${EVAL_EXIT}" -ne 0 ]; then
        die "Task ${TASK_IDX} eval failed (exit=${EVAL_EXIT}) — see s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}/eval.log"
    fi
    if [ "${N_DONE}" -ne "${N_EXPECTED}" ]; then
        die "Task ${TASK_IDX} wrote ${N_DONE} episode videos, expected ${N_EXPECTED} — see s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}/eval.log"
    fi
done

# ── [7/7] SNS notification + cfn-signal ──────────────────────────
log "[7/7] Sending SNS notification..."

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} simulation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}

Model: {{ policy_desc }}
Checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] }}
Harness: {{ harness_repo }}@{{ harness_commit[:8] }}
License: {{ license }}
Simulation: {{ sim_label }}
Instance: ${INSTANCE_TYPE}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} simulation complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[7/7] Sending cfn-signal..."
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

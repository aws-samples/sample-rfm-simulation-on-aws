{%- else %}
    "${VENV}/bin/python" gr00t/eval/rollout_policy.py \
        --env-name "${ENV_NAME}" \
        --policy-client-host localhost \
        --policy-client-port 8000 \
        --n-episodes "${N_EPISODES}" \
        --n-envs "${N_ENVS}" \
        --max-episode-steps "${MAX_STEPS}" \
        "${K_ARGS[@]}" \
        2>&1 | tee /tmp/gr00t_rollout_task${TASK_IDX}.log \
        || log "  [warn] Task ${TASK_IDX} rollout error (continuing)"
{%- endif %}
{%- if sim_id == "simpler" %}
    # The very first get_action on a fresh instance can outlast the client's 15 s ZMQ receive timeout
    # (cold CUDA kernels / caches): the first gr00t-bridge GPU run lost task 0 to `zmq.error.Again` while
    # tasks 1-3 (same server start path) ran normally. Retry the task once in that case only.
    if grep -q 'zmq.error.Again' /tmp/gr00t_rollout_task${TASK_IDX}.log 2>/dev/null \
        && ! grep -qE 'success rate:[[:space:]]+[0-9.]+' /tmp/gr00t_rollout_task${TASK_IDX}.log; then
        log "  [warn] Task ${TASK_IDX}: first policy call timed out (zmq.error.Again) — retrying the task once"
        find /tmp -name "*.mp4" -newer /tmp/gr00t_task${TASK_IDX}_start.marker -delete 2>/dev/null || true
        sleep 20
        touch /tmp/gr00t_task${TASK_IDX}_start.marker
        "${VENV}/bin/python" gr00t/eval/rollout_policy.py \
            --env-name "${ENV_NAME}" \
            --policy-client-host localhost \
            --policy-client-port 8000 \
            --n-episodes "${N_EPISODES}" \
            --n-envs "${N_ENVS}" \
            --max-episode-steps "${MAX_STEPS}" \
            "${K_ARGS[@]}" \
            2>&1 | tee /tmp/gr00t_rollout_task${TASK_IDX}.log \
            || log "  [warn] Task ${TASK_IDX} rollout retry error (continuing)"
    fi
{%- endif %}
{%- if not libero_plus %}

    # Collect videos (CLI saves to /tmp/sim_eval_videos_<env>/<uuid>/video.mp4)
    find /tmp -name "*.mp4" -newer /tmp/gr00t_task${TASK_IDX}_start.marker \
        -exec mv {} "${VIDEO_DIR}/" \; 2>/dev/null || true
{%- endif %}
    VIDEO_COUNT=$(find "${VIDEO_DIR}" -name "*.mp4" 2>/dev/null | wc -l)
    log "  Videos collected: ${VIDEO_COUNT}"
{%- if libero_plus %}

    # LIBERO-Plus: k/n summed over the variants that reported a rate (a crashed variant is not counted).
    N_EPISODES=${LP_DONE}
    N_SUCCESS=${LP_SUCC_SUM}
    SR=$(awk "BEGIN { if (${LP_DONE} > 0) printf \"%.4f\", ${LP_SUCC_SUM} / ${LP_DONE}; else print \"unknown\" }")
{%- else %}

    # Parse success rate from rollout output (e.g. "success rate:  0.8")
    SR=$(grep -oE 'success rate:[[:space:]]+[0-9.]+' \
        /tmp/gr00t_rollout_task${TASK_IDX}.log 2>/dev/null | tail -1 | awk '{print $NF}' || echo "unknown")
    N_SUCCESS=$(awk "BEGIN { printf \"%d\", ${N_EPISODES} * ${SR:-0} }" 2>/dev/null || echo "?")
{%- endif %}
    log "  success_rate=${SR} (${N_SUCCESS}/${N_EPISODES})"

    # Write summary.txt
    {
        echo "env_name: ${ENV_NAME}"
{%- if sim_id == 'simpler' %}
        echo "suite: ${SUITE}"
        echo "seed: ${K_SEED:-none}"
{%- endif %}
        echo "success_rate: ${SR}"
        echo "n_episodes: ${N_EPISODES}"
        echo "n_success: ${N_SUCCESS}"
        echo "fps: ${VIDEO_FPS}, crf: ${VIDEO_CRF}, steps_per_render: ${STEPS_PER_RENDER}"
        echo "condition: ${K_COND}"
        echo "replan: ${K_REPLAN:-default}"
        echo "max_episode_steps: ${MAX_STEPS}"
        echo "stack_isaac_groot_commit: $(git -C "${ISAAC_GROOT_DIR}" rev-parse HEAD 2>/dev/null || echo unknown)"
{%- if libero_plus %}
        echo "suite: ${SUITE}"
        echo "benchmark: libero_plus"
        echo "perturbation: ${LP_KEY}"
        echo "perturbation_category: ${LP_CAT}"
        echo "variants: ${LP_N} (seed ${LP_SEED}; ids in libero_plus_variants.json)"
        echo "stack_libero_plus_commit: ${LP_COMMIT}"
        echo "stack_libero_plus_assets: {{ libero_plus.assets_repo }}@{{ libero_plus.assets_revision[:8] }}"
{%- endif %}
{%- if sim_id == 'simpler' %}
        echo "stack_sapien: $("${VENV}/bin/python" -c 'import sapien; print(sapien.__version__)' 2>/dev/null || echo unknown)"
        echo "stack_simplerenv_commit: $(git -C "${ISAAC_GROOT_DIR}/external_dependencies/SimplerEnv" rev-parse HEAD 2>/dev/null || echo unknown)"
{%- else %}
        echo "stack_mujoco: $("${VENV}/bin/python" -c 'import mujoco; print(mujoco.__version__)' 2>/dev/null || echo unknown)"
{%- endif %}
    } > "/tmp/gr00t_task${TASK_IDX}_summary.txt"

    # Stop ZMQ server / bridge
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true

    # S3 upload (cp loop + Context txt)
    S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}"
    log "  S3 upload: ${S3_TASK_PREFIX}"
    log "  VIDEO_DIR(${VIDEO_DIR}) contents:"
    ls -la "$VIDEO_DIR/" 2>&1 | tee -a /var/log/gr00t-userdata.log || true
    UPLOAD_COUNT=0
    while IFS= read -r mp4_file || [[ -n "$mp4_file" ]]; do
        [ -f "$mp4_file" ] || continue
        fname=$(basename "$mp4_file")
        base="${fname%.mp4}"

        # Context txt (rich metadata alongside each video)
        txt_file="/tmp/gr00t_ctx_task${TASK_IDX}_ep${UPLOAD_COUNT}.txt"
        {
            echo "=== GR00T Simulation Context ==="
            printf "Video:      %s\n"  "${fname}"
            printf "Date:       %s\n"  "$(date '+%Y-%m-%d')"
            echo ""
            echo "--- Environment ---"
            printf "Task:       %s\n"  "${TASK_NAME}"
            printf "Gym ID:     %s\n"  "${ENV_NAME}"
{%- if sim_id == 'simpler' %}
            printf "Suite:      %s\n"  "${SUITE}"
            printf "Sim:        {{ sim_label }}\n"
            printf "Robot:      {{ robot_label }}\n"
{%- else %}
            printf "Suite:      robocasa-gr1-tabletop-tasks\n"
            printf "Robot:      NVIDIA Fourier GR1 (%s)\n" "${ROBOT_TAG}"
{%- endif %}
            echo ""
            echo "--- Model ---"
            printf "Model:      {{ hf_repo }}{% if hf_subfolder %}/{{ hf_subfolder }}{% endif %} (rev: {{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }})\n"
            printf "Embodiment: %s\n"  "${EMBODIMENT}"
            echo ""
            echo "--- Rollout ---"
            printf "run_id:       %s\n"  "${RUN_ID}"
            printf "task_idx:     %s\n"  "${TASK_IDX}"
            printf "episode:      %s\n"  "${UPLOAD_COUNT}"
            printf "n_episodes:   %s\n"  "${N_EPISODES}"
            printf "success_rate: %s/%s (%s)\n" "${N_SUCCESS:-?}" "${N_EPISODES}" "${SR:-?}"
            echo ""
            echo "--- Video Encoding ---"
            printf "fps: %s / crf: %s / steps_per_render: %s\n" \
                "${VIDEO_FPS}" "${VIDEO_CRF}" "${STEPS_PER_RENDER}"
            echo ""
            echo "--- Infrastructure ---"
            printf "Instance: %s (%s)\n"  "${INSTANCE_ID}" "${INSTANCE_TYPE}"
            printf "Region:   %s\n"  "${REGION}"
            printf "Stack:    %s (CDK)\n" "${STACK_NAME}"
        } > "$txt_file"

        if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/$fname" \
            --region "$REGION" 2>&1 | tee -a /var/log/gr00t-userdata.log; then
            UPLOAD_COUNT=$((UPLOAD_COUNT+1))
            log "  Uploaded: $fname"

            # Context txt alongside video
            aws s3 cp "$txt_file" "${S3_TASK_PREFIX}/videos/${base}.txt" \
                --region "$REGION" 2>/dev/null || true
        else
            log "  [warn] Upload failed: $fname"
        fi
    done < <(find "$VIDEO_DIR" -name "*.mp4" 2>/dev/null | sort)
    log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"
    aws s3 cp "/tmp/gr00t_rollout_task${TASK_IDX}.log" \
        "${S3_TASK_PREFIX}/rollout.log" --region "$REGION" || true
    [ -f "/tmp/gr00t_task${TASK_IDX}_summary.txt" ] && \
        aws s3 cp "/tmp/gr00t_task${TASK_IDX}_summary.txt" \
        "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true
    {% from "_protocol-card.sh.j2" import protocol_card with context %}{{ protocol_card('"/tmp/gr00t_task${TASK_IDX}_summary.txt"', '"${S3_TASK_PREFIX}"') }}
{%- if libero_plus %}
    [ -f "${LP_MANIFEST}" ] && \
        aws s3 cp "${LP_MANIFEST}" "${S3_TASK_PREFIX}/libero_plus_variants.json" --region "$REGION" || true
{%- endif %}

    # Collect summaries
    if [ -f "/tmp/gr00t_task${TASK_IDX}_summary.txt" ]; then
        SR=$(grep 'success_rate' "/tmp/gr00t_task${TASK_IDX}_summary.txt" | awk '{print $2}')
        NS=$(grep 'n_success' "/tmp/gr00t_task${TASK_IDX}_summary.txt" | awk '{print $2}')
        NE=$(grep 'n_episodes' "/tmp/gr00t_task${TASK_IDX}_summary.txt" | awk '{print $2}')
        ENV_SHORT=$(echo "$ENV_NAME" | rev | cut -d'/' -f1 | rev | cut -c1-50)
        SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${ENV_SHORT} — ${SR} (${NS}/${NE})"
    fi

    log "  Task $((TASK_IDX+1)) done"
done

# ── [5/6] SNS notification + cfn-signal ──────────────────────────
log "[5/6] Sending SNS notification..."

{% if remote_grpc_endpoint %}
_MODE_INFO="Mode: Bridge (remote gRPC → {{ remote_grpc_endpoint }})"
{% else %}
_MODE_INFO="Mode: Local (GR00T model loaded on EC2)"
{% endif %}

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] Simulation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}

${_MODE_INFO}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./gr00t-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "GR00T simulation complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[5/6] Sending cfn-signal..."
cfn_signal 0

# ── [6/6] EC2 auto-terminate ──────────────────────────────────────
if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[6/6] Auto-terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== GR00T UserData complete ====="

#!/bin/bash
# RLinf evaluate -> RL post-train -> re-evaluate UserData ({{ display_name }}, LIBERO, local mode only)
# Suite: {{ task_suite_name }}   SFT checkpoint: {{ hf_repo }} (rev {{ hf_model_revision[:8] }})
# Profile: {{ profile }} ({{ rl_steps }} GRPO steps{% if eval_run %}, eval-only of run {{ eval_run }}{% endif %})
# RLinf {{ rlinf_commit[:8] }} in {{ docker_image }}@{{ docker_digest[:19] }}
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }} --rl-profile {{ profile }}{% if steps_overridden %} --rl-steps {{ rl_steps }}{% endif %}{% if eval_run %} --rl-eval-run {{ eval_run }}{% endif %}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName} ${SnsTopicArn} ${StackName} ${WaitConditionUrl} ${Region} ${AutoTerminate}
#
# Stages (each one fails fast before the next, more expensive one):
#   [1/9] packages + logs   [2/9] GPU / host floors   [3/9] RLinf image (by digest)   [4/9] RLinf clone (pinned)
#   [5/9] full-chain verify in the image (imports, mujoco pin, one LIBERO render, hydra compose of the exact
#         train command)   [6/9] SFT checkpoint (pinned)   [7/9] (a) baseline eval -> task-0
#   [8/9] (b) GRPO training -> checkpoint + training curve to S3   [9/9] (c) RL eval -> task-1, (d) report

set -euo pipefail

WORK=/opt/rlinf-work
RLINF_DIR="${WORK}/RLinf"
CTR=rlinf
RUN_ID=$(date '+%Y-%m-%d-%H%M')
START_EPOCH=$(date +%s)
LOG_FILE=/var/log/{{ vla }}-userdata.log

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

export HOME=/root

RL_PROFILE="{{ profile }}"
RL_STEPS={{ rl_steps }}
RL_SAVE_INTERVAL={{ save_interval }}
EVAL_NUM_ENVS={{ eval_num_envs }}
MAX_WALL_HOURS={{ max_wall_hours }}
EARLY_SIGNAL={{ 'true' if early_signal else 'false' }}
EVAL_RUN="{{ eval_run }}"
RL_CONDITION="rl-grpo-{{ rl_steps }}steps"
EARLY_SIGNALED=false

log() { echo "[RLINF] $(date '+%H:%M:%S') $*" | tee -a "${LOG_FILE}"; }

cfn_signal() {
    local exit_code=$1 _status _token _iid _data
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status -> WaitCondition"
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    _iid=$(curl -s -H "X-aws-ec2-metadata-token: $_token" "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_iid}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' --data-binary "$_data" "$WAIT_CONDITION_URL" 2>&1 | tee -a "${LOG_FILE}" \
        && log "cfn_signal $_status sent" || log "[warn] cfn_signal send failed (continuing)"
}

self_terminate() {
    local _token _iid
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    _iid=$(curl -s -H "X-aws-ec2-metadata-token: $_token" "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "")
    [ -n "${_iid}" ] && aws ec2 terminate-instances --instance-ids "${_iid}" --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
}

upload_log() { aws s3 cp "${LOG_FILE}" "s3://${S3_BUCKET}/${RUN_ID}/userdata.log" --region "$REGION" >/dev/null 2>&1 || true; }

die() {
    log "ERROR: $*"
    upload_log
    cfn_signal 1
    if [ "${EARLY_SIGNALED}" = true ]; then
        # The stack already reported success after the baseline stage: the e-mail is the only failure signal left.
        aws sns publish --topic-arn "$SNS_TOPIC_ARN" --region "$REGION" \
            --subject "RLinf run FAILED after the baseline stage — ${STACK_NAME}" \
            --message "[${STACK_NAME}] RLinf run ${RUN_ID} failed: $*
Log: s3://${S3_BUCKET}/${RUN_ID}/userdata.log" || true
        [ "${AUTO_TERMINATE}" = "true" ] && self_terminate
    fi
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        die "script exited abnormally (line ${BASH_LINENO[0]:-?})"
    fi
}
trap '_trap_handler' ERR

log "===== RLinf UserData start (RUN_ID: ${RUN_ID}, profile ${RL_PROFILE}, ${RL_STEPS} steps) ====="
mkdir -p "${WORK}/logs" "${WORK}/ckpt" "${WORK}/out"

# Cost guard for every profile: whatever happens, the instance is gone after MAX_WALL_HOURS.
( sleep $((MAX_WALL_HOURS * 3600))
  log "[watchdog] ${MAX_WALL_HOURS} h wall-clock cap reached — terminating"
  upload_log
  aws sns publish --topic-arn "$SNS_TOPIC_ARN" --region "$REGION" \
      --subject "RLinf run hit the ${MAX_WALL_HOURS} h cap — ${STACK_NAME}" \
      --message "[${STACK_NAME}] RLinf run ${RUN_ID} was stopped by the ${MAX_WALL_HOURS} h wall-clock cap. Partial results: s3://${S3_BUCKET}/${RUN_ID}/" || true
  self_terminate ) &

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/9] System packages + CloudWatch Logs ─────────────────────────
log "[1/9] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive
systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 >> /tmp/rlinf_apt.log 2>&1 \
    && apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 git curl ca-certificates awscli jq \
       >> /tmp/rlinf_apt.log 2>&1; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get failed after 3 retries (see /tmp/rlinf_apt.log)"
    log "[warn] apt-get failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << CWEOF
{"logs": {"logs_collected": {"files": {"collect_list": [
  {"file_path": "${LOG_FILE}", "log_group_name": "/{{ vla }}/userdata", "log_stream_name": "{instance_id}", "timezone": "UTC"},
  {"file_path": "${WORK}/logs/*.log", "log_group_name": "/{{ vla }}/userdata", "log_stream_name": "{instance_id}-stages", "timezone": "UTC"}
]}}}}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s >> /tmp/rlinf_cwagent.log 2>&1 \
        && log "  CW agent started (log group /{{ vla }}/userdata)" || log "[warn] CW agent start failed — logs local only"
fi

# ── [2/9] GPU count / VRAM / host RAM floors ─────────────────────────
log "[2/9] Checking GPUs..."
nvidia-smi -L 2>&1 | tee -a "${LOG_FILE}" || die "nvidia-smi failed (no NVIDIA driver on this AMI?)"
GPU_COUNT=$(nvidia-smi -L 2>/dev/null | grep -c '^GPU ' || true)
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | sort -n | head -1 | tr -d ' ' || echo 0)
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
DRIVER=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ' || echo unknown)
NPROC=$(nproc)
log "  GPUs: ${GPU_COUNT} (smallest ${GPU_MEM_MIB} MiB), driver ${DRIVER}, host RAM ${HOST_MEM_MIB} MiB, ${NPROC} vCPU"
[ "${GPU_COUNT}" -ge {{ min_gpus }} ] || die "profile ${RL_PROFILE} needs >= {{ min_gpus }} GPUs; ${INSTANCE_TYPE} has ${GPU_COUNT}"
[ "${GPU_MEM_MIB:-0}" -ge {{ min_gpu_mib }} ] || die "profile ${RL_PROFILE} needs >= {{ min_gpu_mib }} MiB per GPU; smallest GPU has ${GPU_MEM_MIB} MiB"
[ "${HOST_MEM_MIB:-0}" -ge {{ min_host_mib }} ] || die "profile ${RL_PROFILE} needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB"
# /dev/shm for the env workers and Ray's object store: 40% of host RAM (RLinf docs use 20-100 GB).
SHM_GB=$(( HOST_MEM_MIB * 4 / 10 / 1024 ))

# ── [3/9] RLinf image, pulled by digest ─────────────────────────────
log "[3/9] Docker + NVIDIA runtime..."
command -v docker >/dev/null 2>&1 || die "docker not found on the AMI"
systemctl start docker 2>/dev/null || true
# cgroupfs driver so a stray systemctl daemon-reload cannot revoke GPU device access mid-run (the
# container then sees "Failed to initialize NVML: Unknown Error", torch reports no CUDA, RLinf places
# the rollout worker on NO_ACCEL and it dies; same fix as cosmos-policy / robolab).
nvidia-ctk runtime configure --runtime=docker > /dev/null 2>&1 || true
python3 - <<'PYEOF' || die "could not set the Docker cgroup driver"
import json, os
p = "/etc/docker/daemon.json"
cfg = json.load(open(p)) if os.path.exists(p) and os.path.getsize(p) else {}
opts = [o for o in cfg.get("exec-opts", []) if not o.startswith("native.cgroupdriver=")]
cfg["exec-opts"] = opts + ["native.cgroupdriver=cgroupfs"]
json.dump(cfg, open(p, "w"), indent=2)
PYEOF
systemctl restart docker 2>/dev/null || true
docker info 2>/dev/null | grep -qi nvidia || log "[warn] docker info shows no nvidia runtime; relying on --gpus (nvidia-container-toolkit)"
IMAGE="{{ docker_image }}@{{ docker_digest }}"
log "[3/9] Pulling ${IMAGE} (~17.6 GB compressed, ~10-20 min)..."
PULL_OK=false
for _try in 1 2 3; do
    if timeout 3600 docker pull "${IMAGE}" >> "${WORK}/logs/docker_pull.log" 2>&1; then PULL_OK=true; break; fi
    log "[warn] docker pull attempt ${_try} failed, retrying in 60s"
    sleep 60
done
[ "${PULL_OK}" = true ] || die "docker pull ${IMAGE} failed (see ${WORK}/logs/docker_pull.log)"
PULLED_DIGEST=$(docker image inspect --format '{{ '{{' }}index .RepoDigests 0{{ '}}' }}' "${IMAGE}" 2>/dev/null || echo unknown)
log "  image: ${PULLED_DIGEST}"
case "${PULLED_DIGEST}" in *"{{ docker_digest }}") ;; *) die "pulled image digest ${PULLED_DIGEST} != pinned {{ docker_digest }}" ;; esac

# ── [4/9] RLinf code at the pinned release commit ───────────────────
log "[4/9] Cloning RLinf @ {{ rlinf_commit[:8] }}..."
if [ ! -d "${RLINF_DIR}/.git" ]; then
    git clone --filter=blob:none {{ rlinf_repo }} "${RLINF_DIR}" >> "${WORK}/logs/clone.log" 2>&1 || die "RLinf clone failed"
fi
git -C "${RLINF_DIR}" checkout -q "{{ rlinf_commit }}" || die "RLinf: checkout {{ rlinf_commit[:8] }} failed"
[ "$(git -C "${RLINF_DIR}" rev-parse HEAD)" = "{{ rlinf_commit }}" ] || die "RLinf HEAD is not the pinned commit"
for f in "examples/embodiment/train_embodied_agent.py" "examples/embodiment/config/{{ train_config }}.yaml" \
         "evaluations/run_eval.sh" "evaluations/libero/{{ eval_config }}.yaml"; do
    [ -f "${RLINF_DIR}/${f}" ] || die "RLinf {{ rlinf_commit[:8] }} has no ${f}"
done
# run_eval.sh must forward extra hydra overrides (model path, env count, checkpoint) to the eval entrypoint.
grep -Eq '"\$\{@:[0-9]+\}"|"\$@"|\$\{@' "${RLINF_DIR}/evaluations/run_eval.sh" \
    || die "evaluations/run_eval.sh does not forward extra arguments; the eval overrides would be ignored"

cat > "${WORK}/rlinf_report.py.b64" << 'REPORTEOF'
{{ report_py_b64 }}REPORTEOF
base64 -d "${WORK}/rlinf_report.py.b64" > "${WORK}/rlinf_report.py" || die "could not write rlinf_report.py"

# ── [5/9] Container + full-chain verify (before any download) ───────
log "[5/9] Starting the RLinf container (shm ${SHM_GB} GB)..."
docker rm -f "${CTR}" >/dev/null 2>&1 || true
# EMBODIED_PATH / REPO_PATH: what examples/embodiment/run_embodiment.sh exports; the train configs resolve
# hydra.searchpath through ${oc.env:EMBODIED_PATH}, so compose fails without it.
docker run -d --name "${CTR}" --gpus all --network host --ipc host --shm-size "${SHM_GB}g" \
    --ulimit nofile=1048576:1048576 --ulimit memlock=-1 \
    -e NVIDIA_DRIVER_CAPABILITIES=all -e MUJOCO_GL=egl -e PYOPENGL_PLATFORM=egl -e ROBOT_PLATFORM=LIBERO \
    -e EMBODIED_PATH=/workspace/RLinf/examples/embodiment -e REPO_PATH=/workspace/RLinf \
    -e PYTHONUNBUFFERED=1 -e PYTHONFAULTHANDLER=1 -e HF_HUB_ENABLE_HF_TRANSFER=0 \
    -e HF_XET_CLIENT_READ_TIMEOUT=60 -e HF_XET_CLIENT_CONNECT_TIMEOUT=30 -e HF_XET_CLIENT_RETRY_MAX_DURATION=120 \
    -v "${RLINF_DIR}:/workspace/RLinf" -v "${WORK}:/workspace/work" \
    "${IMAGE}" sleep infinity >> "${WORK}/logs/docker_run.log" 2>&1 || die "docker run failed (see ${WORK}/logs/docker_run.log)"

# Run a command in the image's {{ switch_env }} venv, from the RLinf checkout. The command travels in an env var
# (no nested quoting) and runs under `timeout` INSIDE the container (killing the docker exec client would leave
# the process running). IN_ENV_TIMEOUT seconds, 0 = none. Stdin is the caller's: pass < /dev/null unless piping
# a script, so a stray input() (LIBERO's first-import prompt) fails instead of hanging.
in_env() {
    docker exec -i -e PYTHONPATH=/workspace/RLinf -e IN_CMD="$1" "${CTR}" \
        timeout --signal=TERM --kill-after=120 "${IN_ENV_TIMEOUT:-0}" bash -c \
        'source switch_env {{ switch_env }} >/dev/null 2>&1 || { echo "switch_env {{ switch_env }} failed"; exit 97; }; cd /workspace/RLinf && eval "${IN_CMD}"'
}

log "[5/9] Pinning {{ sim_protect_pins }} in the {{ switch_env }} venv..."
in_env '(uv pip install --python "$(command -v python)" {{ sim_protect_pins }} || python -m pip install {{ sim_protect_pins }})' \
    < /dev/null >> "${WORK}/logs/pins.log" 2>&1 || die "pin {{ sim_protect_pins }} failed (see ${WORK}/logs/pins.log)"

log "[5/9] Verifying the full chain (imports, mujoco pin, one LIBERO render on GPU)..."
in_env "python -" > "${WORK}/logs/verify.log" 2>&1 << 'VERIFYEOF' || { cat "${WORK}/logs/verify.log" >> "${LOG_FILE}"; die "verify failed (see ${WORK}/logs/verify.log)"; }
import importlib, importlib.util, os, pkgutil, sys
print("python", sys.version.split()[0], "PYTHONUNBUFFERED", os.environ.get("PYTHONUNBUFFERED"),
      "faulthandler", os.environ.get("PYTHONFAULTHANDLER"), "MUJOCO_GL", os.environ.get("MUJOCO_GL"))
import torch
print("torch", torch.__version__, "cuda", torch.version.cuda, "devices", torch.cuda.device_count())
assert torch.cuda.is_available() and torch.cuda.device_count() >= {{ min_gpus }}, "CUDA devices not visible in the image"
torch.zeros(1, device="cuda").add_(1)
import numpy as np
print("numpy", np.__version__)
assert int(np.__version__.split(".")[0]) < 2, "numpy >= 2 in the LIBERO venv (rlinf-libero needs numpy<2)"
import mujoco
want = "{{ mujoco_version }}"
print("mujoco", mujoco.__version__)
assert not want or mujoco.__version__ == want, f"mujoco {mujoco.__version__} != pinned {want}"
# Every module of the train / eval chain, including the lazily imported ones (model + env registries).
for mod in ("flash_attn", "transformers", "peft", "timm", "ray", "hydra", "omegaconf", "tensorboard",
            "robosuite", "bddl", "libero", "libero.libero", "libero.libero.benchmark", "libero.libero.envs",
            "prismatic", "prismatic.extern.hf.modeling_prismatic", "rlinf"):
    m = importlib.import_module(mod)
    print("import OK:", mod, getattr(m, "__version__", ""))
# Walk only the env / model registries: rlinf.workers.rollout.{sglang,vllm} raise ValueError on import when those
# optional LLM rollout backends are absent, and the embodied recipe uses neither.
found = {"libero env": [], "openvla_oft model": []}
names = []
for sub in ("rlinf.envs", "rlinf.models"):
    pkg = importlib.import_module(sub)
    names += [i.name for i in pkgutil.walk_packages(pkg.__path__, sub + ".",
                                                    onerror=lambda n: print("walk skipped (import error):", n))]
for n in names:
    if ".envs." in n and "libero" in n:
        found["libero env"].append(n)
    elif ".models." in n and "openvla_oft" in n:
        found["openvla_oft model"].append(n)
for what, mods in found.items():
    assert mods, f"no rlinf module for {what}"
    for n in mods:
        importlib.import_module(n)
        print("import OK:", n)
# LIBERO's first import asks for a config path on stdin; write the default config if it is missing.
cfg = os.path.expanduser("~/.libero/config.yaml")
from libero.libero import benchmark, get_libero_path
if not os.path.exists(cfg):
    print("[warn] no", cfg)
suite = benchmark.get_benchmark_dict()["{{ task_suite_name }}"]()
print("suite {{ task_suite_name }}:", suite.n_tasks, "tasks")
from libero.libero.envs import OffScreenRenderEnv
task = suite.get_task(0)
env = OffScreenRenderEnv(bddl_file_name=os.path.join(get_libero_path("bddl_files"), task.problem_folder, task.bddl_file),
                         camera_heights=224, camera_widths=224)
env.seed(0)
env.reset()
obs = env.set_init_state(suite.get_task_init_states(0)[0])
img = obs["agentview_image"]
print("render OK:", img.shape, "mean", float(img.mean()))
assert float(img.mean()) > 1.0, "agentview rendered black (EGL / driver graphics capability?)"
env.close()
print("VERIFY OK")
VERIFYEOF
grep -q "VERIFY OK" "${WORK}/logs/verify.log" || die "verify did not finish (see ${WORK}/logs/verify.log)"
log "  verify OK ($(grep -c 'import OK' "${WORK}/logs/verify.log") modules, LIBERO render on GPU)"

SFT_DIR=/workspace/work/ckpt/sft
TRAIN_LOG_DIR=/workspace/work/train
TRAIN_OVERRIDES="runner.logger.log_path=${TRAIN_LOG_DIR} runner.max_steps=${RL_STEPS} runner.save_interval=${RL_SAVE_INTERVAL} actor.model.model_path=${SFT_DIR} rollout.model.model_path=${SFT_DIR}{% for o in overrides %} {{ o }}{% endfor %}"
EVAL_OVERRIDES="env.eval.total_num_envs=${EVAL_NUM_ENVS}{% for o in eval_overrides %} {{ o }}{% endfor %}"
# Hydra compose of the exact training command (no run): a wrong override key fails here, not after the downloads.
log "[5/9] Composing the training config with the run's overrides (hydra --cfg job)..."
in_env "python examples/embodiment/train_embodied_agent.py --config-path /workspace/RLinf/examples/embodiment/config/ --config-name {{ train_config }} ${TRAIN_OVERRIDES} --cfg job" \
    < /dev/null > "${WORK}/logs/train_config.yaml.log" 2>&1 || die "training config does not compose with the overrides (see ${WORK}/logs/train_config.yaml.log)"
aws s3 cp "${WORK}/logs/train_config.yaml.log" "s3://${S3_BUCKET}/${RUN_ID}/rl/train_config.yaml" --region "$REGION" >/dev/null 2>&1 || true

# ── [6/9] SFT checkpoint (pinned revision) ──────────────────────────
log "[6/9] Downloading {{ hf_repo }} @ {{ hf_model_revision[:8] }} (~15 GB)..."
DL_OK=false
for _try in 1 2; do
    if IN_ENV_TIMEOUT=2700 in_env "python -c 'from huggingface_hub import snapshot_download as s; print(s(\"{{ hf_repo }}\", revision=\"{{ hf_model_revision }}\", local_dir=\"${SFT_DIR}\"))'" \
        < /dev/null >> "${WORK}/logs/hf_download.log" 2>&1; then DL_OK=true; break; fi
    log "[warn] checkpoint download attempt ${_try} failed or stalled (45 min cap); retrying (resumes)"
done
[ "${DL_OK}" = true ] || die "SFT checkpoint download failed (see ${WORK}/logs/hf_download.log)"
[ -f "${WORK}/ckpt/sft/config.json" ] || die "SFT checkpoint has no config.json"

COMMON_JSON=$(jq -cn --arg it "${INSTANCE_TYPE}" --arg drv "${DRIVER}" --arg img "${PULLED_DIGEST}" '{
  model: "{{ vla }}", suite: "{{ task_suite_name }}", instance_type: $it, rl_profile: "{{ profile }}",
  eval_config: "{{ eval_config }}", eval_num_envs: {{ eval_num_envs }},
  stack_rlinf_commit: "{{ rlinf_commit }}", stack_image: $img, stack_mujoco: "{{ mujoco_version }}",
  stack_sft: "{{ hf_repo }}@{{ hf_model_revision }}", stack_eval: "{{ eval_config }} n={{ eval_num_envs }}",
  stack_driver: $drv}')

# torch must see the GPU inside the container before each Ray run (RLinf otherwise places workers on
# NO_ACCEL and the driver waits forever).
gpu_check() {
    in_env "python -c 'import torch; assert torch.cuda.is_available(), \"no CUDA in the container\"; print(\"cuda devices\", torch.cuda.device_count())'" \
        < /dev/null >> "${WORK}/logs/gpu_check.log" 2>&1 || die "$1: torch sees no GPU in the container (see ${WORK}/logs/gpu_check.log)"
}

# Ray keeps the driver waiting when a worker dies in its constructor; stop the run instead of idling
# until the timeout. $1 = log file. Run in the background next to the Ray command.
watch_dead_actor() {
    local logf=$1
    while sleep 30; do
        if grep -aq "The actor died because of an error raised in its creation task" "${logf}" 2>/dev/null; then
            log "[warn] a Ray worker died at creation (see ${logf}); stopping the run"
            docker exec "${CTR}" pkill -f "embodied_agent.py" >/dev/null 2>&1 || true
            docker exec "${CTR}" bash -c "ray stop --force" >/dev/null 2>&1 || true
            return 0
        fi
    done
}

# One eval with the shared protocol. $1 = phase (baseline|rl), $2 = task dir, $3 = extra overrides.
run_eval() {
    local phase=$1 task=$2 extra=$3
    local marker="${WORK}/out/${phase}.marker"
    touch "${marker}"
    log "  eval ${phase}: {{ eval_config }} with ${EVAL_NUM_ENVS} envs ${extra}"
    gpu_check "eval ${phase}"
    : > "${WORK}/logs/eval_${phase}.log"
    watch_dead_actor "${WORK}/logs/eval_${phase}.log" &
    local watcher=$!
    set +e
    IN_ENV_TIMEOUT=10800 in_env "ray stop --force >/dev/null 2>&1; bash evaluations/run_eval.sh libero {{ eval_config }} rollout.model.model_path=${SFT_DIR} ${EVAL_OVERRIDES} ${extra}" \
        < /dev/null > "${WORK}/logs/eval_${phase}.log" 2>&1
    local rc=$?
    kill "${watcher}" 2>/dev/null; wait "${watcher}" 2>/dev/null
    set -e
    log "  eval ${phase} exit ${rc}"
    local cond="baseline" ckpt="{{ hf_repo }}@{{ hf_model_revision[:8] }}"
    [ "${phase}" = rl ] && { cond="${RL_CONDITION}"; ckpt="${RL_CKPT_LABEL}"; }
    python3 "${WORK}/rlinf_report.py" phase "${WORK}/out/${phase}.json" --phase "${phase}" \
        --log "${WORK}/logs/eval_${phase}.log" --n "${EVAL_NUM_ENVS}" --checkpoint "${ckpt}" --condition "${cond}" \
        --meta "{\"rl_steps\": ${EVAL_STEP:-0}, \"rl_steps_requested\": ${RL_STEPS}, \"rl_profile\": \"${RL_PROFILE}\", \"eval_num_envs\": ${EVAL_NUM_ENVS}, \"eval_config\": \"{{ eval_config }}\", \"train_config\": \"{{ train_config }}\"}" \
        --common "${COMMON_JSON}" --summary "${WORK}/out/${phase}_summary.txt" 2>&1 | tee -a "${LOG_FILE}" || true
    local prefix="s3://${S3_BUCKET}/${RUN_ID}/${task}"
    aws s3 cp "${WORK}/logs/eval_${phase}.log" "${prefix}/eval.log" --region "$REGION" >/dev/null 2>&1 || true
    [ -f "${WORK}/out/${phase}_summary.txt" ] && aws s3 cp "${WORK}/out/${phase}_summary.txt" "${prefix}/summary.txt" --region "$REGION" >/dev/null
    # Eval videos (RLinf writes them under the eval log dir): the first N of this phase into the gallery.
    local n=0 f
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        aws s3 cp "$f" "${prefix}/videos/${phase}_$(basename "$f")" --region "$REGION" >/dev/null 2>&1 && n=$((n + 1))
        printf 'RLinf %s eval (%s)\nCheckpoint: %s\nSuite: {{ task_suite_name }}\nRun: %s on %s\n' "${phase}" "${cond}" "${ckpt}" "${RUN_ID}" "${INSTANCE_TYPE}" \
            > "${WORK}/out/caption.txt"
        aws s3 cp "${WORK}/out/caption.txt" "${prefix}/videos/${phase}_$(basename "${f%.mp4}").txt" --region "$REGION" >/dev/null 2>&1 || true
        [ "$n" -ge {{ max_videos_per_phase }} ] && break
    done < <(find "${RLINF_DIR}" "${WORK}/train" "${WORK}/eval" -name '*.mp4' -newer "${marker}" 2>/dev/null | sort)
    log "  eval ${phase}: $(jq -r '.success_rate // "unknown"' "${WORK}/out/${phase}.json" 2>/dev/null) success, ${n} videos uploaded"
    [ "${rc}" -eq 0 ] || die "eval ${phase} failed (exit ${rc}, see ${prefix}/eval.log)"
    jq -e '.success_rate != null' "${WORK}/out/${phase}.json" >/dev/null 2>&1 \
        || die "eval ${phase}: no eval/success_once in the log (see ${prefix}/eval.log)"
}

# ── [7/9] (a) Baseline eval of the SFT checkpoint → task-0 ──────────
log "[7/9] (a) Baseline eval of the SFT checkpoint..."
RL_CKPT_LABEL=""
run_eval baseline task-0 ""

if [ "${EARLY_SIGNAL}" = true ]; then
    log "[7/9] early signal: the stack completes now; training continues (cap ${MAX_WALL_HOURS} h, then self-terminate)"
    cfn_signal 0
    EARLY_SIGNALED=true
fi

# ── [8/9] (b) GRPO training (or the RL checkpoint of an earlier run) ─
if [ -z "${EVAL_RUN}" ]; then
    ELAPSED=$(( $(date +%s) - START_EPOCH ))
    TRAIN_CAP=$(( MAX_WALL_HOURS * 3600 - ELAPSED - 5400 ))   # keep 1.5 h for the RL eval + uploads
    [ "${TRAIN_CAP}" -gt 600 ] || die "no wall-clock left for training (${ELAPSED}s used of ${MAX_WALL_HOURS} h)"
    log "[8/9] (b) GRPO training: {{ train_config }}, ${RL_STEPS} steps, save every ${RL_SAVE_INTERVAL}, cap ${TRAIN_CAP}s..."
    gpu_check "training"
    : > "${WORK}/logs/train.log"
    watch_dead_actor "${WORK}/logs/train.log" &
    TRAIN_WATCHER=$!
    set +e
    IN_ENV_TIMEOUT="${TRAIN_CAP}" in_env "ray stop --force >/dev/null 2>&1; python examples/embodiment/train_embodied_agent.py --config-path /workspace/RLinf/examples/embodiment/config/ --config-name {{ train_config }} ${TRAIN_OVERRIDES}" \
        < /dev/null > "${WORK}/logs/train.log" 2>&1
    TRAIN_RC=$?
    kill "${TRAIN_WATCHER}" 2>/dev/null; wait "${TRAIN_WATCHER}" 2>/dev/null
    set -e
    log "  training exit ${TRAIN_RC} (124 = wall-clock cap; the latest saved step is evaluated)"
    in_env "ray stop --force" < /dev/null >/dev/null 2>&1 || true
    aws s3 cp "${WORK}/logs/train.log" "s3://${S3_BUCKET}/${RUN_ID}/rl/train.log" --region "$REGION" >/dev/null 2>&1 || true
    # Training curve (TensorBoard scalars -> csv/json) + the raw event files.
    in_env "python /workspace/work/rlinf_report.py curve ${TRAIN_LOG_DIR} /workspace/work/out/training_curve" \
        < /dev/null 2>&1 | tee -a "${LOG_FILE}" || log "[warn] no training curve (no TensorBoard scalars?)"
    for f in training_curve.csv training_curve.json; do
        [ -f "${WORK}/out/$f" ] && aws s3 cp "${WORK}/out/$f" "s3://${S3_BUCKET}/${RUN_ID}/rl/$f" --region "$REGION" >/dev/null 2>&1 || true
    done
    aws s3 cp --recursive "${WORK}/train" "s3://${S3_BUCKET}/${RUN_ID}/rl/tensorboard/" --exclude '*' --include '*events.out.tfevents*' \
        --region "$REGION" >/dev/null 2>&1 || true
    STEP_DIR=$(find "${WORK}/train" -type d -name 'global_step_*' 2>/dev/null | sort -t_ -k3 -n | tail -1 || true)
    [ -n "${STEP_DIR}" ] || die "training saved no checkpoint (exit ${TRAIN_RC}, see s3://${S3_BUCKET}/${RUN_ID}/rl/train.log)"
    STEP_NAME=$(basename "${STEP_DIR}")
    log "  checkpoint ${STEP_NAME} ($(du -sh "${STEP_DIR}" | cut -f1)) -> s3://${S3_BUCKET}/${RUN_ID}/rl/checkpoints/${STEP_NAME}/"
    aws s3 cp --recursive "${STEP_DIR}" "s3://${S3_BUCKET}/${RUN_ID}/rl/checkpoints/${STEP_NAME}/" --region "$REGION" \
        --only-show-errors || die "checkpoint upload failed"
    jq -n --arg run "${RUN_ID}" --arg step "${STEP_NAME}" --arg sft "{{ hf_repo }}@{{ hf_model_revision }}" --argjson rc "${TRAIN_RC}" \
        '{run_id: $run, step: $step, prefix: ("rl/checkpoints/" + $step + "/"), sft: $sft, train_exit: $rc, profile: "{{ profile }}", rlinf_commit: "{{ rlinf_commit }}"}' \
        > "${WORK}/out/checkpoint.json"
    aws s3 cp "${WORK}/out/checkpoint.json" "s3://${S3_BUCKET}/${RUN_ID}/rl/checkpoint.json" --region "$REGION" >/dev/null
    RL_CKPT_LABEL="s3://${S3_BUCKET}/${RUN_ID}/rl/checkpoints/${STEP_NAME}"
    [ "${TRAIN_RC}" -eq 0 ] || [ "${TRAIN_RC}" -eq 124 ] || die "training failed (exit ${TRAIN_RC}); checkpoint ${STEP_NAME} kept in S3"
else
    log "[8/9] (b) skipped: evaluating the RL checkpoint of run ${EVAL_RUN}"
    aws s3 cp "s3://${S3_BUCKET}/${EVAL_RUN}/rl/checkpoint.json" "${WORK}/out/checkpoint.json" --region "$REGION" >/dev/null \
        || die "run ${EVAL_RUN} has no rl/checkpoint.json in this stack's bucket"
    PREFIX=$(jq -r .prefix "${WORK}/out/checkpoint.json")
    STEP_NAME=$(jq -r .step "${WORK}/out/checkpoint.json")
    STEP_DIR="${WORK}/train/restored/${STEP_NAME}"
    # The eval overrides depend on the profile (smoke = LoRA weights), so the checkpoint must come from the same one.
    CKPT_PROFILE=$(jq -r .profile "${WORK}/out/checkpoint.json")
    [ "${CKPT_PROFILE}" = "${RL_PROFILE}" ] \
        || die "run ${EVAL_RUN} trained with --rl-profile ${CKPT_PROFILE}; redeploy with --rl-profile ${CKPT_PROFILE} --rl-eval-run ${EVAL_RUN}"
    # Only the consolidated weights the eval loads (model_state_dict/full_weights.pt), not the DCP training shards
    # with optimizer state (several times larger; they are kept in S3 for resuming training).
    aws s3 cp --recursive "s3://${S3_BUCKET}/${EVAL_RUN}/${PREFIX}" "${STEP_DIR}/" --region "$REGION" --only-show-errors \
        --exclude '*' --include '*model_state_dict/*' \
        || die "download of s3://${S3_BUCKET}/${EVAL_RUN}/${PREFIX} failed"
    RL_CKPT_LABEL="s3://${S3_BUCKET}/${EVAL_RUN}/${PREFIX%/}"
fi
# Label the RL row with the step actually evaluated: the wall-clock cap or --rl-eval-run can make it differ from
# the requested ${RL_STEPS} (RLinf saves checkpoints/global_step_<N>).
EVAL_STEP="${STEP_NAME#global_step_}"
case "${EVAL_STEP}" in ''|*[!0-9]*) die "unexpected checkpoint name ${STEP_NAME}" ;; esac
RL_CONDITION="rl-grpo-${EVAL_STEP}steps"
[ "${EVAL_STEP}" = "${RL_STEPS}" ] || log "  evaluating step ${EVAL_STEP} (requested ${RL_STEPS}); condition ${RL_CONDITION}"
# The eval loads the SFT model dir and overlays the trained weights (runner.ckpt_path, RLinf docs guides/resume).
FULL_W=$(find "${STEP_DIR}" -name 'full_weights.pt' 2>/dev/null | head -1 || true)
[ -n "${FULL_W}" ] || die "no full_weights.pt under ${STEP_NAME} (RLinf saved only DCP shards; see the checkpoint in S3)"
FULL_W_CTR="/workspace/work/${FULL_W#"${WORK}"/}"

# ── [9/9] (c) RL eval with the same protocol → task-1, (d) report ───
log "[9/9] (c) Eval of the RL checkpoint (${STEP_NAME})..."
run_eval rl task-1 "runner.ckpt_path=${FULL_W_CTR}"

python3 "${WORK}/rlinf_report.py" report "${WORK}/out/baseline.json" "${WORK}/out/rl.json" "${WORK}/out" \
    --meta "{\"target\": \"{{ vla }}\", \"run_id\": \"${RUN_ID}\", \"suite\": \"{{ task_suite_name }}\", \"rl_profile\": \"${RL_PROFILE}\", \"rl_steps\": ${EVAL_STEP}, \"rl_steps_requested\": ${RL_STEPS}, \"instance_type\": \"${INSTANCE_TYPE}\", \"gpus\": ${GPU_COUNT}, \"published_sft\": {{ published_sft }}, \"published_rl\": {{ published_rl }}, \"run_wall_s\": $(( $(date +%s) - START_EPOCH ))}" \
    > "${WORK}/out/report.txt" 2>&1 || die "report failed"
cat "${WORK}/out/report.txt" | tee -a "${LOG_FILE}"
for f in results.json summary.txt; do
    aws s3 cp "${WORK}/out/$f" "s3://${S3_BUCKET}/${RUN_ID}/$f" --region "$REGION" >/dev/null
done
upload_log

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] RLinf evaluate -> RL -> re-evaluate complete (RUN_ID: ${RUN_ID})
$(cat "${WORK}/out/summary.txt")

Policy: OpenVLA-OFT-7B, RLinf GRPO ({{ train_config }}), profile ${RL_PROFILE}
Simulation: LIBERO ({{ task_suite_name }}, MuJoCo {{ mujoco_version }}, headless EGL)
Instance: ${INSTANCE_TYPE} (${GPU_COUNT} GPU)
RL checkpoint: ${RL_CKPT_LABEL}/ (re-evaluate: python deploy.py --vla {{ vla }} --rl-eval-run ${RUN_ID})

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION} --exclude 'rl/checkpoints/*'

Teardown:
  python destroy.py --vla {{ vla }}"
aws sns publish --topic-arn "$SNS_TOPIC_ARN" --subject "RLinf run complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" --region "$REGION" || log "[warn] SNS notification failed (continuing)"

[ "${EARLY_SIGNALED}" = true ] || cfn_signal 0
docker rm -f "${CTR}" >/dev/null 2>&1 || true
if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    self_terminate
fi
log "===== RLinf UserData complete ====="

#!/bin/bash
# {{ display_name }} 1-Click UserData Script (LIBERO sim, local in-process lerobot-eval)
# Shared template for every policy that upstream LeRobot ships (policy.type resolved from the checkpoint).
# Model:      {{ hf_repo }} (rev {{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }}) — {{ license }}
# LeRobot:    {{ lerobot_repo }} @ {{ lerobot_commit[:8] if lerobot_commit else 'HEAD' }} (uv sync --locked{% for e in uv_extras %} --extra {{ e }}{% endfor %})
# Pattern:    SINGLE process — lerobot-eval loads the policy in-process on the sim GPU.
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName}       — results S3 bucket
#   ${SnsTopicArn}        — completion notification SNS topic
#   ${StackName}          — CDK stack name
#   ${WaitConditionUrl}   — CFN WaitConditionHandle presigned URL
#   ${Region}             — deployment region
#   ${AutoTerminate}      — "true" to auto-terminate EC2 after completion

set -euo pipefail

LEROBOT_DIR=/home/ubuntu/lerobot
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
EVAL_BASE_DIR=/tmp/{{ vla }}-eval
VIDEO_BASE_DIR=/tmp/{{ vla }}-videos
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

# UserData runs as root; HOME must be set so uv puts caches in a stable place.
export HOME=/root
export HF_HOME="${HF_CACHE_DIR}"
# uv installs into ~/.local/bin
export PATH="/root/.local/bin:${PATH}"

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a /var/log/{{ vla }}-userdata.log; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/{{ vla }}-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

die() {
    log "ERROR: $*"
    # Best-effort: dump diagnostics to S3 before CFN rollback eats the instance
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ]; then
        local _diag_prefix="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag-fail"
        log "  Uploading /tmp/{{ vla }}_*.log to ${_diag_prefix}..."
        aws s3 cp /var/log/{{ vla }}-userdata.log "${_diag_prefix}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ vla }}_*.log; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag_prefix}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
    fi
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/7] System dependencies ──────────────────────────────────────
log "[1/7] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive

systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
pkill -9 -f "apt-get" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a 2>&1 | tee /tmp/{{ vla }}_dpkg_fix.log || true

# Boot hardening (2026-10): the command-not-found apt hook hung apt-get update for 3 h on a g6e, and the
# apt-daily timers re-launch unattended-upgrades mid-boot (held the dpkg lock past 5 min). Drop / mask both.
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 2>&1 | tee /tmp/{{ vla }}_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    log "[warn] apt-get update failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    git git-lfs curl ca-certificates awscli jq \
    libgl1-mesa-glx libegl1 libgles2 \
    libglib2.0-0 libsm6 libxext6 libxrender1 \
    ffmpeg build-essential \
    2>&1 | tee /tmp/{{ vla }}_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    log "[warn] apt-get install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# ── [1.5/7] CloudWatch Logs agent setup ──────────────────────────
log "[1.5/7] Setting up CloudWatch Logs agent..."
# Log group MUST match the stack's IAM grant (/${vla}/* → /{{ vla }}/*).
CW_LOG_GROUP="/{{ vla }}/userdata"
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s 2>&1 | tee /tmp/{{ vla }}_cwagent.log \
        && log "  CW agent started (log group: ${CW_LOG_GROUP})" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi

# ── [2/7] NVIDIA driver check + fp32 VRAM floor guard ───────────────
log "[2/7] Checking GPU driver..."
nvidia-smi -L 2>&1 | tee /tmp/{{ vla }}_nvidia.log \
    || log "[warn] nvidia-smi failed — verify DLAMI (continuing with EGL headless)"
# Fail-fast VRAM / host-RAM floors (models/{{ vla }}.yaml: min_gpu_mib / min_host_mib). Without them an
# undersized instance silently burns the full creationpolicy_timeout before the WaitCondition times out.
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || echo "0")
log "  GPU0 memory: ${GPU_MEM_MIB} MiB"
if [ "${GPU_MEM_MIB:-0}" -lt {{ min_gpu_mib }} ]; then
    die "{{ display_name }} needs a single GPU >= {{ min_gpu_mib }} MiB; GPU0 has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
log "  Host RAM: ${HOST_MEM_MIB} MiB"
if [ "${HOST_MEM_MIB:-0}" -lt {{ min_host_mib }} ]; then
    die "{{ display_name }} needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi

# ── [3/7] uv install + LeRobot clone (pinned) ──────────────────
log "[3/7] Installing uv (DLAMI does not pre-install)..."
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh 2>&1 | tee /tmp/{{ vla }}_uv_install.log \
        || die "uv install failed"
fi
log "  $(uv --version)"

log "[3/7] Cloning {{ lerobot_repo }} @ {{ lerobot_commit[:8] if lerobot_commit else 'HEAD' }}..."
if [ ! -d "${LEROBOT_DIR}" ]; then
    git clone {{ lerobot_repo }} "${LEROBOT_DIR}" \
        2>&1 | tee /tmp/{{ vla }}_clone.log \
        || die "lerobot clone failed"
{%- if lerobot_commit %}
    git -C "${LEROBOT_DIR}" checkout "{{ lerobot_commit }}" \
        || die "lerobot: checkout pinned commit {{ lerobot_commit[:8] }} failed"
{%- endif %}
fi
ACTUAL_COMMIT=$(git -C "${LEROBOT_DIR}" rev-parse HEAD)
log "  lerobot commit: ${ACTUAL_COMMIT}"
{%- if lerobot_commit %}
if [ "${ACTUAL_COMMIT}" != "{{ lerobot_commit }}" ]; then
    die "lerobot commit mismatch: expected {{ lerobot_commit }}, got ${ACTUAL_COMMIT}"
fi
{%- endif %}

# ── [4/7] uv sync (source install from the pinned uv.lock) — policy + libero env extras ──
# --python {{ python_version }}: LeRobot requires >=3.12; without the pin uv may pick 3.14, whose argparse
# rejects draccus' `type=str | None` (lerobot-eval CLI parse crash). ~15-30min on a fresh instance.
log "[4/7] uv sync --locked --python {{ python_version }}{% for e in uv_extras %} --extra {{ e }}{% endfor %} (~15-30min)..."
cd "${LEROBOT_DIR}"
uv sync --locked --python {{ python_version }}{% for e in uv_extras %} --extra {{ e }}{% endfor %} 2>&1 | tee /tmp/{{ vla }}_uv_sync.log \
    || die "uv sync failed (see /tmp/{{ vla }}_uv_sync.log)"
# Confirm the venv interpreter is the pinned version (fail fast if uv ignored --python).
VENV_PY=$(uv run --active python -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)
log "  venv python: ${VENV_PY}"
if [ "${VENV_PY}" != "{{ python_version }}" ]; then
    die "venv python ${VENV_PY} != pinned {{ python_version }} (uv ignored --python)"
fi

# LIBERO seeds a config on first import via input() → seed it non-interactively FIRST.
# libero/libero/__init__.py prompts (and EOFErrors headless) only when ~/.libero/config.yaml
# is absent; answering 'N' writes the config with default paths, so every later import
# (the venv check below AND the [6/7] lerobot-eval subprocess) skips the prompt. HOME=/root
# is exported once at top, so the config persists across all uv-run invocations.
# MUST precede any `from lerobot.envs.libero import ...` (that import transitively hits the prompt).
log "[4/7] Seeding LIBERO config (suppress first-import interactive prompt)..."
uv run --active python -c "
import builtins
builtins.input = lambda *a, **k: 'N'
from libero.libero import benchmark, get_libero_path
benchmark.get_benchmark_dict()
import os
cfg = os.path.expanduser('~/.libero/config.yaml')
assert os.path.exists(cfg), 'LIBERO config not written: ' + cfg
print('LIBERO config seeded at', cfg)
" 2>&1 | tee /tmp/{{ vla }}_libero_seed.log \
    || die "LIBERO config seed failed (see /tmp/{{ vla }}_libero_seed.log)"

# Verify the venv: lerobot-eval entrypoint + policy module import + torch sees the GPU,
# BEFORE downloading the checkpoint. Fail fast on a broken install.
# LiberoEnv import now resolves silently (config seeded above).
log "[4/7] Verifying venv (lerobot-eval entrypoint, policy import, torch CUDA)..."
uv run --active python -c "
import torch
print('torch:', torch.__version__, 'cuda available:', torch.cuda.is_available())
assert torch.cuda.is_available(), 'CUDA not visible to torch'
import importlib
importlib.import_module('lerobot.policies.{{ policy_module }}')
print('policy module OK: lerobot.policies.{{ policy_module }}')
from lerobot.envs.libero import LiberoEnv  # libero extra installed
print('LiberoEnv import OK')
" 2>&1 | tee /tmp/{{ vla }}_import_check.log \
    || die "venv import/CUDA check failed (see /tmp/{{ vla }}_import_check.log)"
# The lerobot-eval console script must resolve in the venv.
uv run --active which lerobot-eval 2>&1 | tee -a /tmp/{{ vla }}_import_check.log \
    || die "lerobot-eval entrypoint not found in venv"

# ── [5/7] Pre-download the checkpoint ──
# ── XET STALL GUARD: bound stalled Xet downloads in [5/7] ────────────────────────
# LeRobot checkpoints on the Hub are Xet-backed.
# Xet-backed blobs are fetched by the hf_xet Rust client rather than huggingface_hub's
# python http_get, so HF_HUB_DOWNLOAD_TIMEOUT does NOT apply to them; only the
# HF_XET_CLIENT_* knobs below do.
#
# The LeRobot uv.lock may pin an hf-xet older than 1.5.2.
# The defect: ExponentialBackoff::from_millis(self.base_delay) uses base_delay as both the
# first delay and the per-step multiplier, so delays run 3s -> 9000s (2.5h) -> 7500h, and the
# first retry after a stalled socket is indistinguishable from a permanent hang. 1.5.0 is NOT
# clear of this — the fix first lands in 1.5.2 (1.5.0 and 1.5.1 both still carry the same
# line; checked against upstream source at each tag). 1.5.2 also raises the default
# read_timeout 120s -> 300s. All four names below exist in the 1.4.x and 1.5.x binaries, so
# this block is not a no-op, but on the buggy versions RETRY_MAX_DURATION is dead config
# (parsed, never consulted) — shortening the retry sleep needs the bump below.
export HF_XET_CLIENT_READ_TIMEOUT=60
export HF_XET_CLIENT_CONNECT_TIMEOUT=30
export HF_XET_CLIENT_RETRY_MAX_DURATION=120
export HF_XET_FIXED_DOWNLOAD_CONCURRENCY=8

# XET STALL GUARD (cont.): raise hf-xet past the backoff defect before anything downloads.
# hf-xet is a transitive dep of huggingface_hub, not a direct one, so it cannot be held by
# the project's own pins — install it into the venv directly.
# `uv run --active` re-syncs from the lockfile on every invocation, so a plain
# `uv pip install` is silently REVERTED by the next synced call. The downloads below
# therefore pass --no-sync, and this block sits after the last synced `uv run --active`
# (the [4.5/7] import check) and before the fetches. Inserting a synced --active call
# between here and the downloads would undo the bump with no error shown.
log "[5/7] XET STALL GUARD: raising hf-xet to >= 1.5.2 if the lockfile pins older..."
uv pip install --python "${LEROBOT_DIR}/.venv/bin/python" "hf-xet>=1.5.2" \
    >> /tmp/{{ vla }}_hfxet_bump.log 2>&1 \
    || die "hf-xet upgrade failed (see /tmp/{{ vla }}_hfxet_bump.log)"
"${LEROBOT_DIR}/.venv/bin/python" -c "
from huggingface_hub.utils._runtime import get_xet_version, is_xet_available
v = get_xet_version()
print('hf_xet:', v, 'xet path active:', is_xet_available())
assert tuple(int(x) for x in v.split('.')[:3]) >= (1, 5, 2), f'hf_xet not upgraded: {v}'
" >> /tmp/{{ vla }}_hfxet_bump.log 2>&1 \
    || die "hf-xet still below 1.5.2 after upgrade (see /tmp/{{ vla }}_hfxet_bump.log)"

# Wall-clock guard. A wedged Xet download emits nothing and returns nothing, so `|| die`
# can never fire; without `timeout` the instance burns GPU until the CreationPolicy expires
# (measured on a sibling target: 26+ min of zero cache growth, every CDN socket in
# CLOSE-WAIT, all worker threads in futex_wait). Retry once — a dead CDN connection
# recovers in a fresh process and snapshot_download resumes from the partial cache.
#
# Guard chatter goes to the log file only, NEVER stdout: sibling call sites capture the
# resolved snapshot path via VAR=$(... | tail -1), so a warning on stdout would be captured
# as the path. Callers piping a heredoc must pass --stdin, because the first attempt
# consumes stdin and a naive retry re-runs python with EMPTY input and exits 0 — reporting
# success having downloaded nothing (measured). Auto-detecting stdin via `[ ! -t 0 ]` is
# wrong: inside $( ) stdin is not a tty even with no heredoc, so the guard would block on
# `cat` forever. Hence the explicit flag.
HF_DOWNLOAD_TIMEOUT_SECS=2700
hf_dl_guard() {
    local _label="$1" _log="$2"; shift 2
    local _stdin=""
    if [ "${1:-}" = "--stdin" ]; then _stdin="$(mktemp)"; cat > "${_stdin}"; shift; fi
    [ "${1:-}" = "--" ] && shift
    local _attempt _rc
    for _attempt in 1 2; do
        _rc=0
        if [ -n "${_stdin}" ]; then
            timeout --signal=TERM --kill-after=60 "${HF_DOWNLOAD_TIMEOUT_SECS}" "$@" < "${_stdin}" || _rc=$?
        else
            timeout --signal=TERM --kill-after=60 "${HF_DOWNLOAD_TIMEOUT_SECS}" "$@" < /dev/null || _rc=$?
        fi
        if [ "${_rc}" -eq 0 ]; then [ -n "${_stdin}" ] && rm -f "${_stdin}"; return 0; fi
        { echo "[hf-dl] ${_label} attempt ${_attempt} rc=${_rc} (wall-clock cap ${HF_DOWNLOAD_TIMEOUT_SECS}s)"
          [ "${_attempt}" -eq 1 ] && echo "[hf-dl] retrying ${_label} (resumes from the partial HF cache)"
        } >> "${_log}" 2>/dev/null || true
    done
    [ -n "${_stdin}" ] && rm -f "${_stdin}"
    return 1
}

mkdir -p "${HF_CACHE_DIR}"
{% if hf_model_revision %}
log "[5/7] Pre-downloading {{ hf_repo }} (rev {{ hf_model_revision[:8] }})..."
hf_dl_guard "checkpoint download" /tmp/{{ vla }}_hf_download.log \
    -- uv run --active --no-sync python -c "
from huggingface_hub import snapshot_download
path = snapshot_download('{{ hf_repo }}', revision='{{ hf_model_revision }}')
print('checkpoint downloaded to:', path)
" || die "HF checkpoint download failed (see /tmp/{{ vla }}_hf_download.log)"
{% else %}
log "[5/7] HF revision not pinned — lerobot-eval will download {{ hf_repo }} on demand..."
hf_dl_guard "checkpoint download" /tmp/{{ vla }}_hf_download.log \
    -- uv run --active --no-sync python -c "
from huggingface_hub import snapshot_download
path = snapshot_download('{{ hf_repo }}')
print('checkpoint downloaded to:', path)
" || die "HF checkpoint download failed (see /tmp/{{ vla }}_hf_download.log)"
{% endif %}

# ── [6/7] Run LIBERO eval per task entry (in-process lerobot-eval) ──
# Headless MuJoCo render needs EGL.
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
mkdir -p "${EVAL_BASE_DIR}" "${VIDEO_BASE_DIR}"

TASKS_JSON='{{ tasks_json }}'
TASK_COUNT=$(echo "$TASKS_JSON" | jq length)
SUMMARY_ALL=""

for TASK_IDX in $(seq 0 $((TASK_COUNT - 1))); do
    TASK=$(echo "$TASKS_JSON" | jq -r ".[$TASK_IDX]")
    SUITE=$(echo "$TASK" | jq -r '.suite')
    N_EPISODES=$(echo "$TASK" | jq -r '.n_episodes')
    SEED=$(echo "$TASK" | jq -r '.seed // 1000')
    DESCRIPTION=$(echo "$TASK" | jq -r '.description // ""')
    # task_ids: optional JSON array restricting which suite tasks to run (pipe-proof cap).
    # Empty/absent → omit the flag → lerobot-eval runs ALL tasks in the suite.
    TASK_IDS_ARR=$(echo "$TASK" | jq -c '.task_ids // empty')

    OUT_DIR="${EVAL_BASE_DIR}/task-${TASK_IDX}"
    rm -rf "${OUT_DIR}"
    mkdir -p "${OUT_DIR}"

    log "[6/7] Task $((TASK_IDX+1))/${TASK_COUNT}: suite=${SUITE}, n_episodes=${N_EPISODES}/task, task_ids=${TASK_IDS_ARR:-ALL}"
    touch /tmp/{{ vla }}_task${TASK_IDX}_start.marker

    # lerobot-eval: policy.path = HF repo id (policy.type comes from its config.json) + per-model
    # --policy.* / --env.* extras from models/{{ vla }}.yaml. --eval.n_episodes is PER TASK.
    EVAL_ARGS=(
        --policy.path={{ hf_repo }}
        --policy.device=cuda
{%- for a in policy_args %}
        '{{ a }}'
{%- endfor %}
        --env.type=libero
        --env.task="${SUITE}"
{%- for a in env_args %}
        '{{ a }}'
{%- endfor %}
        --eval.batch_size=1
        --eval.n_episodes="${N_EPISODES}"
        --output_dir="${OUT_DIR}"
        --seed="${SEED}"
    )
    if [ -n "${TASK_IDS_ARR}" ]; then
        EVAL_ARGS+=( --env.task_ids="${TASK_IDS_ARR}" )
    fi
    # AMLC stack study (2026-10-15): per-task overrides appended LAST (draccus/argparse: last flag wins)
    COND=$(echo "$TASK" | jq -r '.condition // "S0"')
    mapfile -t EXTRA_ARGS < <(echo "$TASK" | jq -r '.extra_args // [] | .[]')
    for XA in "${EXTRA_ARGS[@]}"; do
        XK="${XA%%=*}"; KEEP=()
        for EA in "${EVAL_ARGS[@]}"; do [ "${EA%%=*}" = "${XK}" ] || KEEP+=( "${EA}" ); done
        EVAL_ARGS=( "${KEEP[@]}" "${XA}" )
        [ "${XK}" = "--eval.n_episodes" ] && N_EPISODES="${XA#*=}"   # keep the summary's per-task count truthful
    done
    log "  condition=${COND} extra_args=${EXTRA_ARGS[*]:-none}"

    log "  Checkpoint: {{ hf_repo }} (rev {{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }})"

    # Disable BOTH errexit AND the ERR trap around the eval: a non-zero exit must NOT auto-fire
    # cfn_signal here — capture EVAL_EXIT and fail explicitly via die() below, AFTER S3 diag upload.
    set +e
    trap - ERR
    (
        cd "${LEROBOT_DIR}"
        uv run --active lerobot-eval "${EVAL_ARGS[@]}"
    ) 2>&1 | tee "/tmp/{{ vla }}_task${TASK_IDX}.log"
    EVAL_EXIT=${PIPESTATUS[0]}
    set -e
    trap '_trap_handler' ERR
    if [ "${EVAL_EXIT}" -ne 0 ]; then
        log "  [error] Task ${TASK_IDX} eval exit=${EVAL_EXIT} — will fail after uploading diagnostics"
    fi

    # lerobot-eval writes ${OUT_DIR}/videos/{suite}_{task_id}/eval_episode_N.mp4 and eval_info.json.
    # Collect every mp4 into a flat per-task video dir for upload.
    VIDEO_DIR="${VIDEO_BASE_DIR}/task-${TASK_IDX}"
    mkdir -p "$VIDEO_DIR"
    find "${OUT_DIR}/videos" -name "*.mp4" -newer /tmp/{{ vla }}_task${TASK_IDX}_start.marker \
        -exec cp {} "${VIDEO_DIR}/" \; 2>/dev/null || true
    VIDEO_COUNT=$(find "${VIDEO_DIR}" -name "*.mp4" 2>/dev/null | wc -l)
    log "  Videos collected: ${VIDEO_COUNT}"

    # Parse success rate from eval_info.json (info["overall"]["pc_success"], 0-100).
    SR="unknown"
    INFO_JSON="${OUT_DIR}/eval_info.json"
    if [ -f "${INFO_JSON}" ]; then
        SR=$(jq -r '.overall.pc_success // empty' "${INFO_JSON}" 2>/dev/null || echo "")
        [ -n "${SR}" ] && SR=$(awk -v p="${SR}" 'BEGIN{printf "%.3f", p/100}') || SR="unknown"
    fi
    log "  success_rate=${SR} (pc_success/100)"

    {
        echo "model: {{ vla }}"
        echo "checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }}"
        echo "lerobot: {{ lerobot_repo }}@{{ lerobot_commit[:8] if lerobot_commit else 'HEAD' }}"
        echo "suite: ${SUITE}"
        echo "task_ids: ${TASK_IDS_ARR:-ALL}"
        echo "n_episodes_per_task: ${N_EPISODES}"
        echo "success_rate: ${SR}"
        echo "n_success: $(jq -r '.overall.n_success // empty' "${INFO_JSON}" 2>/dev/null)"
        echo "n_episodes: $(jq -r '.overall.n_episodes // empty' "${INFO_JSON}" 2>/dev/null)"
        echo "condition: ${COND}"
        echo "extra_args: ${EXTRA_ARGS[*]:-none}"
        # Stack fingerprint: a success rate is only comparable with the stack that produced it
        # ("Same Policy, Different Numbers", AMLC 2026 workshop) — record what the episode loop ran on.
        echo "stack_lerobot_commit: ${ACTUAL_COMMIT}"
        echo "stack_mujoco: $("${LEROBOT_DIR}/.venv/bin/python" -c 'import mujoco; print(mujoco.__version__)' 2>/dev/null || echo unknown)"
        echo "stack_eval_args: ${EVAL_ARGS[*]}"
        echo "description: ${DESCRIPTION}"
    } > "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt"

    # S3 upload (videos + per-video context + eval_info.json + log + summary)
    S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}"
    log "  S3 upload: ${S3_TASK_PREFIX}"
    UPLOAD_COUNT=0
    while IFS= read -r mp4_file || [[ -n "$mp4_file" ]]; do
        [ -f "$mp4_file" ] || continue
        fname=$(basename "$mp4_file")
        base="${fname%.mp4}"

        txt_file="/tmp/{{ vla }}_ctx_task${TASK_IDX}_ep${UPLOAD_COUNT}.txt"
        {
            echo "=== {{ display_name }} Simulation Context ==="
            printf "Video:      %s\n"  "${fname}"
            printf "Date:       %s\n"  "$(date '+%Y-%m-%d')"
            echo ""
            echo "--- Environment ---"
            printf "Suite:      %s\n"  "${SUITE}"
            printf "Robot:      Franka Panda 7-DOF (LIBERO)\n"
            echo ""
            echo "--- Model ---"
            printf "Checkpoint: %s (rev %s)\n" "{{ hf_repo }}" "{{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }}"
            printf "LeRobot:    %s@%s\n" "{{ lerobot_repo }}" "{{ lerobot_commit[:8] if lerobot_commit else 'HEAD' }}"
            printf "Policy:     %s\n" "{{ policy_desc }}"
            printf "License:    %s\n" "{{ license }}"
            echo ""
            echo "--- Rollout ---"
            printf "run_id:        %s\n"  "${RUN_ID}"
            printf "task_idx:      %s\n"  "${TASK_IDX}"
            printf "suite_success: %s (suite avg, pc_success/100)\n" "${SR}"
            echo ""
            echo "--- Infrastructure ---"
            printf "Instance: %s (%s)\n"  "${INSTANCE_ID}" "${INSTANCE_TYPE}"
            printf "Region:   %s\n"  "${REGION}"
            printf "Stack:    %s (CDK)\n" "${STACK_NAME}"
        } > "$txt_file"

        if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" \
            --region "$REGION" 2>&1 | tee -a /var/log/{{ vla }}-userdata.log; then
            UPLOAD_COUNT=$((UPLOAD_COUNT+1))
            aws s3 cp "$txt_file" "${S3_TASK_PREFIX}/videos/${base}.txt" \
                --region "$REGION" 2>/dev/null || true
        else
            log "  [warn] Upload failed: $fname"
        fi
    done < <(find "$VIDEO_DIR" -name "*.mp4" 2>/dev/null | sort)
    log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"

    aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}.log" \
        "${S3_TASK_PREFIX}/eval.log" --region "$REGION" || true
    [ -f "${INFO_JSON}" ] && \
        aws s3 cp "${INFO_JSON}" \
        "${S3_TASK_PREFIX}/eval_info.json" --region "$REGION" || true
    [ -f "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" ] && \
        aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" \
        "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true

    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${SUITE} — success_rate=${SR} (${N_EPISODES} ep/task, task_ids=${TASK_IDS_ARR:-ALL})"
    log "  Task $((TASK_IDX+1)) done"

    # Hard-fail after S3 upload if eval crashed or produced no rollouts.
    if [ "${EVAL_EXIT}" -ne 0 ]; then
        die "Task ${TASK_IDX} eval failed (exit=${EVAL_EXIT}) — see s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}/eval.log"
    fi
    if [ "${VIDEO_COUNT}" -eq 0 ]; then
        die "Task ${TASK_IDX} produced 0 rollouts — eval likely short-circuited (see s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}/eval.log)"
    fi
done

# ── [7/7] SNS notification + cfn-signal ──────────────────────────
log "[7/7] Sending SNS notification..."

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} simulation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}

Model: {{ policy_desc }}
Checkpoint: {{ hf_repo }} (rev {{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }})
LeRobot: {{ lerobot_repo }}@{{ lerobot_commit[:8] if lerobot_commit else 'HEAD' }}
License: {{ license }}
Simulation: LIBERO (robosuite + MuJoCo, headless EGL)
Instance: ${INSTANCE_TYPE}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} simulation complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[7/7] Sending cfn-signal..."
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

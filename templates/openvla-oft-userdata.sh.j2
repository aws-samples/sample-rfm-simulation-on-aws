# Stack knobs (per-task fields in models/<id>.yaml; absent = upstream default). A success rate is only
# comparable with the stack that produced it ("Same Policy, Different Numbers", AMLC 2026 workshop).
# stackpatch.py restores the eval script from its .stackorig copy before every task, then applies
# step_scale / random_init / replan_head, and fails loudly if a patch site is missing.
cat > /tmp/stackpatch.py <<'STACKPATCH_EOF'
{{ stackpatch_py }}STACKPATCH_EOF

TASKS_JSON='{{ tasks_json }}'
TASK_COUNT=$(echo "$TASKS_JSON" | jq length)
SUMMARY_ALL=""

for TASK_IDX in $(seq 0 $((TASK_COUNT - 1))); do
    TASK=$(echo "$TASKS_JSON" | jq -r ".[$TASK_IDX]")
    SUITE=$(echo "$TASK" | jq -r '.suite')
    NUM_TRIALS=$(echo "$TASK" | jq -r '.num_trials_per_task')
    DESCRIPTION=$(echo "$TASK" | jq -r '.description // ""')
    K_COND=$(echo "$TASK" | jq -r '.condition // "S0"')
    K_REPLAN=$(echo "$TASK" | jq -r '.replan // empty')
    K_SEED=$(echo "$TASK" | jq -r '.seed // empty')
    K_STEP_SCALE=$(echo "$TASK" | jq -r '.step_scale // 1')
    K_RANDOM_INIT=$(echo "$TASK" | jq -r '.random_init // false')
    K_REPLAN_HEAD=$(echo "$TASK" | jq -r '.replan_head // false')
    python3 /tmp/stackpatch.py "${OFT_DIR}/experiments/robot/libero/run_libero_eval.py" "${K_STEP_SCALE}" "${K_RANDOM_INIT}" "${K_REPLAN_HEAD}" \
        || die "stack patch failed (task ${TASK_IDX} ${K_COND})"
{%- if libero_plus %}
    # LIBERO-Plus: this entry's perturbation dimension → N seeded variant ids; the task loop of
    # run_libero_eval.py is rewritten to run exactly those (num_trials_per_task trials each).
    LP_KEY=$(echo "$TASK" | jq -r '.perturbation')
    LP_CAT=$(echo "$TASK" | jq -r '.perturbation_category')
    LP_N=$(echo "$TASK" | jq -r '.variants')
    LP_SEED=$(echo "$TASK" | jq -r '.variant_seed')
    LP_MANIFEST="/tmp/oft_task${TASK_IDX}_libero_plus_variants.json"
    LIBERO_PLUS_TASK_IDS=$(python3 /tmp/lp_select_variants.py "${LP_CLASSIFICATION}" "${SUITE}" "${LP_CAT}" "${LP_N}" "${LP_SEED}" \
        --format csv --manifest "${LP_MANIFEST}") || die "LIBERO-Plus variant selection failed (${LP_CAT})"
    export LIBERO_PLUS_TASK_IDS
    python3 /tmp/lp_oft_task_ids_patch.py "${OFT_DIR}/experiments/robot/libero/run_libero_eval.py" \
        || die "LIBERO-Plus task-loop patch failed (task ${TASK_IDX})"
    log "  LIBERO-Plus ${LP_KEY} (${LP_CAT}): ${LP_N} variants (0 = all), seed ${LP_SEED} → task ids ${LIBERO_PLUS_TASK_IDS}"
{%- endif %}
{%- if libero_r2s %}
    # LIBERO-R2S: same task ids / init states / seed for every condition; only the HOPE asset directory changes.
    R2S_COND=$(echo "$TASK" | jq -r '.r2s_condition')
    R2S_ASSET_DIR=$(echo "$TASK" | jq -r '.r2s_dir')
    python3 "${R2S_WORK}/bin/r2s_select.py" use "${R2S_HOPE_PY}" "${R2S_ASSET_DIR}" \
        || die "LIBERO-R2S: selecting ${R2S_ASSET_DIR} failed (task ${TASK_IDX})"
    python3 "${R2S_WORK}/bin/r2s_select.py" loop "${OFT_DIR}/experiments/robot/libero/run_libero_eval.py" "${R2S_TASK_IDS}" \
        || die "LIBERO-R2S: task-loop patch failed (task ${TASK_IDX})"
    log "  LIBERO-R2S condition ${R2S_COND}: assets ${R2S_ASSET_DIR}, task ids ${R2S_TASK_IDS}"
{%- endif %}
    K_ARGS=""
    [ -n "${K_REPLAN}" ] && K_ARGS="${K_ARGS} --num_open_loop_steps ${K_REPLAN}"
    [ -n "${K_SEED}" ] && K_ARGS="${K_ARGS} --seed ${K_SEED}"
    log "  stack condition=${K_COND} replan=${K_REPLAN:-default} seed=${K_SEED:-default} step_scale=${K_STEP_SCALE} random_init=${K_RANDOM_INIT} replan_head=${K_REPLAN_HEAD}"

    VIDEO_DIR="${VIDEO_BASE_DIR}/task-${TASK_IDX}"
    mkdir -p "$VIDEO_DIR"

    log "[5/6] Task $((TASK_IDX+1))/${TASK_COUNT}: suite=${SUITE}, num_trials_per_task=${NUM_TRIALS}"

    # generate.py pins the checkpoint to the selected --libero-suite ({{ task_suite_name }}).
    # The task loop runs a single suite, so we guard against mismatched entries.
    if [ "${SUITE}" != "{{ task_suite_name }}" ]; then
        die "Task suite '${SUITE}' does not match configured suite '{{ task_suite_name }}' (regenerate with matching --libero-suite)"
    fi
    CKPT="{{ hf_repo }}"

    log "  Checkpoint: ${CKPT}"
    touch /tmp/oft_task${TASK_IDX}_start.marker

    # Run LIBERO eval — from openvla-oft dir because save_rollout_video uses relative path ./rollouts/
    # Capture eval exit code so we can fail hard after uploading diagnostic logs.
    set +e
    (
        cd "${OFT_DIR}"
        python experiments/robot/libero/run_libero_eval.py \
            --pretrained_checkpoint "${CKPT}" \
            --task_suite_name "${SUITE}" \
            --num_trials_per_task "${NUM_TRIALS}" \
            --center_crop {{ 'True' if center_crop else 'False' }} \
            --use_wandb False ${K_ARGS}
    ) 2>&1 | tee "/tmp/oft_task${TASK_IDX}.log"
    EVAL_EXIT=${PIPESTATUS[0]}
    set -e
    if [ "${EVAL_EXIT}" -ne 0 ]; then
        log "  [error] Task ${TASK_IDX} eval exit=${EVAL_EXIT} — will fail after uploading diagnostics"
    fi

    # Move rollouts into task video dir (openvla-oft saves to ./rollouts/YYYY_MM_DD/...mp4)
    find "${OFT_DIR}/rollouts" -name "*.mp4" -newer /tmp/oft_task${TASK_IDX}_start.marker \
        -exec mv {} "${VIDEO_DIR}/" \; 2>/dev/null || true
    VIDEO_COUNT=$(find "${VIDEO_DIR}" -name "*.mp4" 2>/dev/null | wc -l)
    log "  Videos collected: ${VIDEO_COUNT}"

    # Parse success rate — openvla-oft logs "Current total success rate: 0.xxx".
    # Read run_libero_eval.py's own plain-text log, NOT the console capture: `import prismatic`
    # installs a rich.logging.RichHandler on the root logger (prismatic/overwatch/overwatch.py),
    # which makes the eval script's later logging.basicConfig() a no-op. Rich then hard-wraps
    # console output at the terminal width (80 cols when not a TTY), splitting the label and the
    # value onto separate lines so the regex below never matches. The log file is written via
    # log_file.write() with no formatter, so it is immune. Fall back to the console capture in
    # case upstream changes local_log_dir.
    # `|| true` is required: find exits 1 when the logs dir is absent (eval died before
    # setup_logging), and under `set -euo pipefail` that would abort the whole script.
    EVAL_LOG=$(find "${OFT_DIR}/experiments/logs" -name "EVAL-${SUITE}-*.txt" \
        -newer /tmp/oft_task${TASK_IDX}_start.marker 2>/dev/null | sort | tail -1 || true)
    [ -n "${EVAL_LOG}" ] || EVAL_LOG="/tmp/oft_task${TASK_IDX}.log"
    log "  Parsing success rate from: ${EVAL_LOG}"
    SR=$(grep -oE 'Current total success rate:[[:space:]]+[0-9.]+' \
        "${EVAL_LOG}" 2>/dev/null | tail -1 | awk '{print $NF}' || echo "unknown")
    [ -n "${SR}" ] || SR="unknown"
    log "  success_rate=${SR}"

    {
        echo "suite: ${SUITE}"
        echo "checkpoint: ${CKPT}"
        echo "num_trials_per_task: ${NUM_TRIALS}"
        echo "success_rate: ${SR}"
        echo "condition: ${K_COND}"
        echo "replan: ${K_REPLAN:-default}"
        echo "seed: ${K_SEED:-default}"
        echo "step_scale: ${K_STEP_SCALE}"
        echo "random_init: ${K_RANDOM_INIT}"
        echo "replan_head: ${K_REPLAN_HEAD}"
        echo "stack_oft_commit: $(git -C "${OFT_DIR}" rev-parse HEAD 2>/dev/null || echo unknown)"
        echo "stack_mujoco: $(python -c 'import mujoco; print(mujoco.__version__)' 2>/dev/null || echo unknown)"
        echo "description: ${DESCRIPTION}"
{%- if libero_plus %}
        # k/n from the eval log's final block (videos carry success=True/False too, as a fallback).
        echo "n_episodes: $(grep -oE 'Total episodes:[[:space:]]+[0-9]+' "${EVAL_LOG}" 2>/dev/null | tail -1 | awk '{print $NF}' || true)"
        echo "n_success: $(grep -oE 'Total successes:[[:space:]]+[0-9]+' "${EVAL_LOG}" 2>/dev/null | tail -1 | awk '{print $NF}' || true)"
        echo "benchmark: libero_plus"
        echo "perturbation: ${LP_KEY}"
        echo "perturbation_category: ${LP_CAT}"
        echo "variants: ${LP_N} (seed ${LP_SEED}; ids in libero_plus_variants.json)"
        echo "stack_libero_plus_commit: ${LP_COMMIT}"
        echo "stack_libero_plus_assets: {{ libero_plus.assets_repo }}@{{ libero_plus.assets_revision[:8] }}"
{%- endif %}
{%- if libero_r2s %}
        read -r R2S_K R2S_N < <(python3 "${R2S_WORK}/bin/r2s_libero_report.py" count "${EVAL_LOG}" 2>/dev/null || echo "0 0")
        echo "n_episodes: ${R2S_N}"
        echo "n_success: ${R2S_K}"
        echo "benchmark: libero_r2s"
        echo "r2s_condition: ${R2S_COND}"
        echo "r2s_task_ids: ${R2S_TASK_IDS}"
        echo "r2s_objects: ${R2S_OBJECTS}"
        echo "stack_r2s_assets: scale={{ libero_r2s.scale }} mass={{ libero_r2s.mass }}"
        echo "stack_r2s_run: {{ libero_r2s.run_id }}"
{%- endif %}
    } > "/tmp/oft_task${TASK_IDX}_summary.txt"

    # S3 upload (videos + logs + summary)
    S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}"
    log "  S3 upload: ${S3_TASK_PREFIX}"
    UPLOAD_COUNT=0
    while IFS= read -r mp4_file || [[ -n "$mp4_file" ]]; do
        [ -f "$mp4_file" ] || continue
        fname=$(basename "$mp4_file")
        base="${fname%.mp4}"
        # Parse metadata from filename: ...--openvla_oft--episode=N--success=True--task=...
        episode=$(echo "$base" | grep -oE 'episode=[0-9]+' | cut -d= -f2 || echo "?")
        result=$(echo "$base" | grep -oE 'success=(True|False)' | cut -d= -f2 || echo "?")
        task_slug=$(echo "$base" | sed -nE 's/.*--task=(.*)/\1/p')
        language_cmd="${task_slug//_/ }"

        # Context txt
        txt_file="/tmp/oft_ctx_task${TASK_IDX}_ep${UPLOAD_COUNT}.txt"
        {
            echo "=== OpenVLA-OFT Simulation Context ==="
            printf "Video:      %s\n"  "${fname}"
            printf "Date:       %s\n"  "$(date '+%Y-%m-%d')"
            echo ""
            echo "--- Environment ---"
            printf "Suite:      %s\n"  "${SUITE}"
            printf "Task:       %s\n"  "${language_cmd}"
{%- if libero_r2s %}
            printf "Objects:    %s (LIBERO-R2S/%s: real2sim run %s)\n" "${R2S_ASSET_DIR}" "${R2S_COND}" "{{ libero_r2s.run_id }}"
{%- endif %}
            printf "Robot:      Franka Panda 7-DOF (LIBERO)\n"
            echo ""
            echo "--- Model ---"
            printf "Checkpoint: %s (rev: %s)\n" "${CKPT}" "{{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }}"
            printf "Repo:       https://github.com/moojink/openvla-oft ({{ oft_commit[:8] if oft_commit else 'HEAD' }})\n"
            echo ""
            echo "--- Rollout ---"
            printf "run_id:        %s\n"  "${RUN_ID}"
            printf "task_idx:      %s\n"  "${TASK_IDX}"
            printf "episode:       %s\n"  "${episode}"
            printf "result:        %s\n"  "${result}"
            printf "total_success: %s (suite avg)\n" "${SR}"
            echo ""
            echo "--- Infrastructure ---"
            printf "Instance: %s (%s)\n"  "${INSTANCE_ID}" "${INSTANCE_TYPE}"
            printf "Region:   %s\n"  "${REGION}"
            printf "Stack:    %s (CDK)\n" "${STACK_NAME}"
        } > "$txt_file"

        if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" \
            --region "$REGION" 2>&1 | tee -a /var/log/openvla-oft-userdata.log; then
            UPLOAD_COUNT=$((UPLOAD_COUNT+1))
            aws s3 cp "$txt_file" "${S3_TASK_PREFIX}/videos/${base}.txt" \
                --region "$REGION" 2>/dev/null || true
        else
            log "  [warn] Upload failed: $fname"
        fi
    done < <(find "$VIDEO_DIR" -name "*.mp4" 2>/dev/null | sort)
    log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"

    aws s3 cp "/tmp/oft_task${TASK_IDX}.log" \
        "${S3_TASK_PREFIX}/eval.log" --region "$REGION" || true
    [ -f "/tmp/oft_task${TASK_IDX}_summary.txt" ] && \
        aws s3 cp "/tmp/oft_task${TASK_IDX}_summary.txt" \
        "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true
    {% from "_protocol-card.sh.j2" import protocol_card with context %}{{ protocol_card('"/tmp/oft_task${TASK_IDX}_summary.txt"', '"${S3_TASK_PREFIX}"') }}
{%- if libero_plus %}
    [ -f "${LP_MANIFEST}" ] && \
        aws s3 cp "${LP_MANIFEST}" "${S3_TASK_PREFIX}/libero_plus_variants.json" --region "$REGION" || true

    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${SUITE} LIBERO-Plus/${LP_KEY} — success_rate=${SR} (${NUM_TRIALS} trial/variant × ${LP_N} variants)"
{%- elif libero_r2s %}

    cp "${EVAL_LOG}" "${R2S_WORK}/eval-${R2S_COND}.log" 2>/dev/null || true
    R2S_CONDS="${R2S_CONDS} --cond ${R2S_COND}=${R2S_WORK}/eval-${R2S_COND}.log"
    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${SUITE} LIBERO-R2S/${R2S_COND} — success_rate=${SR} (${NUM_TRIALS} trials × tasks ${R2S_TASK_IDS})"
{%- else %}

    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${SUITE} — success_rate=${SR} (${NUM_TRIALS} trials/task × 10 tasks)"
{%- endif %}
    log "  Task $((TASK_IDX+1)) done"

    # Hard-fail after S3 upload if eval crashed. This prevents silent CFN SUCCESS when
    # eval never produced rollouts (e.g., import errors, missing deps).
    if [ "${EVAL_EXIT}" -ne 0 ]; then
        die "Task ${TASK_IDX} eval failed (exit=${EVAL_EXIT}) — see s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}/eval.log"
    fi
    if [ "${VIDEO_COUNT}" -eq 0 ]; then
        die "Task ${TASK_IDX} produced 0 rollouts — eval likely short-circuited (see s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}/eval.log)"
    fi
done

{%- if libero_r2s %}
# LIBERO-R2S: public vs reconstructed objects, per condition and per object -> <run>/libero-r2s/
log "[5.9/6] LIBERO-R2S: report..."
# shellcheck disable=SC2086
python3 "${R2S_WORK}/bin/r2s_libero_report.py" final --out "${R2S_WORK}/report" ${R2S_CONDS} \
    --tasks "${R2S_WORK}/tasks.json" --objects "${R2S_WORK}/objects.json" --check "${R2S_WORK}/check.json" \
    --suite {{ libero_r2s.suite }} --model "openvla-oft ({{ hf_repo }})" 2>&1 | tee /tmp/oft_r2s_report.log || log "[warn] LIBERO-R2S report failed"
for f in report/results.json report/summary.txt objects.json tasks.json check.json; do
    [ -f "${R2S_WORK}/${f}" ] && aws s3 cp "${R2S_WORK}/${f}" "s3://${S3_BUCKET}/${RUN_ID}/libero-r2s/$(basename "${f}")" \
        --region "$REGION" --only-show-errors || true
done
SUMMARY_ALL="${SUMMARY_ALL}

$(cat "${R2S_WORK}/report/summary.txt" 2>/dev/null)"
{%- endif %}

# ── [6/6] SNS notification + cfn-signal ──────────────────────────
log "[6/6] Sending SNS notification..."

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] OpenVLA-OFT simulation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}

Model: OpenVLA-OFT (OFT recipe on OpenVLA-7B base)
Simulation: LIBERO (robosuite + MuJoCo, headless EGL)
{%- if libero_plus %}
Benchmark: LIBERO-Plus {{ libero_plus.suite }}, {{ libero_plus.perturb|join(',') }} x {{ libero_plus.variants_per_category or 'all' }} variants (python vlasim.py results --robustness --vla openvla-oft)
{%- endif %}
{%- if libero_r2s %}
Benchmark: LIBERO-R2S {{ libero_r2s.suite }} — objects from real2sim run {{ libero_r2s.run_id }} (python vlasim.py results --real2sim --vla openvla-oft)
{%- endif %}
Instance: ${INSTANCE_TYPE}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./openvla-oft-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla openvla-oft"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "OpenVLA-OFT simulation complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[6/6] Sending cfn-signal..."
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== OpenVLA-OFT UserData complete ====="

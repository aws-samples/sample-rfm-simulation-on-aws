#!/bin/bash
# {{ display_name }} 1-Click UserData Script (post-run judge: score a finished run's rollout videos)
# Model:   {{ hf_repo }} (rev {{ hf_model_revision[:8] }}) — {{ license }}
# Scoring: NVIDIA's own batch_utils/terminal_reward.py from that repository revision (downloaded at
#          run time, not vendored here): official outcome prompt + parser, vLLM offline engine, bf16.
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --judge-target {{ judge_id }}
#
# Environment exported by the S3 bootstrap (cdk/lib/judge-stack.ts):
#   ${S3BucketName}       — results bucket of the EVALUATED target (read videos, write judge.*)
#   ${JudgeRunId}         — run id under that bucket (<RUN_ID>/task-N/videos/*.mp4)
#   ${JudgeTarget}        — evaluated --vla target (for messages)
#   ${JudgeTargetStack}   — evaluated stack name (for messages)
#   ${SnsTopicArn} ${StackName} ${WaitConditionUrl} ${Region} ${AutoTerminate}

set -euo pipefail

WORK_DIR=/opt/{{ judge_id }}
RUN_DIR="${WORK_DIR}/run"
VENV_DIR="${WORK_DIR}/venv"
HF_CACHE_DIR=/opt/{{ judge_id }}/hf
JUDGE_START=$(date +%s)

S3_BUCKET="${S3BucketName}"
RUN_ID="${JudgeRunId}"
JUDGE_TARGET="${JudgeTarget}"
JUDGE_TARGET_STACK="${JudgeTargetStack}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"
S3_RUN="s3://${S3_BUCKET}/${RUN_ID}"

export HOME=/root
export HF_HOME="${HF_CACHE_DIR}"
export PATH="/root/.local/bin:${PATH}"

log() { echo "[{{ judge_id|upper }}] $(date '+%H:%M:%S') $*" | tee -a /var/log/{{ judge_id }}-userdata.log; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/{{ judge_id }}-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

self_terminate() {
    if [ "${AUTO_TERMINATE}" = "true" ]; then
        log "[auto-terminate] Terminating EC2 instance..."
        local _token _iid
        _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
            -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
        _iid=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
            http://169.254.169.254/latest/meta-data/instance-id)
        aws ec2 terminate-instances --instance-ids "$_iid" --region "$REGION" \
            || log "[warn] EC2 terminate failed — please terminate manually"
    fi
}

die() {
    log "ERROR: $*"
    # Best-effort diagnostics next to the judged run (the instance role may write <run>/judge* only).
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${RUN_ID:-}" ]; then
        local _diag="${S3_RUN}/judge-diag-fail"
        aws s3 cp /var/log/{{ judge_id }}-userdata.log "${_diag}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ judge_id }}_*.log; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
        aws sns publish --topic-arn "$SNS_TOPIC_ARN" --region "$REGION" \
            --subject "{{ display_name }} judge FAILED — ${JUDGE_TARGET_STACK} ${RUN_ID}" \
            --message "[${STACK_NAME}] {{ display_name }} judge of ${JUDGE_TARGET} run ${RUN_ID} failed: $*
Diagnostics: aws s3 sync ${_diag}/ ./judge-diag/ --region ${REGION}
Logs: aws logs tail /{{ judge_id }}/userdata --region ${REGION}
Teardown: python destroy.py --judge --vla ${JUDGE_TARGET}" 2>/dev/null || true
    fi
    cfn_signal 1
    self_terminate
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} judge start (${JUDGE_TARGET} run ${RUN_ID}) ====="
[ -n "${RUN_ID}" ] || die "JudgeRunId is empty (deploy.py --judge resolves it)"

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/7] System packages ───────────────────────────────────────────
log "[1/7] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive
systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 2>&1 | tee /tmp/{{ judge_id }}_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    sleep 30
done
APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    curl ca-certificates jq python3 python3-dev build-essential unzip \
    2>&1 | tee /tmp/{{ judge_id }}_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    sleep 30
done
# The Base DLAMI ships AWS CLI v2; install it only if missing (Ubuntu 24.04 has no awscli apt package).
if ! command -v aws >/dev/null 2>&1; then
    curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
        && unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install >> /tmp/{{ judge_id }}_apt.log 2>&1 \
        || die "AWS CLI install failed"
fi

# ── [1.5/7] CloudWatch Logs agent ───────────────────────────────────
# Log group MUST match the stack's IAM grant (/{{ judge_id }}/*).
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ judge_id }}-userdata.log",
            "log_group_name": "/{{ judge_id }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s > /tmp/{{ judge_id }}_cwagent.log 2>&1 \
        && log "  CW agent started (log group: /{{ judge_id }}/userdata)" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi

# ── [2/7] GPU check + tensor-parallel size ──────────────────────────
# bf16 weights ~54 GB + vision encoder + KV cache: one GPU >= {{ single_gpu_mib }} MiB (RTX PRO 6000 96 GB,
# H100 80 GB) runs it alone; otherwise split over all GPUs (g6e.12xlarge: 4 x L40S 48 GB -> TP=4).
log "[2/7] Checking GPUs..."
nvidia-smi 2>&1 | tee /tmp/{{ judge_id }}_nvidia.log || die "nvidia-smi failed (driver missing?)"
N_GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l)
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
DRIVER=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
log "  GPUs: ${N_GPU} x ${GPU_MEM_MIB} MiB, driver ${DRIVER}"
if [ "${GPU_MEM_MIB:-0}" -ge {{ single_gpu_mib }} ]; then
    TP=1
elif [ "${N_GPU}" -ge 2 ] && [ $((N_GPU * GPU_MEM_MIB)) -ge {{ min_total_gpu_mib }} ]; then
    case "${N_GPU}" in 2|4|8) TP=${N_GPU} ;; *) die "tensor parallel needs 2, 4 or 8 GPUs, found ${N_GPU}" ;; esac
else
    die "{{ display_name }} needs one GPU >= {{ single_gpu_mib }} MiB or >= {{ min_total_gpu_mib }} MiB over 2/4/8 GPUs; found ${N_GPU} x ${GPU_MEM_MIB} MiB"
fi
log "  tensor_parallel_size=${TP}"
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo)
[ "${HOST_MEM_MIB}" -ge {{ min_host_mib }} ] || die "needs >= {{ min_host_mib }} MiB host RAM, host has ${HOST_MEM_MIB} MiB"

# ── [3/7] Run videos from the evaluated target's bucket ─────────────
log "[3/7] Copying ${S3_RUN}/task-*/videos + eval_info.json + summary.txt..."
mkdir -p "${RUN_DIR}" "${HF_CACHE_DIR}"
aws s3 sync "${S3_RUN}/" "${RUN_DIR}/" --region "$REGION" --only-show-errors \
    --exclude "*" --include "task-*/videos/*.mp4" --include "task-*/videos/*.txt" \
    --include "task-*/eval_info.json" --include "task-*/summary.txt" \
    2>&1 | tee /tmp/{{ judge_id }}_s3_sync.log || die "s3 sync of ${S3_RUN} failed"
N_VIDEOS=$(find "${RUN_DIR}" -path "*/videos/*.mp4" | wc -l)
log "  videos: ${N_VIDEOS}"
[ "${N_VIDEOS}" -gt 0 ] || die "no task-*/videos/*.mp4 under ${S3_RUN}"

base64 -d > "${WORK_DIR}/flora_judge.py" << 'FLORA_JUDGE_EOF'
{{ judge_py_b64 -}}
FLORA_JUDGE_EOF
# LIBERO task order -> instruction for LeRobot videos (eval_info.json has suite + task id, not the text).
curl -sfL --max-time 60 -o "${WORK_DIR}/libero_suite_task_map.py" "{{ libero_task_map_url }}" \
    || log "[warn] LIBERO task map download failed — LeRobot videos without a sidecar Task are skipped"
python3 "${WORK_DIR}/flora_judge.py" prepare --run-dir "${RUN_DIR}" \
    --jobs "${WORK_DIR}/jobs.all.jsonl" --manifest "${WORK_DIR}/manifest.json" \
    --libero-task-map "${WORK_DIR}/libero_suite_task_map.py" 2>&1 | tee /tmp/{{ judge_id }}_prepare.log \
    || die "no episode with a task instruction under ${S3_RUN} (see /tmp/{{ judge_id }}_prepare.log)"

# ── [4/7] Flora-Rewarder repository @ pinned revision + its requirements ─
log "[4/7] Installing uv + Python {{ python_version }} venv..."
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh > /tmp/{{ judge_id }}_uv_install.log 2>&1 || die "uv install failed"
fi
# Two venvs: a small one only for the Hub downloads (so the background weight download never imports
# from packages the requirements install is replacing), and the scoring venv for batch_utils.
uv venv --python {{ python_version }} "${VENV_DIR}" > /tmp/{{ judge_id }}_venv.log 2>&1 || die "uv venv failed"
uv venv --python {{ python_version }} "${WORK_DIR}/dl-venv" >> /tmp/{{ judge_id }}_venv.log 2>&1 || die "uv venv (download) failed"
VPY="${VENV_DIR}/bin/python"
DPY="${WORK_DIR}/dl-venv/bin/python"
uv pip install --python "${DPY}" "huggingface_hub>=1.0" "hf-xet>=1.5.2" >> /tmp/{{ judge_id }}_venv.log 2>&1 \
    || die "huggingface_hub install failed"
export HF_XET_CLIENT_READ_TIMEOUT=60
export HF_XET_CLIENT_CONNECT_TIMEOUT=30
export HF_XET_CLIENT_RETRY_MAX_DURATION=120

# Code + requirements first (small), then the ~54 GB of weights in the background while vLLM installs.
"${DPY}" - > /tmp/{{ judge_id }}_snapshot_code.log 2>&1 << 'PYEOF' || die "Flora repository (code) download failed"
from huggingface_hub import snapshot_download
path = snapshot_download("{{ hf_repo }}", revision="{{ hf_model_revision }}",
                         allow_patterns=["batch_utils/*", "batch_utils/**", "*.json", "*.jinja", "*.txt", "*.md"])
print("SNAPSHOT=" + path)
PYEOF
SNAP=$(sed -n 's/^SNAPSHOT=//p' /tmp/{{ judge_id }}_snapshot_code.log | tail -1)
[ -f "${SNAP}/batch_utils/terminal_reward.py" ] || die "batch_utils/terminal_reward.py missing in ${SNAP}"
log "  repository: ${SNAP}"
log "  requirements: $(tr '\n' ' ' < "${SNAP}/batch_utils/requirements.txt")"

# Wall-clock cap per attempt (a stalled Xet download returns nothing); the second attempt resumes
# from the partial HF cache.
( for _attempt in 1 2; do
      timeout --signal=TERM --kill-after=60 {{ download_timeout_s }} "${DPY}" -c "
from huggingface_hub import snapshot_download
print(snapshot_download('{{ hf_repo }}', revision='{{ hf_model_revision }}'))
" >> /tmp/{{ judge_id }}_snapshot_weights.log 2>&1 && exit 0
      echo "[weights] attempt ${_attempt} failed" >> /tmp/{{ judge_id }}_snapshot_weights.log
  done; exit 1 ) &
WEIGHTS_PID=$!

log "[4/7] uv pip install -r batch_utils/requirements.txt (vllm, transformers, av, ...)..."
uv pip install --python "${VPY}" -r "${SNAP}/batch_utils/requirements.txt" > /tmp/{{ judge_id }}_pip.log 2>&1 \
    || die "pip install of the Flora requirements failed (see /tmp/{{ judge_id }}_pip.log)"
"${VPY}" -c "
import torch, vllm, transformers
print('torch', torch.__version__, 'cuda', torch.version.cuda, 'vllm', vllm.__version__, 'transformers', transformers.__version__)
assert torch.cuda.is_available(), 'CUDA not visible to torch'
print('device', torch.cuda.get_device_name(0), 'capability', torch.cuda.get_device_capability(0))
" 2>&1 | tee /tmp/{{ judge_id }}_import_check.log || die "torch/vLLM import or CUDA check failed"
STACK_VERSIONS=$(grep '^torch' /tmp/{{ judge_id }}_import_check.log | head -1)

log "[4/7] Waiting for the weights download..."
wait "${WEIGHTS_PID}" || die "Flora weights download failed or timed out (see /tmp/{{ judge_id }}_snapshot_weights.log)"
[ -f "${SNAP}/model.safetensors.index.json" ] || die "weights incomplete: no model.safetensors.index.json in ${SNAP}"
log "  weights: $(du -shL "${SNAP}" | cut -f1)"

# ── [5/7] Drop videos PyAV cannot decode (one bad file would stop the whole batch) ─
log "[5/7] Probing videos..."
( cd "${SNAP}" && "${VPY}" - "${WORK_DIR}/jobs.all.jsonl" "${WORK_DIR}/jobs.jsonl" "${WORK_DIR}/dropped.json" << 'PYEOF'
import json, sys
from batch_utils import core
src, dst, dropped_path = sys.argv[1:4]
ok, dropped = [], {}
for line in open(src):
    job = json.loads(line)
    try:
        for v in job["videos"]:
            core.probe_video(v)
        ok.append(line)
    except Exception as e:  # noqa: BLE001
        dropped[job["id"]] = f"video unreadable: {e}"[:300]
open(dst, "w").writelines(ok)
json.dump(dropped, open(dropped_path, "w"))
print(f"jobs ok={len(ok)} dropped={len(dropped)}")
PYEOF
) 2>&1 | tee /tmp/{{ judge_id }}_probe.log || die "video probe failed"
[ -s "${WORK_DIR}/jobs.jsonl" ] || die "no decodable video to score (see /tmp/{{ judge_id }}_probe.log)"

# ── [6/7] Score: official terminal (outcome) reward, 1..5 per episode ─
log "[6/7] batch_utils.terminal_reward --with-rationale (TP=${TP}; first run compiles kernels)..."
SCORE_START=$(date +%s)
set +e
trap - ERR
( cd "${SNAP}" && timeout {{ score_timeout_s }} "${VPY}" -m batch_utils.terminal_reward \
    --jobs "${WORK_DIR}/jobs.jsonl" --output "${WORK_DIR}/terminal.jsonl" --overwrite \
    --model "${SNAP}" --with-rationale --tensor-parallel-size "${TP}" \
    --max-num-seqs {{ max_num_seqs }} --gpu-memory-utilization {{ gpu_memory_utilization }} ) \
    > /tmp/{{ judge_id }}_score.log 2>&1
SCORE_EXIT=$?
set -e
trap '_trap_handler' ERR
SCORE_S=$(( $(date +%s) - SCORE_START ))
tail -5 /tmp/{{ judge_id }}_score.log | tee -a /var/log/{{ judge_id }}-userdata.log
log "  terminal_reward exit=${SCORE_EXIT} (${SCORE_S}s), lines=$(wc -l < "${WORK_DIR}/terminal.jsonl" 2>/dev/null || echo 0)"
[ "${SCORE_EXIT}" -eq 0 ] || die "terminal_reward failed (exit ${SCORE_EXIT}); see /tmp/{{ judge_id }}_score.log"

# ── [7/7] judge.json + judge.txt next to the run, SNS, signal ───────
WALL_S=$(( $(date +%s) - JUDGE_START ))
python3 "${WORK_DIR}/flora_judge.py" report --manifest "${WORK_DIR}/manifest.json" \
    --scores "${WORK_DIR}/terminal.jsonl" --dropped "${WORK_DIR}/dropped.json" \
    --json "${WORK_DIR}/judge.json" --txt "${WORK_DIR}/judge.txt" --threshold {{ success_threshold }} \
    --meta "target=${JUDGE_TARGET}" "target_stack=${JUDGE_TARGET_STACK}" "run_id=${RUN_ID}" \
           "results_bucket=${S3_BUCKET}" "model={{ hf_repo }}" "model_revision={{ hf_model_revision }}" \
           "license={{ license }}" "prompt=batch_utils.terminal_reward --with-rationale" \
           "instance_type=${INSTANCE_TYPE}" "tensor_parallel=${TP}" "gpu_driver=${DRIVER}" \
           "stack_versions=${STACK_VERSIONS}" "scoring_time_s=${SCORE_S}" "wall_time_s=${WALL_S}" \
           "created=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    2>&1 | tee /tmp/{{ judge_id }}_report.log || die "judge report failed"

aws s3 cp "${WORK_DIR}/judge.json" "${S3_RUN}/judge.json" --region "$REGION" || die "upload judge.json failed"
aws s3 cp "${WORK_DIR}/judge.txt" "${S3_RUN}/judge.txt" --region "$REGION" || die "upload judge.txt failed"
aws s3 cp "${WORK_DIR}/terminal.jsonl" "${S3_RUN}/judge-flora-terminal.jsonl" --region "$REGION" || true
aws s3 cp /var/log/{{ judge_id }}-userdata.log "${S3_RUN}/judge-userdata.log" --region "$REGION" || true
{%- if annotate_captions %}

# Video history gallery: append the score to each video's .txt sidecar. The GalleryPublisher of the
# evaluated stack (when the gallery is on) re-copies the caption and the page shows "Flora N/5".
python3 "${WORK_DIR}/flora_judge.py" captions --manifest "${WORK_DIR}/manifest.json" \
    --report "${WORK_DIR}/judge.json" --out-dir "${WORK_DIR}/captions" > /tmp/{{ judge_id }}_captions.log 2>&1 \
    && aws s3 cp "${WORK_DIR}/captions/" "${S3_RUN}/" --recursive --region "$REGION" --only-show-errors \
        >> /tmp/{{ judge_id }}_captions.log 2>&1 \
    || log "[warn] caption update failed (judge.json is uploaded; gallery shows no score)"
{%- endif %}

SUMMARY=$(sed -n '6,14p' "${WORK_DIR}/judge.txt")
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} judge complete: ${JUDGE_TARGET} run ${RUN_ID}

${SUMMARY}

Model: {{ hf_repo }} (rev {{ hf_model_revision[:8] }}) — {{ license }}
Instance: ${INSTANCE_TYPE} (tensor parallel ${TP}), wall time ${WALL_S}s

Results (next to the run):
  aws s3 cp ${S3_RUN}/judge.txt - --region ${REGION}
  aws s3 cp ${S3_RUN}/judge.json ./judge.json --region ${REGION}
  python vlasim.py results --vla ${JUDGE_TARGET}

Teardown:
  python destroy.py --judge --vla ${JUDGE_TARGET}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} judge complete — ${JUDGE_TARGET_STACK} ${RUN_ID}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

cfn_signal 0
self_terminate
log "===== {{ display_name }} judge complete ====="

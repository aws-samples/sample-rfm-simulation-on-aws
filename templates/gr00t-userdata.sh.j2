FIRST_ENV='{{ first_env_name }}'
log "[3/6] Verifying SimplerEnv venv (rollout_policy imports + gym.make ${FIRST_ENV})..."
"${VENV}/bin/python" - "${FIRST_ENV}" <<'GR00T_SIMPLER_VERIFY_EOF' 2>&1 | tee /tmp/gr00t_simpler_verify.log \
    || die "SimplerEnv venv verify failed (see /tmp/gr00t_simpler_verify.log)"
import sys
import gymnasium as gym
import gr00t.eval.rollout_policy  # noqa: F401  (import chain the rollout client needs)
import gr00t.policy.server_client  # noqa: F401  (PolicyClient: imported lazily by rollout_policy)

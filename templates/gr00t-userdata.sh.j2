    VIDEO_FPS=$(echo "$TASK" | jq -r '.video_fps')
    VIDEO_CRF=$(echo "$TASK" | jq -r '.video_crf')
    STEPS_PER_RENDER=$(echo "$TASK" | jq -r '.steps_per_render')
    # Stack knobs (absent = upstream default): `replan` = actions executed per predicted chunk
    # (rollout_policy.py --n-action-steps), `condition` = label carried into summary.txt.
    K_COND=$(echo "$TASK" | jq -r '.condition // "S0"')
    K_REPLAN=$(echo "$TASK" | jq -r '.replan // empty')
    K_ARGS=()
    [ -n "${K_REPLAN}" ] && K_ARGS+=( --n-action-steps "${K_REPLAN}" )
{%- if sim_id == 'simpler' %}
    # SimplerEnv: optional per-task seed (rollout_policy.py --seed: seeds the Python/NumPy/torch RNGs;
    # the WidowX env wrapper at the gr00t-bridge pin ignores reset seeds) and the
    # benchmark label carried into summary.txt (results.py groups by `suite`).
    K_SEED=$(echo "$TASK" | jq -r '.seed // empty')
    [ -n "${K_SEED}" ] && K_ARGS+=( --seed "${K_SEED}" )
    SUITE=$(echo "$TASK" | jq -r '.suite // empty')
{%- endif %}
    log "  stack condition=${K_COND} replan=${K_REPLAN:-default} max_episode_steps=${MAX_STEPS}"
{%- if libero_plus %}
    # LIBERO-Plus: this entry's perturbation dimension → the variants picked above; one rollout_policy.py
    # call per variant (each variant is its own registered gym id), against the same policy server.
    SUITE=$(echo "$TASK" | jq -r '.suite')
    LP_KEY=$(echo "$TASK" | jq -r '.perturbation')
    LP_CAT=$(echo "$TASK" | jq -r '.perturbation_category')
    LP_N=$(echo "$TASK" | jq -r '.variants')
    LP_SEED=$(echo "$TASK" | jq -r '.variant_seed')
    LP_MANIFEST="/tmp/gr00t_task${TASK_IDX}_libero_plus_variants.json"
    log "  LIBERO-Plus ${LP_KEY} (${LP_CAT}): $(jq length "${LP_MANIFEST}") variants (seed ${LP_SEED})"
{%- endif %}

    VIDEO_DIR="${VIDEO_BASE_DIR}/task-${TASK_IDX}"
    mkdir -p "$VIDEO_DIR"

    # Parse task name + robot tag from ENV_NAME: suite/TaskName_GR1RobotTag_Env
    BASENAME=$(echo "$ENV_NAME" | rev | cut -d'/' -f1 | rev)
    TASK_NAME=$(echo "$BASENAME" | sed 's/_GR1[A-Za-z].*$//')
    ROBOT_TAG=$(echo "$BASENAME" | sed "s/${TASK_NAME}_//;s/_Env$//")

    log "Task $((TASK_IDX+1))/${TASK_COUNT}: ${ENV_NAME}"
    log "  embodiment=${EMBODIMENT}, n_episodes=${N_EPISODES}, n_envs=${N_ENVS}"
    log "  fps=${VIDEO_FPS}, crf=${VIDEO_CRF}, steps_per_render=${STEPS_PER_RENDER}"

    # Start ZMQ server (local mode) or ZMQ↔gRPC bridge (bridge mode)
    if [ -n "$REMOTE_GRPC_ENDPOINT" ]; then
        log "  [Bridge mode] Starting ZMQ↔gRPC bridge → ${REMOTE_GRPC_ENDPOINT} ..."
        PYTHONPATH="$BRIDGE_DIR" nohup "${VENV}/bin/python" "$BRIDGE_DIR/zmq_grpc_bridge.py" \
            --endpoint "$REMOTE_GRPC_ENDPOINT" \
            --zmq-port 8000 \
            > /tmp/gr00t_bridge_task${TASK_IDX}.log 2>&1 &
        SERVER_PID=$!
        log "  Bridge started (PID: $SERVER_PID)"
    else
        log "  [Local mode] Starting ZMQ server (model load ~5-8 min)..."
        nohup "${SERVER_VENV}/bin/python" "${ISAAC_GROOT_DIR}/gr00t/eval/run_gr00t_server.py" \
            --model-path "${HF_MODEL_PATH}" \
            --embodiment-tag "${EMBODIMENT}" \
            --use-sim-policy-wrapper \
            --port 8000 \
            > /tmp/gr00t_zmq_task${TASK_IDX}.log 2>&1 &
        SERVER_PID=$!
    fi

    # Wait for ZMQ port :8000 to be ready
    # Bridge mode: ~1s (Python startup only), Local mode: ~5-8 min (model load on g6.12xlarge)
    ZMQ_READY=0
    for i in $(seq 1 120); do
        # Check if server process is still alive
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            log "  [ERROR] ZMQ server PID $SERVER_PID died (Task ${TASK_IDX}). Last log:"
            tail -30 "/tmp/gr00t_zmq_task${TASK_IDX}.log" 2>/dev/null | while IFS= read -r line; do log "    $line"; done
            break
        fi
        if ss -tlnp 2>/dev/null | grep -q ':8000'; then
            log "  ZMQ :8000 ready (${i}x5s elapsed)"
            ZMQ_READY=1
            break
        fi
        # Every 12 iterations (1 min), emit ZMQ server log tail to CW
        if (( i % 12 == 0 )); then
            log "  ZMQ loading... (${i}x5s). Last ZMQ log: $(tail -1 /tmp/gr00t_zmq_task${TASK_IDX}.log 2>/dev/null | tr '\n' ' ')"
        fi
        sleep 5
    done
    [ "$ZMQ_READY" -eq 1 ] || die "ZMQ :8000 not ready within 10 min (Task ${TASK_IDX})"

    # Run rollout (CLI mode — tyro-style args, N1.7 validated 2026-04-26)
    log "  Running rollout (CLI mode)..."
    touch /tmp/gr00t_task${TASK_IDX}_start.marker
    cd "${ISAAC_GROOT_DIR}"
{%- if libero_plus %}
    : > /tmp/gr00t_rollout_task${TASK_IDX}.log
    LP_DONE=0
    LP_SUCC_SUM=0
    while IFS=$'\t' read -r LP_ID LP_NAME; do
        LP_VDIR="/tmp/gr00t_lp_videos/task${TASK_IDX}/${LP_ID}"
        rm -rf "${LP_VDIR}"
        log "  variant ${LP_ID}: ${LP_NAME}"
        "${VENV}/bin/python" gr00t/eval/rollout_policy.py \
            --env-name "libero_sim/${LP_NAME}" \
            --policy-client-host localhost \
            --policy-client-port 8000 \
            --n-episodes "${N_EPISODES}" \
            --n-envs "${N_ENVS}" \
            --max-episode-steps "${MAX_STEPS}" \
            --video-dir "${LP_VDIR}" \
            "${K_ARGS[@]}" \
            2>&1 | tee /tmp/gr00t_lp_rollout.log | tee -a /tmp/gr00t_rollout_task${TASK_IDX}.log >/dev/null \
            || log "  [warn] variant ${LP_ID} rollout error (continuing)"
        LP_SR=$(grep -oE 'success rate:[[:space:]]+[0-9.]+' /tmp/gr00t_lp_rollout.log 2>/dev/null | tail -1 | awk '{print $NF}' || true)
        if [ -n "${LP_SR}" ]; then

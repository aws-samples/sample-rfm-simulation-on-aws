log "  [3/6] setup_SimplerEnv.sh complete"
{%- if sim_extra_deps %}

# FIX S1 — rollout-client deps missing from the SimplerEnv venv. setup_SimplerEnv.sh installs gr00t
# with --no-deps and a short dependency list; its sanity check imports only simpler_env, but
# rollout_policy.py imports gr00t.policy, whose model code needs more (the LIBERO setup script at
# the same pin installs pandas / dm_tree / einops / albumentations for the same reason). Upstream
# added this exact list to setup_SimplerEnv.sh later (Isaac-GR00T 9c7e746, 2026-07-08). Installed
# together with the venv's own pins so the resolver cannot move them.
log "[3/6] FIX S1: installing rollout-client deps into the SimplerEnv venv..."
uv pip install --python "${VENV}/bin/python" {{ sim_extra_deps }} {{ sim_protect_pins }} \
    2>&1 | tee /tmp/gr00t_fix_s1.log \
    || die "FIX S1: SimplerEnv venv dep install failed (see /tmp/gr00t_fix_s1.log)"
{%- endif %}


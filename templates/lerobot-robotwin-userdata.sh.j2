[ -x "${LEROBOT_DIR}/.venv/bin/lerobot-eval" ] || die "lerobot-eval entrypoint not found in the venv"

# ── [6/8] Pre-download the checkpoint + the repos its processor loads (pinned) ──
# lerobot-eval resolves --policy.path=<repo> (and the tokenizer repos named in the checkpoint config) at
# `main`. Each repo is downloaded at its pinned revision and the cache ref `main` is pointed at it; with
# HF_HUB_OFFLINE=1 the eval then loads exactly these revisions even if upstream `main` moves.
hf_pinned() {
    hf_dl_guard "$1 download" /tmp/{{ vla }}_hf_download.log -- "${VENV_PY}" -c '
import json, pathlib, sys
from huggingface_hub import snapshot_download
from huggingface_hub.constants import HF_HUB_CACHE
repo, rev, patterns = sys.argv[1], sys.argv[2], json.loads(sys.argv[3]) or None
path = snapshot_download(repo, revision=rev, allow_patterns=patterns)
ref = pathlib.Path(HF_HUB_CACHE) / ("models--" + repo.replace("/", "--")) / "refs" / "main"
ref.parent.mkdir(parents=True, exist_ok=True)
ref.write_text(rev)
print(repo + "@" + rev, "->", path)
' "$1" "$2" "$3"
}
log "[6/8] Pre-downloading {{ hf_repo }} (rev {{ hf_model_revision[:8] }})..."
hf_pinned "{{ hf_repo }}" "{{ hf_model_revision }}" 'null' \
    || die "HF checkpoint download failed (see /tmp/{{ vla }}_hf_download.log)"
{%- for extra in extra_hf_repos %}
# {{ extra.why }}
log "[6/8] Pre-downloading {{ extra.repo }} (rev {{ extra.revision[:8] }})..."
hf_pinned "{{ extra.repo }}" "{{ extra.revision }}" '{{ extra.patterns_json }}' \
    || die "{{ extra.repo }} download failed (see /tmp/{{ vla }}_hf_download.log)"
{%- endfor %}
{%- if hf_offline %}
export HF_HUB_OFFLINE=1
{%- endif %}

# ── [6.5/8] Smoke eval: the exact lerobot-eval command line, 1 episode x 3 steps ──
# Same CLI, rename map, env and policy as the real loop (policy load + processors + one action chunk),
# so a missing file, a lazy import or a feature-name mismatch fails here in minutes, not after hours.
SMOKE_TASK=$(echo "${RFM_PLAN_TASKS}" | jq -r '.[0]')
log "[6.5/8] Smoke eval: ${SMOKE_TASK}, 1 episode x 3 steps{% if hf_offline %} (HF_HUB_OFFLINE=1){% endif %}..."
rm -rf /tmp/{{ vla }}-smoke
set +e
trap - ERR
( cd "${ROBOTWIN_DIR}" && timeout --signal=TERM --kill-after=120 3600 \
    "${LEROBOT_DIR}/.venv/bin/lerobot-eval" \
        --policy.path={{ hf_repo }} --policy.device=cuda \
{%- for a in policy_args %}
        '{{ a }}' \
{%- endfor %}
        --env.type=robotwin --env.task="${SMOKE_TASK}" --env.episode_length=3 \
{%- for a in env_args %}
        '{{ a }}' \
{%- endfor %}
        '--rename_map={{ rename_map_json }}' \

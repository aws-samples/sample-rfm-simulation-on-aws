log "  [3/6] LIBERO submodule OK: $(ls external_dependencies/LIBERO | head -3 | tr '\n' ' ')"
{%- if libero_plus %}

# --libero-variant plus: setup_libero.sh installs `libero` editable from external_dependencies/LIBERO, so the
# fork replaces that submodule checkout (runtime clone only) before the script runs. Three edits keep the
# script on the fork: its own `git submodule update` line is dropped (it would check the gitlink commit out
# in the fork clone), its closing gym.make sanity check gets a task name the fork has (the fork renames every
# suite task with a variant suffix), and the fork's requirements.txt is filtered: robosuite 1.4.0 (the fork
# needs 1.4.1), usd-core (training code only; its newest release has no Python 3.10 wheel) and unpinned
# wand / scikit-image go, the pins below come right after the script's mujoco pin (FIX 14) instead.
rm -rf "${ISAAC_GROOT_DIR}/external_dependencies/LIBERO"
{% with lp=libero_plus, lp_step="3/6", lp_log="gr00t", lp_venv_mode="external", lp_python="python3",
        lp_pip="", lp_dir="${ISAAC_GROOT_DIR}/external_dependencies/LIBERO" %}{% include "_libero-plus-setup.sh.j2" %}{% endwith %}
cp "${LIBERO_PLUS_DIR}/requirements.txt" "${LIBERO_PLUS_DIR}/requirements.fork.txt"
grep -viE '^[[:space:]]*(robosuite|usd-core|wand|scikit-image)([[:space:]=<>!~;]|$)' "${LIBERO_PLUS_DIR}/requirements.fork.txt" \
    > "${LIBERO_PLUS_DIR}/requirements.txt"
! grep -qiE '^[[:space:]]*(robosuite|usd-core|wand|scikit-image)([[:space:]=<>!~;]|$)' "${LIBERO_PLUS_DIR}/requirements.txt" \
    || die "LIBERO-Plus: filtering the fork requirements failed"
LP_SANITY_TASK=$(python3 -c "import json, sys; print(json.load(open(sys.argv[1]))['{{ libero_plus.suite }}'][0]['name'])" "${LP_CLASSIFICATION}") \
    || die "LIBERO-Plus: no {{ libero_plus.suite }} entry in ${LP_CLASSIFICATION}"
{%- endif %}

# FIX 14 — mujoco unpinned in the LIBERO dependency chain. setup_libero.sh installs LIBERO's
# requirements.txt, which pins robosuite==1.4.0 but NOT mujoco, and robosuite declares only
# `mujoco>=2.3.0`, so the resolver takes the newest release. mujoco 3.10.0 (2026-06-22) changed
# the mj_fullM signature from mj_fullM(m, dst, M) to mj_fullM(m, d, dst) (mujoco changelog,
# "Breaking API changes"), while robosuite still calls the legacy form at
# robosuite/controllers/base_controller.py:156 — verified unchanged through v1.5.1. The script's
# own closing sanity check (gym.make + env.reset) is what trips it:
# `mj_fullM(): incompatible function arguments`. mujoco 3.11.0 (2026-07-27) fails harder still —
# it removes mjData.qM outright (AttributeError). This target validated 2026-04-27, before both.
#
# The pin must land INSIDE setup_libero.sh: that sanity check is the last thing the script does
# and it runs under `set -e`, so pinning after the script returns is too late. Injected right
# after the script's own `uv pip install numpy==...` line — the final install before the check,
# and after every line that could pull mujoco in (the trailing `--no-deps` editable install
# cannot). Vendoring-0 invariant: only the runtime clone's working tree is edited.
log "[3/6] FIX 14: pinning mujoco in setup_libero.sh ({{ sim_protect_pins if sim_protect_pins else 'mujoco==3.3.1' }}) — mj_fullM compat..."
SETUP_LIBERO_SH="${ISAAC_GROOT_DIR}/gr00t/eval/sim/LIBERO/setup_libero.sh"
[ -f "${SETUP_LIBERO_SH}" ] \
    || die "FIX 14: setup_libero.sh not found at expected path — commit drifted?"
if grep -qF 'FIX 14' "${SETUP_LIBERO_SH}"; then
    log "  FIX 14 already applied — skip"
else
    grep -qE '^uv pip install numpy==' "${SETUP_LIBERO_SH}" \
        || die "FIX 14: no 'uv pip install numpy==' anchor in setup_libero.sh — commit drifted, re-verify?"
    # Anchor matches any numpy version so an upstream numpy bump doesn't silently skip the pin.
    sed -i -E 's|^(uv pip install numpy==.*)$|\1\nuv pip install {{ sim_protect_pins if sim_protect_pins else "mujoco==3.3.1" }}  # FIX 14: hold mujoco below 3.10 (mj_fullM signature)|' \
        "${SETUP_LIBERO_SH}"
    grep -qF 'FIX 14' "${SETUP_LIBERO_SH}" \
        || die "FIX 14: sed did not apply the mujoco pin (see ${SETUP_LIBERO_SH})"
    bash -n "${SETUP_LIBERO_SH}" \
        || die "FIX 14: setup_libero.sh no longer parses after patch"
    log "  FIX 14 applied — $(grep -n 'FIX 14' "${SETUP_LIBERO_SH}" | head -1)"
fi
{%- if libero_plus %}
python3 - "${SETUP_LIBERO_SH}" "${LP_SANITY_TASK}" <<'LP_SETUP_EOF' || die "LIBERO-Plus: setup_libero.sh patch failed (Isaac-GR00T commit drifted?)"
import re
import sys
p, task = sys.argv[1], sys.argv[2]
s = open(p).read()
s, k1 = re.subn(r"^git submodule update --init \$LIBERO_REPO\n", "", s, flags=re.M)
s, k2 = re.subn(r'gym\.make\("libero_sim/[A-Za-z0-9_]+"\)', 'gym.make("libero_sim/' + task + '")', s)
s, k3 = re.subn(r"^(uv pip install .*# FIX 14.*)$",
                lambda m: m.group(1) + "\nuv pip install {{ libero_plus.pip_pins }}  # LIBERO-Plus pins", s, flags=re.M)
assert (k1, k2, k3) == (1, 1, 1), ("submodule line, sanity env, FIX 14 line", k1, k2, k3)
open(p, "w").write(s)
print("setup_libero.sh patched for LIBERO-Plus (sanity env libero_sim/" + task + ")")
LP_SETUP_EOF
bash -n "${SETUP_LIBERO_SH}" || die "LIBERO-Plus: setup_libero.sh no longer parses after patch"
{%- endif %}

# Run setup_libero.sh — pipe output to both file and CW Logs (via userdata.log)
log "  [3/6] Running setup_libero.sh (uv venv + deps + sanity) ..."
bash gr00t/eval/sim/LIBERO/setup_libero.sh \

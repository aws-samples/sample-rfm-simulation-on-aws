#!/bin/bash
# {{ display_name }} 1-Click UserData Script (LIBERO-Pro sim, agentic skill discovery)
# ASPIRE:     {{ repo_url }} @ {{ repo_commit[:8] }} — {{ license }}
# Pattern:    tool services (SAM3 / Contact-GraspNet / PyRoki) on GPU 0 + cap-harness LIBERO sim;
#             Claude Code on Amazon Bedrock writes the per-task program, which is then frozen and scored.
# Generated by vla-simulator/generate.py
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName}       — results S3 bucket
#   ${SnsTopicArn}        — completion notification SNS topic
#   ${StackName}          — CDK stack name
#   ${WaitConditionUrl}   — CFN WaitConditionHandle presigned URL
#   ${Region}             — deployment region
#   ${AutoTerminate}      — "true" to auto-terminate EC2 after completion

set -euo pipefail

ASPIRE_DIR=/root/ASPIRE
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

# UserData runs as root; HOME must be set so uv puts caches in a stable place.
export HOME=/root
export HF_HOME="${HF_CACHE_DIR}"
# uv installs into ~/.local/bin
export PATH="/root/.local/bin:${PATH}"

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a /var/log/{{ vla }}-userdata.log; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/{{ vla }}-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

die() {
    log "ERROR: $*"
    # Best-effort: dump diagnostics to S3 before CFN rollback eats the instance
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ]; then
        local _diag_prefix="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag-fail"
        log "  Uploading /tmp/{{ vla }}_*.log to ${_diag_prefix}..."
        aws s3 cp /var/log/{{ vla }}-userdata.log "${_diag_prefix}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ vla }}_*.log; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag_prefix}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
    fi
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/7] System dependencies ──────────────────────────────────────
log "[1/7] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive

systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
pkill -9 -f "apt-get" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a 2>&1 | tee /tmp/{{ vla }}_dpkg_fix.log || true

# Boot hardening (2026-10): the command-not-found apt hook hung apt-get update for 3 h on a g6e, and the
# apt-daily timers re-launch unattended-upgrades mid-boot (held the dpkg lock past 5 min). Drop / mask both.
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 2>&1 | tee /tmp/{{ vla }}_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    log "[warn] apt-get update failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    git git-lfs curl ca-certificates awscli jq \
    libgl1-mesa-glx libegl1 libgles2 \
    libglib2.0-0 libsm6 libxext6 libxrender1 \
    ffmpeg build-essential \
    2>&1 | tee /tmp/{{ vla }}_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    log "[warn] apt-get install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# ── [1.5/7] CloudWatch Logs agent setup ──────────────────────────
log "[1.5/7] Setting up CloudWatch Logs agent..."
# Log group MUST match the stack's IAM grant (/${vla}/* → /{{ vla }}/*).
CW_LOG_GROUP="/{{ vla }}/userdata"
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s 2>&1 | tee /tmp/{{ vla }}_cwagent.log \
        && log "  CW agent started (log group: ${CW_LOG_GROUP})" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi

# ── [2/7] NVIDIA driver check + fp32 VRAM floor guard ───────────────
log "[2/7] Checking GPU driver..."
nvidia-smi -L 2>&1 | tee /tmp/{{ vla }}_nvidia.log \
    || log "[warn] nvidia-smi failed — verify DLAMI (continuing with EGL headless)"
# Fail-fast VRAM / host-RAM floors (models/{{ vla }}.yaml: min_gpu_mib / min_host_mib). Without them an
# undersized instance silently burns the full creationpolicy_timeout before the WaitCondition times out.
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || echo "0")
log "  GPU0 memory: ${GPU_MEM_MIB} MiB"
if [ "${GPU_MEM_MIB:-0}" -lt {{ min_gpu_mib }} ]; then
    die "{{ display_name }} needs a single GPU >= {{ min_gpu_mib }} MiB; GPU0 has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
log "  Host RAM: ${HOST_MEM_MIB} MiB"
if [ "${HOST_MEM_MIB:-0}" -lt {{ min_host_mib }} ]; then
    die "{{ display_name }} needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi

# ── [2.5/7] Gated-weight access probe (fail fast, before the ~30 min bootstrap) ──
log "[2.5/7] Reading HF token from SSM and probing facebook/sam3 access..."
HF_TOKEN=$(aws ssm get-parameter --name /vla-simulator/hf-token --with-decryption \
    --query 'Parameter.Value' --output text --region "$REGION" 2>/dev/null || echo "")
[ -n "$HF_TOKEN" ] || die "SSM /vla-simulator/hf-token is empty — SAM3 weights are gated and need an approved HF account"
export HF_TOKEN
# Probe gated access BEFORE spending time on services: 401/403 here means the account behind the
# token has not been approved for facebook/sam3 yet (request access on the model page).
SAM3_HTTP=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer ${HF_TOKEN}" \
    https://huggingface.co/facebook/sam3/resolve/main/config.json || echo 000)
log "  facebook/sam3 access probe: HTTP ${SAM3_HTTP}"
{% if preflight %}# preflight: SAM3 is not started, so a gated 401/403 is reported but not fatal.
case "${SAM3_HTTP}" in 200|302|307) ;; *) log "[warn] preflight: facebook/sam3 not accessible (HTTP ${SAM3_HTTP}) — SAM3 service skipped";; esac
{% else %}[ "${SAM3_HTTP}" = "200" ] || [ "${SAM3_HTTP}" = "302" ] || [ "${SAM3_HTTP}" = "307" ] \
    || die "facebook/sam3 is not accessible with this HF token (HTTP ${SAM3_HTTP}) — request access on huggingface.co/facebook/sam3"
{% endif %}

# ── [3/7] uv + ASPIRE clone (pinned) + bootstrap (LIBERO-Pro venv + tool providers) ──
log "[3/7] Installing uv and cloning ASPIRE @ {{ repo_commit[:8] }}..."
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh 2>&1 | tee /tmp/{{ vla }}_uv.log || die "uv install failed"
fi
uv --version | tee -a /var/log/{{ vla }}-userdata.log
rm -rf "${ASPIRE_DIR}"
git clone {{ repo_url }} "${ASPIRE_DIR}" 2>&1 | tee /tmp/{{ vla }}_clone.log || die "ASPIRE clone failed"
cd "${ASPIRE_DIR}"
git checkout -q {{ repo_commit }} || die "ASPIRE checkout {{ repo_commit }} failed"
# Upstream bug at this pin: LiberoAdapter.reset() tests `elif not init_states:` on the numpy array the
# LIBERO-PRO fork returns, so every --init-mode saved run dies in setup ("truth value of an array ...
# is ambiguous", termination_reason=harness_error). Seeded runs skip that branch, which is why the
# agent's own dev runs work. Patch it to a length check (no behaviour change for list inputs).
python3 - <<'PYEOF' || die "could not patch the saved init-state check"
p = "src/cap_harness/libero/adapter.py"
s = open(p).read()
old = "        elif not init_states:\n"
if s.count(old) == 1:
    open(p, "w").write(s.replace(old, "        elif len(init_states) == 0:\n"))
    print("patched saved init-state check")
elif "elif len(init_states) == 0:" in s:
    print("saved init-state check already fixed upstream")
else:
    raise SystemExit("saved init-state check not found; re-check the pin")
PYEOF
export CAP_HARNESS_PROFILE={{ profile }}

# bootstrap_libero.sh inits the pinned LIBERO-PRO / robosuite / sam3 / contact_graspnet submodules,
# checks them against configs/dependency-lock.json and builds .venv-libero (torch cu128 wheels; no
# system CUDA toolkit needed). It does not use sudo or prompt.
log "  bootstrap_libero.sh (profile {{ profile }})..."
scripts/bootstrap_libero.sh > /tmp/{{ vla }}_bootstrap_libero.log 2>&1 \
    || { tail -40 /tmp/{{ vla }}_bootstrap_libero.log; die "bootstrap_libero.sh failed"; }
log "  bootstrap_providers.sh --providers {{ providers|join(',') }}..."
scripts/bootstrap_providers.sh --providers {{ providers|join(',') }} --profile {{ profile }} \
    > /tmp/{{ vla }}_bootstrap_providers.log 2>&1 \
    || { tail -40 /tmp/{{ vla }}_bootstrap_providers.log; die "bootstrap_providers.sh failed"; }

export LIBERO_CONFIG_PATH="${ASPIRE_DIR}/.libero"
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl EGL_PLATFORM=device MUJOCO_EGL_DEVICE_ID=0 CUDA_VISIBLE_DEVICES=0
CAPH="${ASPIRE_DIR}/.venv-libero/bin/cap-harness"
[ -x "$CAPH" ] || die "cap-harness entrypoint missing after bootstrap"

# ── [4/7] Tool services (SAM3 · Contact-GraspNet · PyRoki) on GPU 0 ──
# SAM3 weights are gated (facebook/sam3, manual approval); the token comes from SSM.
log "[4/7] Starting tool services..."
nohup scripts/supervise_services.sh --profile {{ profile }} --providers {{ service_providers|join(',') }} \
    --ready-timeout 1200 > /tmp/{{ vla }}_services.log 2>&1 &
SERVICES_PID=$!
SERVICES_READY=false
for _i in $(seq 1 130); do
    _ok=0
    for _p in {{ service_ports|join(' ') }}; do
        [ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${_p}/openapi.json" || echo 000)" = "200" ] && _ok=$((_ok+1))
    done
    if [ "$_ok" -eq {{ service_ports|length }} ]; then SERVICES_READY=true; break; fi
    kill -0 "$SERVICES_PID" 2>/dev/null || break
    sleep 10
done
[ "$SERVICES_READY" = true ] || { tail -60 /tmp/{{ vla }}_services.log; die "tool services did not become ready (ports {{ service_ports|join(',') }})"; }
log "  services ready on ports {{ service_ports|join(',') }}"
"$CAPH" doctor --providers {{ service_providers|join(',') }} --output /tmp/{{ vla }}_doctor.json \
    > /tmp/{{ vla }}_doctor.log 2>&1 || log "[warn] cap-harness doctor reported problems (see doctor.log)"

S3_RUN_PREFIX="s3://${S3_BUCKET}/${RUN_ID}"
aws s3 cp /tmp/{{ vla }}_doctor.log "${S3_RUN_PREFIX}/doctor.log" --region "$REGION" 2>/dev/null || true

# Suites available in the pinned LIBERO-PRO fork (the standard suites must be present for the
# LeRobot-comparable tasks).
"${ASPIRE_DIR}/.venv-libero/bin/python" - > /tmp/{{ vla }}_suites.txt 2>&1 <<'PYEOF' || true
import importlib
for name in ("libero.benchmark", "libero.libero.benchmark"):   # same order as cap_harness.libero.registry
    try:
        benchmark = importlib.import_module(name)
        break
    except ImportError:
        continue
print(" ".join(sorted(benchmark.get_benchmark_dict())))
PYEOF
log "  LIBERO suites: $(tail -1 /tmp/{{ vla }}_suites.txt | cut -c1-400)"

{% if not preflight %}for _s in $(echo '{{ tasks_json }}' | jq -r '.[].suite' | sort -u) {{ sanity_program.suite }}; do
    grep -qw "$_s" /tmp/{{ vla }}_suites.txt || die "LIBERO suite ${_s} not in the pinned LIBERO-PRO fork (see suites log)"
done
{% endif %}# run_one PROGRAM SUITE TASK SEED INIT_MODE OUTROOT → prints "task_success=<true|false>"; never dies.
run_one() {
    local _prog=$1 _suite=$2 _task=$3 _seed=$4 _mode=$5 _out=$6
    mkdir -p "$_out"
    "$CAPH" run --benchmark libero-pro --suite "$_suite" --task-id "$_task" --seed "$_seed" \
        --program "$_prog" --output-root "$_out" --init-mode "$_mode" \
        --camera-width 512 --camera-height 512 > "$_out/run.log" 2>&1 || true
    local _oc
    _oc=$(find "$_out" -name outcome.json -newer "$_prog" 2>/dev/null | sort | tail -1)
    if [ -n "$_oc" ]; then
        jq -r '"task_success=\(.task_success) steps=\(.steps_executed) wall_s=\(.wall_duration_s) reason=\(.termination_reason)"' "$_oc"
    else
        echo "task_success=false steps=0 wall_s=0 reason=no_outcome"
    fi
}

log "  Installing Claude Code (Bedrock) for the discovery loop..."
if ! command -v node >/dev/null 2>&1; then
    # Official tarball instead of apt: no dpkg lock to wait on.
    NODE_TGZ=$(curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt | awk '/linux-x64.tar.xz$/{print $2}')
    [ -n "$NODE_TGZ" ] || die "node tarball name lookup failed"
    curl -fsSL "https://nodejs.org/dist/latest-v22.x/${NODE_TGZ}" -o /tmp/node.tar.xz > /tmp/{{ vla }}_node.log 2>&1 || die "node download failed"
    mkdir -p /opt/node && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 >> /tmp/{{ vla }}_node.log 2>&1 || die "node extract failed"
    export PATH="/opt/node/bin:$PATH"
    node --version >> /tmp/{{ vla }}_node.log 2>&1 || die "nodejs install failed"
fi
npm install -g @anthropic-ai/claude-code >> /tmp/{{ vla }}_node.log 2>&1 || die "claude-code install failed"
claude --version | tee -a /var/log/{{ vla }}-userdata.log || die "claude CLI not on PATH"
export CLAUDE_CODE_USE_BEDROCK=1 AWS_REGION="$REGION" ANTHROPIC_MODEL="{{ agent.bedrock_model }}"
# Sub-agents / background calls ask for the "sonnet" and "haiku" aliases; without these the CLI falls back
# to an old model id that is not offered in every region.
export ANTHROPIC_DEFAULT_SONNET_MODEL="{{ agent.bedrock_sonnet_model }}" ANTHROPIC_DEFAULT_HAIKU_MODEL="{{ agent.bedrock_haiku_model }}"
export IS_SANDBOX=1   # root on a throwaway instance; required for --dangerously-skip-permissions as root
export DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

{% if preflight %}
# ── [5/7] Preflight: Bedrock round trip from the instance role, then stop (no SAM3, no episodes) ──
log "[5/7] Preflight: claude -p round trip via Bedrock..."
PF_OUT=$(cd /tmp && timeout 300 claude -p "Reply with exactly: OK" --output-format json 2>/tmp/{{ vla }}_preflight_claude.err || true)
echo "$PF_OUT" > /tmp/{{ vla }}_preflight_claude.json
PF_RES=$(echo "$PF_OUT" | jq -r '.result // "no-result"' 2>/dev/null || echo parse-error)
log "  claude -p result: ${PF_RES} (cost_usd=$(echo "$PF_OUT" | jq -r '.total_cost_usd // "n/a"' 2>/dev/null))"
for _f in /tmp/{{ vla }}_*.log /tmp/{{ vla }}_*.json /tmp/{{ vla }}_*.err /tmp/{{ vla }}_suites.txt; do
    [ -f "$_f" ] && aws s3 cp "$_f" "${S3_RUN_PREFIX}/preflight/$(basename "$_f")" --region "$REGION" >/dev/null 2>&1 || true
done
aws s3 cp /var/log/{{ vla }}-userdata.log "${S3_RUN_PREFIX}/preflight/userdata.log" --region "$REGION" 2>/dev/null || true
case "$PF_RES" in *OK*) ;; *) die "preflight: Bedrock round trip failed (${PF_RES}) — see ${S3_RUN_PREFIX}/preflight/";; esac
SANITY_RES="preflight (no episodes)"
SUMMARY_ALL="
[preflight] bootstrap + services ({{ service_providers|join(',') }}) + doctor + Bedrock OK"
kill "$SERVICES_PID" 2>/dev/null || true
{% else %}
# ── [5/7] Sanity: one shipped ASPIRE example program (proves the tool stack end-to-end) ──
log "[5/7] Sanity run: {{ sanity_program.program }} on {{ sanity_program.suite }}:{{ sanity_program.task_id }} seed {{ sanity_program.seed }}..."
SANITY_OUT=/tmp/{{ vla }}-sanity
SANITY_RES=$(run_one "${ASPIRE_DIR}/{{ sanity_program.program }}" {{ sanity_program.suite }} {{ sanity_program.task_id }} {{ sanity_program.seed }} saved "$SANITY_OUT")
log "  sanity: ${SANITY_RES}"
# A harness error (not a task failure) means the scored eval below would be meaningless — stop here.
case "$SANITY_RES" in *reason=harness_error*|*reason=no_outcome*) die "sanity run hit ${SANITY_RES} — harness is broken, not scoring";; esac
aws s3 cp "$SANITY_OUT" "${S3_RUN_PREFIX}/sanity/" --recursive --exclude "*" \
    --include "*.json" --include "*.log" --include "*.mp4" --region "$REGION" > /dev/null 2>&1 || true

# ── [6/7] Per task: agentic discovery (Claude Code on Bedrock) → frozen program → scored eval ──
TASKS_JSON='{{ tasks_json }}'
SUMMARY_ALL=""
N_TASK_ENTRIES=$(echo "$TASKS_JSON" | jq 'length')
for TASK_IDX in $(seq 0 $((N_TASK_ENTRIES - 1))); do
  SUITE=$(echo "$TASKS_JSON" | jq -r ".[$TASK_IDX].suite")
  for TID in $(echo "$TASKS_JSON" | jq -r ".[$TASK_IDX].task_ids[]"); do
    TAG="${SUITE}_task${TID}"
    WORK="/root/aspire-out/${TAG}"
    mkdir -p "$WORK"
    PROGRAM="${WORK}/program.py"
    log "  [${TAG}] discovery loop (model {{ agent.bedrock_model }}, cap {{ agent.timeout_min }} min)..."
    cat > "${WORK}/prompt.txt" <<PROMPT
You are running ASPIRE's iterative-debugging workflow headless on a single-GPU AWS instance.
Repository: ${ASPIRE_DIR} (ASPIRE {{ repo_commit[:8] }}). Read .claude/skills/iterative-debugging/SKILL.md,
its main-agent-prompt.md and docs/libero-pro.md first. Do not read or run real-robot material
(AGENTS.md, docs/system2*.md, docs/yam-real.md, src/cap_harness/yam_real/).

Environment (already set up — do not reinstall or upgrade anything):
- cap-harness: ${CAPH}   (benchmark libero-pro; the LIBERO env vars are exported)
- Tool services are up on GPU 0: SAM3 :8114, Contact-GraspNet :8115, PyRoki :8116. No cuRobo.
- Single GPU: you are the coordinator and run every episode yourself; subagents may only analyse.

Target: suite ${SUITE}, task id ${TID}. Discover a cap-harness program that solves it.
Rules:
1. Develop ONLY on development seeds 51-65 with --init-mode seeded. Never run seeds 1-50.
2. Write the final program to ${PROGRAM} (a cap-harness program, same form as examples/libero/*.py).
3. Stop when the program succeeds on at least 4 of 5 development seeds you have not tuned on,
   or when you judge further attempts are not making progress. Be economical with episodes.
4. Finish with one line: FINAL <dev_passes>/<dev_trials>.
PROMPT
    T0=$(date +%s)
    ( cd "${ASPIRE_DIR}" && timeout {{ agent.timeout_min }}m claude -p "$(cat "${WORK}/prompt.txt")" \
        --dangerously-skip-permissions --max-turns {{ agent.max_turns }} \
        --output-format stream-json --verbose > "${WORK}/agent.jsonl" 2> "${WORK}/agent.err" ) || true
    AGENT_S=$(( $(date +%s) - T0 ))
    AGENT_COST=$(grep '"type":"result"' "${WORK}/agent.jsonl" | tail -1 | jq -r '.total_cost_usd // "n/a"' 2>/dev/null || echo n/a)
    AGENT_TURNS=$(grep '"type":"result"' "${WORK}/agent.jsonl" | tail -1 | jq -r '.num_turns // "n/a"' 2>/dev/null || echo n/a)
    AGENT_FINAL=$(grep -o 'FINAL [0-9]*/[0-9]*' "${WORK}/agent.jsonl" | tail -1 || true)
    log "  [${TAG}] agent done in ${AGENT_S}s · cost_usd=${AGENT_COST} · turns=${AGENT_TURNS} · ${AGENT_FINAL:-no FINAL line}"
    if [ ! -s "$PROGRAM" ]; then
        # Fall back to the newest fix_code.py the skill wrote for this task, if any.
        _fc=$(find "${ASPIRE_DIR}/outputs" -path "*${SUITE}*task_${TID}*" -name fix_code.py 2>/dev/null | xargs -r ls -t | head -1)
        [ -n "$_fc" ] && cp "$_fc" "$PROGRAM"
    fi

    PASSES=0; TRIALS=0
    if [ -s "$PROGRAM" ]; then
        for SEED in {{ eval_seeds|join(' ') }}; do
            RES=$(run_one "$PROGRAM" "$SUITE" "$TID" "$SEED" saved "${WORK}/eval/seed${SEED}")
            log "  [${TAG}] eval seed ${SEED} (saved init state $((SEED-1))): ${RES}"
            TRIALS=$((TRIALS+1))
            case "$RES" in task_success=true*) PASSES=$((PASSES+1));; esac
        done
    else
        log "  [${TAG}] no program produced — scored 0/{{ eval_seeds|length }}"
        TRIALS={{ eval_seeds|length }}
    fi
    SR=$(python3 -c "print(round(${PASSES}/${TRIALS},2))")
    {
        echo "model: {{ vla }} (agent {{ agent.bedrock_model }})"
        echo "aspire: {{ repo_url }}@{{ repo_commit[:8] }}"
        echo "suite: ${SUITE}"; echo "task_id: ${TID}"
        echo "eval: ${PASSES}/${TRIALS} (init-mode saved, seeds {{ eval_seeds|join(',') }})"
        echo "success_rate: ${SR}"
        echo "agent_seconds: ${AGENT_S}"; echo "agent_cost_usd: ${AGENT_COST}"; echo "agent_turns: ${AGENT_TURNS}"
        echo "agent_dev: ${AGENT_FINAL:-n/a}"
    } > "${WORK}/summary.txt"
    aws s3 cp "$WORK" "${S3_RUN_PREFIX}/${TAG}/" --recursive --exclude "*" \
        --include "*.txt" --include "*.py" --include "*.jsonl" --include "*.err" \
        --include "*.json" --include "*.log" --include "*.mp4" --region "$REGION" > /dev/null 2>&1 \
        || log "  [warn] S3 upload failed for ${TAG}"
    SUMMARY_ALL="${SUMMARY_ALL}
[${TAG}] success_rate=${SR} (${PASSES}/${TRIALS}) · agent ${AGENT_S}s · cost_usd=${AGENT_COST}"
  done
done
aws s3 cp /var/log/{{ vla }}-userdata.log "${S3_RUN_PREFIX}/userdata.log" --region "$REGION" 2>/dev/null || true
kill "$SERVICES_PID" 2>/dev/null || true

{% endif %}
# ── [7/7] SNS notification + cfn-signal ──────────────────────────
log "[7/7] Sending SNS notification..."

SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} simulation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}

Model: {{ policy_desc }}
ASPIRE: {{ repo_url }}@{{ repo_commit[:8] }}
License: {{ license }}
Sanity ({{ sanity_program.program }}): ${SANITY_RES}
Simulation: LIBERO-Pro fork (robosuite + MuJoCo, headless EGL)
Instance: ${INSTANCE_TYPE}

Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} simulation complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[7/7] Sending cfn-signal..."
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

#!/bin/bash
# {{ display_name }} 1-Click UserData Script (LIBERO, the authors' own evaluation loop, in-process on one GPU)
# Checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] }}
# License:    {{ license }}
# Code:       {{ code_repo }} @ {{ code_commit[:8] }} (LIBERO @ {{ libero_commit[:8] }})
# Runner:     assets/libero/own_eval_runner.py --adapter {{ adapter }} ({{ eval_label }}; one call per suite run)
# venv:       Python {{ python_version }} from assets/libero/{{ requirements_name }} (embedded below)
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}{{ (' --task-set ' ~ task_set) if task_set else '' }}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName}       — results S3 bucket
#   ${SnsTopicArn}        — completion notification SNS topic
#   ${StackName}          — CDK stack name
#   ${WaitConditionUrl}   — CFN WaitConditionHandle presigned URL
#   ${Region}             — deployment region
#   ${AutoTerminate}      — "true" to auto-terminate EC2 after completion

set -euo pipefail

W=/home/ubuntu/{{ vla }}
CODE_DIR="${W}/code"
LIBERO_DIR="${W}/LIBERO"
VENV_DIR="${W}/venv"
ASSETS_DIR="${W}/assets"
RUNNER="${W}/own_eval_runner.py"
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
EVAL_BASE_DIR=/tmp/{{ vla }}-eval
VIDEO_BASE_DIR=/tmp/{{ vla }}-videos
RUN_ID=$(date '+%Y-%m-%d-%H%M')
S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

# UserData runs as root; HOME must be set so uv puts caches in a stable place.
export HOME=/root
export HF_HOME="${HF_CACHE_DIR}"
# uv installs into ~/.local/bin
export PATH="/root/.local/bin:${PATH}"
mkdir -p "${W}"

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a /var/log/{{ vla }}-userdata.log; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/{{ vla }}-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

die() {
    log "ERROR: $*"
    # Best-effort: dump diagnostics to S3 before CFN rollback eats the instance
    if [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ]; then
        local _diag_prefix="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag-fail"
        log "  Uploading /tmp/{{ vla }}_*.log to ${_diag_prefix}..."
        aws s3 cp /var/log/{{ vla }}-userdata.log "${_diag_prefix}/userdata.log" --region "$REGION" 2>/dev/null || true
        for _f in /tmp/{{ vla }}_*.log; do
            [ -f "$_f" ] || continue
            aws s3 cp "$_f" "${_diag_prefix}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
        done
    fi
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/7] System dependencies ──────────────────────────────────────
log "[1/7] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive

systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
pkill -9 -f "apt-get" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a 2>&1 | tee /tmp/{{ vla }}_dpkg_fix.log || true

# Boot hardening (2026-10): the command-not-found apt hook hung apt-get update for 3 h on a g6e, and the
# apt-daily timers re-launch unattended-upgrades mid-boot (held the dpkg lock past 5 min). Drop / mask both.
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 2400 apt-get update -qq -o DPkg::Lock::Timeout=1800 2>&1 | tee /tmp/{{ vla }}_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    log "[warn] apt-get update failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# libegl1 / libgles2 / libgl1-mesa-glx: MuJoCo renders LIBERO headless through EGL (MUJOCO_GL=egl). ffmpeg: imageio
# writes the episode videos.
APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=1800 \
    git curl ca-certificates awscli jq \
    libgl1-mesa-glx libegl1 libgles2 libglib2.0-0 libsm6 libxext6 libxrender1 \
    ffmpeg build-essential \
    2>&1 | tee /tmp/{{ vla }}_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    log "[warn] apt-get install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# ── [1.5/7] CloudWatch Logs agent setup ──────────────────────────
log "[1.5/7] Setting up CloudWatch Logs agent..."
# Log group MUST match the stack's IAM grant (/${vla}/* → /{{ vla }}/*).
CW_LOG_GROUP="/{{ vla }}/userdata"
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s 2>&1 | tee /tmp/{{ vla }}_cwagent.log \
        && log "  CW agent started (log group: ${CW_LOG_GROUP})" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi

# ── [2/7] NVIDIA driver, VRAM / host-RAM floors ───────────────
log "[2/7] Checking GPU driver..."
nvidia-smi -L 2>&1 | tee /tmp/{{ vla }}_nvidia.log \
    || log "[warn] nvidia-smi failed — verify DLAMI"
# Fail-fast floors (models/{{ vla }}.yaml: min_gpu_mib / min_host_mib). Without them an undersized instance silently
# burns the full creationpolicy_timeout before the WaitCondition times out.
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || echo "0")
GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || echo "unknown")
log "  GPU0: ${GPU_NAME} ${GPU_MEM_MIB} MiB"
if [ "${GPU_MEM_MIB:-0}" -lt {{ min_gpu_mib }} ]; then
    die "{{ display_name }} needs a single GPU >= {{ min_gpu_mib }} MiB; GPU0 has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
log "  Host RAM: ${HOST_MEM_MIB} MiB"
if [ "${HOST_MEM_MIB:-0}" -lt {{ min_host_mib }} ]; then
    die "{{ display_name }} needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml instance note."
fi

# ── [3/7] uv + the authors' repository + LIBERO (both pinned) ──────────
log "[3/7] Installing uv (DLAMI does not pre-install)..."
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh 2>&1 | tee /tmp/{{ vla }}_uv_install.log \
        || die "uv install failed"
fi
log "  $(uv --version)"

log "[3/7] Cloning {{ code_repo }} @ {{ code_commit[:8] }}..."
if [ ! -d "${CODE_DIR}/.git" ]; then
    git clone {{ code_repo }} "${CODE_DIR}" 2>&1 | tee /tmp/{{ vla }}_clone.log || die "code clone failed"
    git -C "${CODE_DIR}" checkout "{{ code_commit }}" || die "code: checkout pinned commit {{ code_commit[:8] }} failed"
fi
CODE_HEAD=$(git -C "${CODE_DIR}" rev-parse HEAD)
[ "${CODE_HEAD}" = "{{ code_commit }}" ] || die "code commit mismatch: expected {{ code_commit }}, got ${CODE_HEAD}"

log "[3/7] Cloning LIBERO @ {{ libero_commit[:8] }}..."
if [ ! -d "${LIBERO_DIR}/.git" ]; then
    git clone https://github.com/Lifelong-Robot-Learning/LIBERO.git "${LIBERO_DIR}" 2>&1 | tee -a /tmp/{{ vla }}_clone.log \
        || die "LIBERO clone failed"
    git -C "${LIBERO_DIR}" checkout "{{ libero_commit }}" || die "LIBERO: checkout pinned commit {{ libero_commit[:8] }} failed"
fi
LIBERO_HEAD=$(git -C "${LIBERO_DIR}" rev-parse HEAD)
[ "${LIBERO_HEAD}" = "{{ libero_commit }}" ] || die "LIBERO commit mismatch: expected {{ libero_commit }}, got ${LIBERO_HEAD}"
log "  code: ${CODE_HEAD}  LIBERO: ${LIBERO_HEAD}"

# ── [4/7] venv from the lock file (assets/libero/{{ requirements_name }}) + LIBERO, checked ──────────
log "[4/7] uv venv --python {{ python_version }} + lock install (~10-20 min)..."
REQ_FILE="${W}/{{ requirements_name }}"
base64 -d > "${REQ_FILE}" << 'REQEOF'
{{ requirements_b64 }}REQEOF
base64 -d > "${RUNNER}" << 'RUNNEREOF'
{{ runner_b64 }}RUNNEREOF
uv venv --python {{ python_version }} "${VENV_DIR}" 2>&1 | tee /tmp/{{ vla }}_venv.log || die "uv venv failed"
PY="${VENV_DIR}/bin/python"
export UV_HTTP_TIMEOUT=300
timeout 3600 uv pip install --python "${PY}" -r "${REQ_FILE}" 2>&1 | tee /tmp/{{ vla }}_pip.log \
    || die "lock install failed (see /tmp/{{ vla }}_pip.log)"
# LIBERO: editable WITHOUT dependencies (the lock holds what the eval imports; LIBERO's requirements.txt pins
# numpy 1.22 / transformers 4.21 for training). Namespace layout (libero/libero/ without a top-level __init__.py):
# the PEP 660 finder does not resolve `libero.libero`, so the legacy .pth editable mode is used.
timeout 900 uv pip install --python "${PY}" --no-deps -e "${LIBERO_DIR}" --config-settings editable_mode=compat \
    2>&1 | tee -a /tmp/{{ vla }}_pip.log || die "LIBERO install failed (see /tmp/{{ vla }}_pip.log)"

# Pre-create LIBERO's config.yaml so `import libero.libero` does not stop at an interactive input().
mkdir -p /root/.libero
LIBERO_PKG_DIR="${LIBERO_DIR}/libero/libero"
cat > /root/.libero/config.yaml << LIBEROCFG
assets: ${LIBERO_PKG_DIR}/assets
bddl_files: ${LIBERO_PKG_DIR}/bddl_files
benchmark_root: ${LIBERO_PKG_DIR}
datasets: ${LIBERO_PKG_DIR}/../datasets
init_states: ${LIBERO_PKG_DIR}/init_files
LIBEROCFG

export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export TOKENIZERS_PARALLELISM=false
{%- for k, v in env_vars.items() %}
export {{ k }}={{ v }}
{%- endfor %}
export PYTHONPATH="{% for p in pythonpath %}${CODE_DIR}/{{ p }}:{% endfor %}${CODE_DIR}"

log "[4/7] Verifying the venv (torch CUDA, imports, LIBERO task names, one EGL-rendered LIBERO env)..."
# Quoted heredoc: the JSON lists carry double quotes that bash would strip inside python -c "...".
# JSON text for jq / python, never word-split as arguments.
# shellcheck disable=SC2089
RUNS_JSON='{{ runs_json }}'
# shellcheck disable=SC2090
export RUNS_JSON
( cd "${CODE_DIR}" && "${PY}" - <<'PYCHECK' ) 2>&1 | tee /tmp/{{ vla }}_import_check.log \
    || die "venv check failed (see /tmp/{{ vla }}_import_check.log)"
import importlib, json, os
import torch
print('torch:', torch.__version__, 'cuda:', torch.version.cuda, 'available:', torch.cuda.is_available())
assert torch.cuda.is_available(), 'CUDA not visible to torch'
for m in {{ import_check_json }}:
    importlib.import_module(m)
    print('import OK:', m)
from libero.libero import benchmark
from libero.libero.envs import OffScreenRenderEnv
from libero.libero import get_libero_path
bench = benchmark.get_benchmark_dict()
for run in json.loads(os.environ['RUNS_JSON']):
    suite = bench[run['suite']]()
    names = [suite.get_task(int(i)).name for i in run['task_ids'].split(',')]
    assert names == run['expect_names'].split(','), (run['suite'], names)
    print('LIBERO tasks OK:', run['suite'], run['task_ids'])
first = json.loads(os.environ['RUNS_JSON'])[0]
suite = bench[first['suite']]()
tid = int(first['task_ids'].split(',')[0])
task = suite.get_task(tid)
init = suite.get_task_init_states(tid)  # torch.load of LIBERO's init file (weights_only default on torch >= 2.6)
env = OffScreenRenderEnv(bddl_file_name=os.path.join(get_libero_path('bddl_files'), task.problem_folder, task.bddl_file),
                         camera_heights=128, camera_widths=128)
env.seed(0)
env.reset()
obs = env.set_init_state(init[0])
print('LIBERO env OK (EGL):', task.name, obs['agentview_image'].shape, 'init states', len(init))
env.close()
PYCHECK
STACK_VERSIONS=$("${PY}" -c "
import importlib.metadata as m
out = []
for p in ('torch', 'transformers', 'diffusers', 'flash-attn', 'robosuite', 'mujoco', 'numpy'):
    try:
        out.append(f'{p}=={m.version(p)}')
    except m.PackageNotFoundError:
        pass
print(' '.join(out))
" 2>/dev/null || echo unknown)
log "  stack: ${STACK_VERSIONS}"

# ── [5/7] Weights (pinned revisions / sha256) into ${ASSETS_DIR} ──
# Xet / CDN stall guard: a wedged download emits nothing and returns nothing, so `|| die` never fires. Bound every
# fetch by wall clock and retry once (snapshot_download resumes from the partial cache; curl -C - resumes the file).
export HF_XET_CLIENT_READ_TIMEOUT=60
export HF_XET_CLIENT_CONNECT_TIMEOUT=30
export HF_XET_CLIENT_RETRY_MAX_DURATION=120
export HF_XET_FIXED_DOWNLOAD_CONCURRENCY=8
HF_DOWNLOAD_TIMEOUT_SECS=2700
hf_dl_guard() {
    local _label="$1" _log="$2"; shift 2
    [ "${1:-}" = "--" ] && shift
    local _attempt _rc
    for _attempt in 1 2; do
        _rc=0
        timeout --signal=TERM --kill-after=60 "${HF_DOWNLOAD_TIMEOUT_SECS}" "$@" < /dev/null >> "${_log}" 2>&1 || _rc=$?
        [ "${_rc}" -eq 0 ] && return 0
        echo "[hf-dl] ${_label} attempt ${_attempt} rc=${_rc} (wall-clock cap ${HF_DOWNLOAD_TIMEOUT_SECS}s)" >> "${_log}"
    done
    return 1
}
mkdir -p "${HF_CACHE_DIR}" "${ASSETS_DIR}"
{%- for d in downloads %}
{%- if d.kind == "hub" %}
log "[5/7] {{ d.repo }} (rev {{ d.revision[:8] }}) -> ${ASSETS_DIR}/{{ d.dir }}..."
hf_dl_guard "{{ d.repo }}" /tmp/{{ vla }}_download.log -- "${PY}" -c "
from huggingface_hub import snapshot_download
print('downloaded:', snapshot_download('{{ d.repo }}', revision='{{ d.revision }}', local_dir='${ASSETS_DIR}/{{ d.dir }}',
                                       allow_patterns={{ d.allow_patterns_py }}))
" || die "download failed: {{ d.repo }} (see /tmp/{{ vla }}_download.log)"
{%- else %}
log "[5/7] {{ d.file }} (sha256 {{ d.sha256[:12] }}) from {{ d.url.split('?')[0] }}..."
mkdir -p "$(dirname "${ASSETS_DIR}/{{ d.file }}")"
hf_dl_guard "{{ d.file }}" /tmp/{{ vla }}_download.log -- \
    curl -fL --retry 3 --retry-delay 10 -C - -o "${ASSETS_DIR}/{{ d.file }}" "{{ d.url }}" \
    || die "download failed: {{ d.file }} (see /tmp/{{ vla }}_download.log)"
echo "{{ d.sha256 }}  ${ASSETS_DIR}/{{ d.file }}" | sha256sum -c - 2>&1 | tee -a /tmp/{{ vla }}_download.log \
    || die "sha256 mismatch: {{ d.file }} (expected {{ d.sha256 }})"
{%- endif %}
{%- endfor %}
log "  weights: $(du -sh "${ASSETS_DIR}" 2>/dev/null | cut -f1)"

# ── [6/7] One runner call per suite run (the authors' loop); one summary per LIBERO task ──
mkdir -p "${EVAL_BASE_DIR}" "${VIDEO_BASE_DIR}"
TASKS_JSON='{{ tasks_json }}'
TASK_COUNT=$(echo "$TASKS_JSON" | jq length)
RUN_COUNT=$(echo "$RUNS_JSON" | jq length)
SUMMARY_ALL=""
log "[6/7] ${TASK_COUNT} task(s) in ${RUN_COUNT} run(s), {{ n_episodes_total }} episode(s) in total"
{%- for r in runs %}

# run {{ r.run }}: {{ r.suite }} tasks {{ r.task_ids }} x {{ r.n_episodes }} episodes
RUN_DIR="${EVAL_BASE_DIR}/run-{{ r.run }}"
rm -rf "${RUN_DIR}"
mkdir -p "${RUN_DIR}"
RUN_ARGS=(--adapter "{{ adapter }}" --code-dir "${CODE_DIR}" --suite "{{ r.suite }}" --task-ids "{{ r.task_ids }}"
    --expect-names "{{ r.expect_names }}" --n-episodes "{{ r.n_episodes }}" --out "${RUN_DIR}"
    {% for a in r.args %}"{{ a }}" {% endfor %})
log "[6/7] Run {{ r.run + 1 }}/${RUN_COUNT}: {{ r.suite }} tasks {{ r.task_ids }} x {{ r.n_episodes }} ep"
echo "python own_eval_runner.py ${RUN_ARGS[*]}" > "/tmp/{{ vla }}_run{{ r.run }}.log"
set +e
trap - ERR
( cd "${CODE_DIR}" && timeout 14400 "${PY}" "${RUNNER}" "${RUN_ARGS[@]}" ) >> "/tmp/{{ vla }}_run{{ r.run }}.log" 2>&1
RUN_RC=$?
set -e
trap '_trap_handler' ERR
log "  run {{ r.run }} exit=${RUN_RC}"
# The authors' loop catches per-episode exceptions (e.g. CUDA OOM) and scores them as failures; a run where any
# episode raised is not a measurement, so fail it instead of reporting 0% success.
N_EXC=$(grep -c 'Traceback (most recent call last)' "/tmp/{{ vla }}_run{{ r.run }}.log" || true)
if [ "${N_EXC:-0}" -gt 0 ]; then
    log "  ERROR: ${N_EXC} exception(s) inside the authors' loop: $(grep -m1 -E '^[A-Za-z_.]+(Error|Exception):' "/tmp/{{ vla }}_run{{ r.run }}.log" | cut -c1-200)"
    RUN_RC=97
fi
if [ "${RUN_RC}" -ne 0 ] || [ ! -f "${RUN_DIR}/results.json" ]; then
    aws s3 cp "/tmp/{{ vla }}_run{{ r.run }}.log" "s3://${S3_BUCKET}/${RUN_ID}/run-{{ r.run }}.log" --region "$REGION" || true
    die "run {{ r.run }} ({{ r.suite }}) failed (exit=${RUN_RC}) — see s3://${S3_BUCKET}/${RUN_ID}/run-{{ r.run }}.log"
fi
{%- endfor %}

for TASK_IDX in $(seq 0 $((TASK_COUNT - 1))); do
    TASK=$(echo "$TASKS_JSON" | jq -r ".[$TASK_IDX]")
    TASK_NAME=$(echo "$TASK" | jq -r '.env_name')
    SUITE=$(echo "$TASK" | jq -r '.suite')
    TID=$(echo "$TASK" | jq -r '.task_id')
    ACTION_TYPE=$(echo "$TASK" | jq -r '.action_type // "other"')   # task_sets.py tag, carried into summary.txt
    DESCRIPTION=$(echo "$TASK" | jq -r '.description // ""')
    N_EXPECTED=$(echo "$TASK" | jq -r '.n_episodes')
    RUN_K=$(echo "$RUNS_JSON" | jq -r --argjson i "$TASK_IDX" '.[] | select(.tasks | index($i)) | .run')
    RUN_DIR="${EVAL_BASE_DIR}/run-${RUN_K}"
    RES=$(jq -c --argjson t "$TID" '.tasks[] | select(.task_id == $t)' "${RUN_DIR}/results.json")
    [ -n "$RES" ] || die "task ${TASK_IDX} (${SUITE} ${TID}) missing from ${RUN_DIR}/results.json"
    N_SUCCESS=$(echo "$RES" | jq -r '.n_success')
    N_DONE=$(echo "$RES" | jq -r '.n_episodes')
    LANGUAGE=$(echo "$RES" | jq -r '.language')
    if [ "${N_DONE}" -gt 0 ]; then
        SR=$(awk -v k="${N_SUCCESS}" -v n="${N_DONE}" 'BEGIN{printf "%.3f", k/n}')
    else
        SR="unknown"
    fi
    VIDEO_DIR="${VIDEO_BASE_DIR}/task-${TASK_IDX}"
    rm -rf "${VIDEO_DIR}"
    mkdir -p "${VIDEO_DIR}"
    while IFS= read -r _v; do
        [ -n "$_v" ] && [ -f "${RUN_DIR}/videos/${_v}" ] && cp "${RUN_DIR}/videos/${_v}" "${VIDEO_DIR}/${_v}"
    done < <(echo "$RES" | jq -r '.episodes[].video')
    VIDEO_COUNT=$(find "${VIDEO_DIR}" -name "*.mp4" 2>/dev/null | wc -l)
    log "  ${TASK_NAME}: ${N_SUCCESS}/${N_DONE} success (expected ${N_EXPECTED} episodes), success_rate=${SR}"

    {
        echo "model: {{ vla }}"
        echo "checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] }}"
        echo "code: {{ code_repo }}@{{ code_commit[:8] }}"
        echo "eval: {{ eval_label }} (assets/libero/own_eval_runner.py --adapter {{ adapter }})"
        echo "suite: ${SUITE}"
        echo "task_id: ${TID}"
        echo "env_name: ${TASK_NAME}"
        echo "instruction: ${LANGUAGE}"
        echo "action_type: ${ACTION_TYPE}"
        echo "n_episodes_per_task: ${N_EXPECTED}"
        echo "success_rate: ${SR}"
        echo "n_success: ${N_SUCCESS}"
        echo "n_episodes: ${N_DONE}"
        echo "init_states: LIBERO fixed init states 0-$((N_EXPECTED - 1))"
        echo "condition: S0"
        echo "stack_code_commit: ${CODE_HEAD}"
        echo "stack_libero_commit: ${LIBERO_HEAD}"
        echo "stack_versions: ${STACK_VERSIONS}"
        echo "stack_gpu: ${GPU_NAME}"
        echo "stack_eval_args: $(head -1 "/tmp/{{ vla }}_run${RUN_K}.log")"
        echo "description: ${DESCRIPTION}"
    } > "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt"

    S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}"
    log "  S3 upload: ${S3_TASK_PREFIX}"
    UPLOAD_COUNT=0
    while IFS= read -r mp4_file || [[ -n "$mp4_file" ]]; do
        [ -f "$mp4_file" ] || continue
        fname=$(basename "$mp4_file")
        base="${fname%.mp4}"
        txt_file="/tmp/{{ vla }}_ctx_task${TASK_IDX}_ep${UPLOAD_COUNT}.txt"
        {
            echo "=== {{ display_name }} Simulation Context ==="
            printf "Video:      %s\n"  "${fname}"
            printf "Date:       %s\n"  "$(date '+%Y-%m-%d')"
            echo ""
            echo "--- Environment ---"
            printf "Task:       %s (%s task %s)\n" "${TASK_NAME}" "${SUITE}" "${TID}"
            printf "Instruction: %s\n" "${LANGUAGE}"
            printf "Robot:      %s\n" "Franka Panda (LIBERO)"
            printf "Simulator:  %s\n" "LIBERO (robosuite + MuJoCo, headless EGL)"
            printf "Action:     %s\n" "${ACTION_TYPE}"
            echo ""
            echo "--- Model ---"
            printf "Checkpoint: %s (rev %s)\n" "{{ hf_repo }}" "{{ hf_model_revision[:8] }}"
            printf "Code:       %s@%s\n" "{{ code_repo }}" "{{ code_commit[:8] }}"
            printf "License:    %s\n" "{{ license }}"
            echo ""
            echo "--- Rollout ---"
            printf "run_id:        %s\n"  "${RUN_ID}"
            printf "task_idx:      %s\n"  "${TASK_IDX}"
            printf "task_success:  %s (%s of %s episodes)\n" "${SR}" "${N_SUCCESS}" "${N_DONE}"
            echo ""
            echo "--- Infrastructure ---"
            printf "Instance: %s (%s)\n"  "${INSTANCE_ID}" "${INSTANCE_TYPE}"
            printf "Region:   %s\n"  "${REGION}"
            printf "Stack:    %s (CDK)\n" "${STACK_NAME}"
        } > "$txt_file"
        if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" \
            --region "$REGION" >> /var/log/{{ vla }}-userdata.log 2>&1; then
            UPLOAD_COUNT=$((UPLOAD_COUNT+1))
            aws s3 cp "$txt_file" "${S3_TASK_PREFIX}/videos/${base}.txt" \
                --region "$REGION" 2>/dev/null || true
        else
            log "  [warn] Upload failed: $fname"
        fi
    done < <(find "$VIDEO_DIR" -name "*.mp4" 2>/dev/null | sort)
    log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"

    aws s3 cp "/tmp/{{ vla }}_run${RUN_K}.log" \
        "${S3_TASK_PREFIX}/eval.log" --region "$REGION" || true
    [ -f "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" ] && \
        aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" \
        "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true
    {% from "_protocol-card.sh.j2" import protocol_card with context %}{{ protocol_card('"/tmp/' ~ vla ~ '_task${TASK_IDX}_summary.txt"', '"${S3_TASK_PREFIX}"') }}

    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${TASK_NAME} (${SUITE}, ${ACTION_TYPE}) — ${N_SUCCESS}/${N_DONE} success (success_rate=${SR})"
    log "  Task $((TASK_IDX+1)) done"

    if [ "${N_DONE}" -ne "${N_EXPECTED}" ]; then
        die "Task ${TASK_IDX} ran ${N_DONE} episodes, expected ${N_EXPECTED} — see s3://${S3_BUCKET}/${RUN_ID}/task-${TASK_IDX}/eval.log"
    fi
    if [ "${VIDEO_COUNT}" -ne "${N_DONE}" ]; then
        log "  [warn] ${VIDEO_COUNT} videos for ${N_DONE} episodes (an episode that raised before its first step has no frames)"
    fi
done

# ── [7/7] SNS notification + cfn-signal ──────────────────────────
log "[7/7] Sending SNS notification..."

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} simulation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}

Model: {{ policy_desc }}
Checkpoint: {{ hf_repo }}@{{ hf_model_revision[:8] }}
Code: {{ code_repo }}@{{ code_commit[:8] }} (LIBERO @{{ libero_commit[:8] }})
License: {{ license }}
Simulation: LIBERO (robosuite + MuJoCo, headless EGL), {{ eval_label }}
Instance: ${INSTANCE_TYPE}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} simulation complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

log "[7/7] Sending cfn-signal..."
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

#!/bin/bash
# OpenVLA-OFT 1-Click UserData Script (LIBERO sim, local mode only)
# Suite: {{ task_suite_name }}   Checkpoint: {{ hf_repo }} (rev {{ hf_model_revision[:8] if hf_model_revision else 'unpinned' }})
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla openvla-oft --libero-suite {{ libero_suite }}
#
# CloudFormation Fn::Sub placeholders (resolved at deploy time):
#   ${S3BucketName}       — results S3 bucket
#   ${SnsTopicArn}        — completion notification SNS topic
#   ${StackName}          — CDK stack name
#   ${WaitConditionUrl}   — CFN WaitConditionHandle presigned URL
#   ${Region}             — deployment region
#   ${AutoTerminate}      — "true" to auto-terminate EC2 after completion

set -euo pipefail

OFT_DIR=/home/ubuntu/openvla-oft
LIBERO_DIR=/home/ubuntu/LIBERO
MINICONDA_DIR=/opt/miniconda3
CONDA_ENV=openvla-oft
VIDEO_BASE_DIR=/tmp/openvla-oft-videos
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

export HOME=/root
export HF_HOME=/home/ubuntu/.cache/huggingface
export TRANSFORMERS_CACHE=/home/ubuntu/.cache/huggingface/hub

log() { echo "[OFT] $(date '+%H:%M:%S') $*" | tee -a /var/log/openvla-oft-userdata.log; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status → WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a /var/log/openvla-oft-userdata.log \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

die() {
    log "ERROR: $*"
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== OpenVLA-OFT UserData start (RUN_ID: ${RUN_ID}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [1/6] System dependencies ──────────────────────────────────────
log "[1/6] Installing system packages..."
export DEBIAN_FRONTEND=noninteractive

systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl disable unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
pkill -9 -f "apt-get" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a 2>&1 | tee /tmp/oft_dpkg_fix.log || true

# Boot hardening (2026-10): the command-not-found apt hook hung apt-get update for 3 h on a g6e, and the
# apt-daily timers re-launch unattended-upgrades mid-boot (held the dpkg lock past 5 min). Drop / mask both.
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 2>&1 | tee /tmp/oft_apt_update.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    log "[warn] apt-get update failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    git git-lfs curl ca-certificates awscli jq \
    libgl1-mesa-glx libegl1 libgles2 \
    libglib2.0-0 libsm6 libxext6 libxrender1 \
    ffmpeg build-essential \
    2>&1 | tee /tmp/oft_apt.log; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    log "[warn] apt-get install failed (attempt $APT_RETRY), retrying in 30s..."
    sleep 30
done

# ── [1.5/6] CloudWatch Logs agent setup ──────────────────────────
log "[1.5/6] Setting up CloudWatch Logs agent..."
CW_LOG_GROUP="/openvla-oft/userdata"
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/openvla-oft-userdata.log",
            "log_group_name": "/openvla-oft/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
        -s 2>&1 | tee /tmp/oft_cwagent.log \
        && log "  CW agent started (log group: ${CW_LOG_GROUP})" \
        || log "[warn] CW agent start failed — logs local only"
else
    log "[warn] amazon-cloudwatch-agent not found — logs local only"
fi

# ── [2/6] NVIDIA driver check ──────────────────────────────────────
log "[2/6] Checking GPU driver..."
nvidia-smi -L 2>&1 | tee /tmp/oft_nvidia.log \
    || log "[warn] nvidia-smi failed — verify DLAMI (continuing with EGL headless)"

# ── [3/6] Miniconda + openvla-oft clone ────────────────────────────
log "[3/6] Installing Miniconda..."
if [ ! -d "${MINICONDA_DIR}" ]; then
    curl -sSL https://repo.anaconda.com/miniconda/Miniconda3-py310_24.7.1-0-Linux-x86_64.sh \
        -o /tmp/miniconda.sh 2>&1 | tee /tmp/oft_miniconda_dl.log \
        || die "Miniconda download failed"
    bash /tmp/miniconda.sh -b -p "${MINICONDA_DIR}" \
        2>&1 | tee /tmp/oft_miniconda_install.log \
        || die "Miniconda install failed"
fi
export PATH="${MINICONDA_DIR}/bin:${PATH}"
log "  $(conda --version)"

log "[3/6] Cloning openvla-oft (pinned: {{ oft_commit[:8] if oft_commit else 'HEAD' }})..."
if [ ! -d "${OFT_DIR}" ]; then
    git clone https://github.com/moojink/openvla-oft.git "${OFT_DIR}" \
        2>&1 | tee /tmp/oft_clone.log \
        || die "openvla-oft clone failed"
{%- if oft_commit %}
    git -C "${OFT_DIR}" checkout "{{ oft_commit }}" \
        || die "openvla-oft: checkout pinned commit {{ oft_commit[:8] }} failed"
{%- endif %}
    log "  Commit: $(git -C "${OFT_DIR}" rev-parse HEAD)"
else
    log "  openvla-oft already exists, skipping"
fi

# Create conda env (python 3.10.14)
log "[3/6] Creating conda env '${CONDA_ENV}' (python 3.10)..."
if ! conda env list | grep -q "^${CONDA_ENV} "; then
    conda create -y -n "${CONDA_ENV}" python=3.10.14 \
        2>&1 | tee /tmp/oft_conda_create.log \
        || die "conda env create failed"
fi

# Activate env (source activate instead of conda activate, for non-interactive shell)
# shellcheck disable=SC1091
source "${MINICONDA_DIR}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}" || die "conda activate ${CONDA_ENV} failed"
log "  Python: $(python --version) @ $(which python)"

# Install PyTorch 2.2.0 (pinned per pyproject.toml)
log "[3/6] Installing PyTorch 2.2.0 + CUDA 12.1..."
pip install --no-cache-dir \
    torch==2.2.0 torchvision==0.17.0 torchaudio==2.2.0 \
    --index-url https://download.pytorch.org/whl/cu121 \
    2>&1 | tee /tmp/oft_torch.log \
    || die "torch install failed"

# openvla-oft editable install (pulls transformers fork + many deps including tensorflow==2.15)
log "[3/6] pip install -e openvla-oft (~10 min)..."
cd "${OFT_DIR}"
pip install --no-cache-dir -e . \
    2>&1 | tee /tmp/oft_pip_install.log \
    || die "openvla-oft pip install failed (see /tmp/oft_pip_install.log)"

# FIX 15 — tensorflow-metadata resolves to a version whose code needs a protobuf this stack
# cannot have. `pip install -e .` pulls tensorflow==2.15.0, which caps protobuf below 5
# (`protobuf>=3.20.3,<5.0.0dev`) → 4.25.9. tensorflow_datasets==4.9.3 then depends on
# tensorflow-metadata with NO upper bound, so the resolver takes the newest — 1.21.0 — whose
# declaration (`protobuf>=4.21.6,<=6.32` on py<3.11) is satisfied by 4.25.9, so pip reports no
# conflict. But its generated code imports `google.protobuf.runtime_version`, which does not
# exist before protobuf 5.26: the declared floor understates what the code needs, so the
# breakage only appears at import time — the [3/6] prismatic check below dies with
# `ImportError: cannot import name 'runtime_version' from 'google.protobuf'`.
#
# Pin tensorflow-metadata instead of moving protobuf: tf 2.15 blocks any protobuf that has
# runtime_version, and downgrading protobuf to 3.20.x instead breaks wandb (current releases
# dropped protobuf 3.x — `cannot import name 'Imports' from wandb.proto.wandb_telemetry_pb2`).
# 1.17.3 is the newest release that predates the runtime_version import: its gencode targets
# protobuf 4.25.6 (≤ the 4.25.9 runtime) and its declaration holds on 4.25.9, so no --no-deps
# is needed and a later resolve cannot reintroduce the mismatch. Verified by unpacking the
# wheels: 1.17.3 has zero runtime_version references, 1.21.0 has seven.
log "[3/6] FIX 15: pinning tensorflow-metadata=={{ tfmd_version if tfmd_version else '1.17.3' }} (runtime_version import vs protobuf 4.25)..."
pip install --no-cache-dir "tensorflow-metadata=={{ tfmd_version if tfmd_version else '1.17.3' }}" \
    2>&1 | tee /tmp/oft_fix15_tfmd.log \
    || die "FIX 15: tensorflow-metadata pin failed (see /tmp/oft_fix15_tfmd.log)"
python -c "
import importlib.metadata as m
tfmd, pb = m.version('tensorflow-metadata'), m.version('protobuf')
print('tensorflow-metadata:', tfmd, '/ protobuf:', pb)
assert tfmd == '{{ tfmd_version if tfmd_version else '1.17.3' }}', 'FIX 15: tfmd pin did not stick: ' + tfmd
" 2>&1 | tee -a /tmp/oft_fix15_tfmd.log \
    || die "FIX 15: tensorflow-metadata not at the pinned version after install"

# Verify openvla-oft install — prismatic must import before LIBERO reqs pollute numpy.
# (We re-verify after LIBERO install in [4/6] below.)
python -c "import prismatic; print('prismatic OK:', prismatic.__file__)" \
    2>&1 | tee /tmp/oft_import_check_stage1.log \
    || die "prismatic import failed after openvla-oft install (see /tmp/oft_import_check_stage1.log)"

# FlashAttention 2 (prebuilt wheel — fast) — required for parallel decoding attention
log "[3/6] Installing FlashAttention 2 (flash-attn==2.5.5)..."
pip install --no-cache-dir packaging ninja 2>&1 | tee /tmp/oft_ninja.log || true
pip install --no-cache-dir "flash-attn==2.5.5" --no-build-isolation \
    2>&1 | tee /tmp/oft_flash_attn.log \
    || log "[warn] flash-attn install failed — eval may fail or run slower (continuing)"

# ── [4/6] LIBERO repo clone + install ──────────────────────────────
{%- if libero_plus %}
# --libero-variant plus: the LIBERO-Plus fork (same `libero` package, ~2,400 perturbed variants per suite)
# is installed in place of LIBERO; its asset pack is fetched after the checkpoint in [5/6].
log "[4/6] Cloning LIBERO-Plus @ {{ libero_plus.repo_commit[:8] }} (in place of LIBERO)..."
if [ ! -d "${LIBERO_DIR}" ]; then
    git clone {{ libero_plus.repo_url }} "${LIBERO_DIR}" \
        2>&1 | tee /tmp/oft_libero_clone.log \
        || die "LIBERO-Plus clone failed"
    git -C "${LIBERO_DIR}" checkout "{{ libero_plus.repo_commit }}" \
        || die "LIBERO-Plus: checkout pinned commit {{ libero_plus.repo_commit[:8] }} failed"
fi
{%- else %}
log "[4/6] Cloning LIBERO repo..."
if [ ! -d "${LIBERO_DIR}" ]; then
    git clone https://github.com/Lifelong-Robot-Learning/LIBERO.git "${LIBERO_DIR}" \
        2>&1 | tee /tmp/oft_libero_clone.log \
        || die "LIBERO clone failed"
{%- if libero_commit and libero_commit != "master" %}
    git -C "${LIBERO_DIR}" checkout "{{ libero_commit }}" \
        || die "LIBERO: checkout {{ libero_commit }} failed"
{%- endif %}
fi
{%- endif %}
log "  LIBERO commit: $(git -C "${LIBERO_DIR}" rev-parse HEAD)"

log "[4/6] pip install -e LIBERO + libero_requirements.txt..."
# LIBERO uses namespace-package layout (libero/libero/ with no top-level __init__.py).
# Modern pip editable installs (PEP 660 finder) fail to resolve `libero.libero` from this layout,
# so force the legacy .pth-based editable mode which works.
pip install --no-cache-dir -e "${LIBERO_DIR}" --config-settings editable_mode=compat \
    2>&1 | tee /tmp/oft_libero_install.log \
    || die "LIBERO pip install failed"
pip install --no-cache-dir -r "${OFT_DIR}/experiments/robot/libero/libero_requirements.txt" \
    2>&1 | tee /tmp/oft_libero_reqs.log \
    || die "libero_requirements.txt install failed"

# libero_requirements.txt pulls opencv-python which upgrades numpy to 2.x,
# breaking tensorflow==2.15 (numpy<2) and torch 2.2.0 (compiled vs numpy 1.x) ABI.
# Pin numpy<2 as the final step so tf/torch remain functional.
log "[4/6] Pinning numpy<2 (tensorflow 2.15 + torch 2.2.0 ABI compatibility)..."
pip install --no-cache-dir --force-reinstall "numpy<2" \
    2>&1 | tee /tmp/oft_numpy_pin.log \
    || die "numpy<2 pin failed"

# FIX 14 — mujoco unpinned in the LIBERO dependency chain (same root cause as gr00t).
# libero_requirements.txt pins robosuite==1.4.1 but NOT mujoco, and robosuite declares only
# `mujoco>=2.3.0`, so the resolver takes the newest release. mujoco 3.10.0 (2026-06-22) changed
# the mj_fullM signature from mj_fullM(m, dst, M) to mj_fullM(m, d, dst) (mujoco changelog,
# "Breaking API changes") while robosuite still calls the legacy form at
# robosuite/controllers/base_controller.py:156 — unchanged through v1.5.1. Unlike gr00t, this
# target's install has no env-creation check, so nothing fails here: the breakage first appears
# ~9 min into run_libero_eval.py, once a controller builds its mass matrix, by which point the
# checkpoint download and eval startup have already been paid for. Pinned alongside numpy for
# the same reason — it is the last thing that can be dragged forward by an earlier install.
log "[4/6] FIX 14: pinning mujoco ({{ sim_protect_pins if sim_protect_pins else 'mujoco==3.3.1' }}) — mj_fullM compat, same fix as gr00t..."
pip install --no-cache-dir {{ sim_protect_pins if sim_protect_pins else 'mujoco==3.3.1' }} \
    2>&1 | tee /tmp/oft_fix14_mujoco.log \
    || die "FIX 14: mujoco pin failed (see /tmp/oft_fix14_mujoco.log)"

# FIX 15 (re-pin) — libero_requirements.txt resolves tensorflow-datasets again, which can pull
# tensorflow-metadata back up to the version that imports runtime_version. Re-assert the pin
# here for the same reason numpy is re-pinned above, and re-verify it stuck.
log "[4/6] FIX 15: re-pinning tensorflow-metadata=={{ tfmd_version if tfmd_version else '1.17.3' }} after LIBERO reqs..."
pip install --no-cache-dir "tensorflow-metadata=={{ tfmd_version if tfmd_version else '1.17.3' }}" \
    2>&1 | tee /tmp/oft_fix15_tfmd_repin.log \
    || die "FIX 15: tensorflow-metadata re-pin failed (see /tmp/oft_fix15_tfmd_repin.log)"
python -c "
import importlib.metadata as m
import mujoco
print('mujoco:', mujoco.__version__,
      '/ tensorflow-metadata:', m.version('tensorflow-metadata'),
      '/ protobuf:', m.version('protobuf'))
assert tuple(int(p) for p in mujoco.__version__.split('.')[:2]) < (3, 10), \
    'FIX 14: mujoco pin did not stick: ' + mujoco.__version__
assert m.version('tensorflow-metadata') == '{{ tfmd_version if tfmd_version else '1.17.3' }}', \
    'FIX 15: tfmd re-pin did not stick: ' + m.version('tensorflow-metadata')
" 2>&1 | tee /tmp/oft_fix14_15_verify.log \
    || die "FIX 14/15: pinned versions not in effect after LIBERO install (see /tmp/oft_fix14_15_verify.log)"

# Pre-create LIBERO config.yaml so `from libero.libero import ...` doesn't hit interactive input() on first import.
log "[4/6] Pre-creating LIBERO config.yaml..."
mkdir -p /root/.libero
LIBERO_PKG_DIR="${LIBERO_DIR}/libero/libero"
cat > /root/.libero/config.yaml << LIBEROCFG
assets: ${LIBERO_PKG_DIR}/assets
bddl_files: ${LIBERO_PKG_DIR}/bddl_files
benchmark_root: ${LIBERO_PKG_DIR}
datasets: ${LIBERO_PKG_DIR}/../datasets
init_states: ${LIBERO_PKG_DIR}/init_files
LIBEROCFG
log "  LIBERO config: /root/.libero/config.yaml"

{%- if libero_plus %}
# LIBERO-Plus: the fork's `libero` package imports Wand (ImageMagick) at import time, so its system package and
# pip pins must be in place before the import check below (the full fork setup runs in [5.5/6]; repeating the
# apt/pip install there is a no-op). First GPU run without this died here with "No module named 'wand'".
log "[4/6] LIBERO-Plus: ImageMagick + {{ libero_plus.pip_pins }} before the import check..."
apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 libmagickwand-dev \
    2>&1 | tee /tmp/oft_lp_apt_early.log || die "LIBERO-Plus: apt-get install libmagickwand-dev failed"
pip install --no-cache-dir {{ libero_plus.pip_pins }} 2>&1 | tee /tmp/oft_lp_pip_early.log \
    || die "LIBERO-Plus: early pip pins failed (see /tmp/oft_lp_pip_early.log)"
{%- endif %}

# Final import verification — all required modules must load before we proceed to eval.
log "[4/6] Verifying imports (libero, prismatic, tensorflow, torch, numpy)..."
python -c "
from libero.libero import benchmark
import prismatic
import tensorflow as tf, torch, numpy as np
print('libero:', benchmark.__file__)
print('prismatic:', prismatic.__file__)
print('tf:', tf.__version__, 'torch:', torch.__version__, 'numpy:', np.__version__)
" 2>&1 | tee /tmp/oft_import_check_stage2.log \
    || die "Post-install import check failed (see /tmp/oft_import_check_stage2.log)"

# ── [5/6] Pre-download HF checkpoint + run eval ───────────────────
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
# ── XET STALL GUARD: bound stalled Xet downloads in [5/6] ────────────────────────
# moojink/openvla-7b-oft-finetuned-libero-10 is 15.94GB across 9 Xet-backed files of
# 25 (measured); the other three suite checkpoints share the same layout.
# Xet-backed blobs are fetched by the hf_xet Rust client rather than huggingface_hub's
# python http_get, so HF_HUB_DOWNLOAD_TIMEOUT does NOT apply to them; only the
# HF_XET_CLIENT_* knobs below do.
#
# This target installs into a conda env with no lockfile, so the resolved hf-xet floats.
# Whatever hf_xet the conda env resolves, every release before 1.5.2 computes its retry
# delays as ExponentialBackoff::from_millis(self.base_delay), using base_delay as both the
# first delay and the per-step multiplier: 3s -> 9000s (2.5h) -> 7500h. The first retry after
# a stalled socket therefore sleeps ~2.5h and is indistinguishable from a permanent hang
# (1.5.0 and 1.5.1 still carry it; 1.5.2 is the first release with the fix, and it also
# raises the default read_timeout 120s -> 300s). On the buggy versions RETRY_MAX_DURATION is
# dead config (parsed, never consulted), so the bump below is what shortens the retry sleep.
export HF_XET_CLIENT_READ_TIMEOUT=60
export HF_XET_CLIENT_CONNECT_TIMEOUT=30
export HF_XET_CLIENT_RETRY_MAX_DURATION=120
export HF_XET_FIXED_DOWNLOAD_CONCURRENCY=8

# hf-xet is a transitive dep of huggingface_hub, not a direct one, so it cannot be held by a
# project pin — install it into the active conda env directly. There is no uv here and no
# lockfile to re-sync, so nothing can silently revert this. Non-fatal: if the bump fails, the
# exports above plus the wall-clock guard below still bound the fetch.
log "[5/6] XET STALL GUARD: raising hf-xet to 1.5.2 in the ${CONDA_ENV} env..."
python -m pip install "hf-xet==1.5.2" >> /tmp/oft_hfxet_bump.log 2>&1 \
    || log "[warn] hf-xet bump failed — exports + wall-clock guard still apply"
python -c "
from huggingface_hub.utils._runtime import get_xet_version, is_xet_available
print('hf_xet:', get_xet_version(), 'xet path active:', is_xet_available())
" 2>&1 | tail -2 | while IFS= read -r _l; do log "  ${_l}"; done

# Wall-clock guard. A wedged Xet download emits nothing and returns nothing, so `|| die`
# can never fire; without `timeout` the instance burns GPU until the CreationPolicy expires
# (measured on a sibling target: 26+ min of zero cache growth, every CDN socket in
# CLOSE-WAIT, all worker threads in futex_wait). Retry once — a dead CDN connection
# recovers in a fresh process and snapshot_download resumes from the partial cache.
#
# Guard chatter goes to the log file only, NEVER stdout: sibling call sites capture the
# resolved snapshot path via VAR=$(... | tail -1), so a warning on stdout would be captured
# as the path. Callers piping a heredoc must pass --stdin, because the first attempt
# consumes stdin and a naive retry re-runs python with EMPTY input and exits 0 — reporting
# success having downloaded nothing (measured). Auto-detecting stdin via `[ ! -t 0 ]` is
# wrong: inside $( ) stdin is not a tty even with no heredoc, so the guard would block on
# `cat` forever. Hence the explicit flag.
HF_DOWNLOAD_TIMEOUT_SECS=2700
hf_dl_guard() {
    local _label="$1" _log="$2"; shift 2
    local _stdin=""
    if [ "${1:-}" = "--stdin" ]; then _stdin="$(mktemp)"; cat > "${_stdin}"; shift; fi
    [ "${1:-}" = "--" ] && shift
    local _attempt _rc
    for _attempt in 1 2; do
        _rc=0
        if [ -n "${_stdin}" ]; then
            timeout --signal=TERM --kill-after=60 "${HF_DOWNLOAD_TIMEOUT_SECS}" "$@" < "${_stdin}" || _rc=$?
        else
            timeout --signal=TERM --kill-after=60 "${HF_DOWNLOAD_TIMEOUT_SECS}" "$@" < /dev/null || _rc=$?
        fi
        if [ "${_rc}" -eq 0 ]; then [ -n "${_stdin}" ] && rm -f "${_stdin}"; return 0; fi
        { echo "[hf-dl] ${_label} attempt ${_attempt} rc=${_rc} (wall-clock cap ${HF_DOWNLOAD_TIMEOUT_SECS}s)"
          [ "${_attempt}" -eq 1 ] && echo "[hf-dl] retrying ${_label} (resumes from the partial HF cache)"
        } >> "${_log}" 2>/dev/null || true
    done
    [ -n "${_stdin}" ] && rm -f "${_stdin}"
    return 1
}

mkdir -p "${HF_HOME}"

{% if hf_model_revision %}
log "[5/6] Pre-downloading HF checkpoint {{ hf_repo }} (rev {{ hf_model_revision[:8] }})..."
hf_dl_guard "checkpoint download" /tmp/oft_hf_download.log \
    -- python -c "
from huggingface_hub import snapshot_download
path = snapshot_download('{{ hf_repo }}', revision='{{ hf_model_revision }}')
print(path)
" || die "HF checkpoint download failed (see /tmp/oft_hf_download.log)"
{% else %}
log "[5/6] HF revision not pinned — run_libero_eval.py will download on demand"
{% endif %}
{%- if libero_plus %}
{% with lp=libero_plus, lp_step="5.5/6", lp_log="oft", lp_venv_mode="conda", lp_python="python",
        lp_pip="pip install --no-cache-dir" %}{% include "_libero-plus-setup.sh.j2" %}{% endwith %}
cat > /tmp/lp_oft_task_ids_patch.py <<'LPPATCH_EOF'
{{ libero_plus.oft_patch_py }}LPPATCH_EOF
{%- endif %}
{%- if libero_r2s %}
{% with r2s=libero_r2s, r2s_step="5.5/6", r2s_log="oft", r2s_pkg="${LIBERO_DIR}/libero/libero" %}{% include "_libero-r2s-setup.sh.j2" %}{% endwith %}
# Physics check before any GPU time is spent on the policy: each replaced object must rest where the stock one
# rested on the task's first initial state (no renderer; EGL is only imported).
r2s_check() {
    log "[5.5/6] LIBERO-R2S: physics check of the swapped scenes (tasks ${R2S_TASK_IDS})..."
    python "${R2S_WORK}/bin/check_scene.py" --suite {{ libero_r2s.suite }} --tasks "${R2S_TASK_IDS}" \
        --dirs "stable_hope_objects{% for m in libero_r2s.modes %},stable_hope_objects_r2s_{{ m }}{% endfor %}" \
        --objects "${R2S_OBJECTS}" --out "${R2S_WORK}/check.json" --unstable-out "${R2S_WORK}/unstable.txt" \
        2>&1 | tee -a /tmp/oft_r2s_check.log
    return "${PIPESTATUS[0]}"
}
r2s_stabilise
R2S_CONDS=""

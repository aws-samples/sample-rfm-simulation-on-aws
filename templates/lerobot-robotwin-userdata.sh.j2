# leaves only "Segmentation fault" (first lingbot-vla2 run with a working Warp).
( cd "${ROBOTWIN_DIR}" && PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1 "${VENV_PY}" - << 'VERIFYEOF' ) 2>&1 | tee /tmp/{{ vla }}_import_check.log \
    || die "eval-chain verify failed (see /tmp/{{ vla }}_import_check.log)"
import importlib, json, os
import numpy as np
import torch
print("torch:", torch.__version__, "cuda:", torch.version.cuda, "available:", torch.cuda.is_available())
assert torch.cuda.is_available(), "CUDA not visible to torch"
print("numpy:", np.__version__)
for mod in ("pyarrow", "datasets", "sapien", "sapien.core", "mplib", "mplib.sapien_utils", "toppra",
            "transforms3d", "trimesh", "open3d", "h5py", "imageio", "cv2", "yaml",
            "curobo", "curobo.types.math", "curobo.wrap.reacher.motion_gen",
            "lerobot.scripts.lerobot_eval", "lerobot.envs.robotwin", "lerobot.envs.factory",
            "lerobot.policies.factory", "lerobot.policies.{{ policy_module }}",
            "lerobot.policies.{{ policy_module }}.modeling_{{ policy_module }}",
            "lerobot.policies.{{ policy_module }}.processor_{{ policy_module }}",
            "envs", "envs.robot.planner", "envs.robot.robot", "envs.camera.camera",
            "description.utils.generate_episode_instructions"):  # blocks_ranking_* official instructions
    importlib.import_module(mod)
    print("import OK:", mod)
import envs.robot.planner as planner
# planner.py swallows a failed CuRobo import and leaves CuroboPlanner undefined -> the error would only
# show up at the first reset() as an ImportError deep inside RoboTwin.
assert hasattr(planner, "CuroboPlanner"), "envs.robot.planner has no CuroboPlanner (CuRobo import failed)"
from lerobot.envs.configs import RoboTwinEnvConfig
from lerobot.envs.robotwin import RoboTwinEnv, _load_robotwin_task
tasks = json.loads(os.environ["RFM_PLAN_TASKS"])
for t in tasks:
    _load_robotwin_task(t)
print("task modules OK:", len(tasks))
RoboTwinEnvConfig(task=",".join(tasks))
env = RoboTwinEnv(task_name=tasks[0], episode_length=2)
obs, info = env.reset(seed=int(os.environ["RFM_PLAN_SEED"]))
for cam, img in obs["pixels"].items():
    print("camera", cam, img.shape, "mean", float(img.mean()))
    assert img.shape == (240, 320, 3), f"{cam}: unexpected shape {img.shape}"
assert any(float(i.mean()) > 1.0 for i in obs["pixels"].values()), "all cameras rendered black (Vulkan?)"
obs, r, term, trunc, info = env.step(obs["agent_pos"].astype(np.float32))  # hold the current pose

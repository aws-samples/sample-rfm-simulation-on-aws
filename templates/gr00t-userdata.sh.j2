git submodule update --init --recursive external_dependencies/SimplerEnv \
    2>&1 | tee /tmp/gr00t_submodule.log \
    || { tail -50 /tmp/gr00t_submodule.log | while IFS= read -r line; do log "  [submodule] $line"; done; die "SimplerEnv submodule init failed"; }
[ -d external_dependencies/SimplerEnv/ManiSkill2_real2sim ] \
    || die "SimplerEnv submodule has no ManiSkill2_real2sim (nested submodule not populated)"
log "  [3/6] SimplerEnv submodule OK: $(git -C external_dependencies/SimplerEnv rev-parse --short HEAD)"

# setup_SimplerEnv.sh: py3.10 uv venv at gr00t/eval/sim/SimplerEnv/simpler_uv/.venv, editable
# ManiSkill2_real2sim + SimplerEnv, gr00t (--no-deps), then a gym.make + reset sanity check on a

#!/bin/bash
# RoboLab 1-Click UserData Script: {{ display_name }} (variant {{ variant }})
# Benchmark:  NVIDIA RoboLab {{ robolab_commit[:8] }} (Isaac Lab, DROID Franka) on nvcr.io/nvidia/isaac-lab:{{ isaac_lab_tag.split('@')[0] }}
# Policy:     {{ policy_label }} — server {{ server_repo }} @ {{ server_commit[:8] }}
# Protocol:   {{ label }} — {{ tasks|length if tasks else 'all' }} task(s) x {{ num_envs * num_runs }} episode(s), instructions: {{ instruction_type }}
# Pattern:    RoboLab server-client on ONE instance. Per shard: one policy-server container (port 8000+i)
#             and one RoboLab container (Isaac Sim, headless) on {{ gpus_per_shard }} GPU(s); tasks are
#             split round-robin over up to {{ shards }} shard(s), shards run in parallel.
# Generated by generate.py (RFM Simulation on AWS)
# DO NOT EDIT MANUALLY — regenerate with:
#   python generate.py --vla {{ vla }}
#
# Bootstrap-exported env vars (set by cdk/lib/vla-simulator-stack.ts via Fn::Sub):
#   ${S3BucketName} ${SnsTopicArn} ${StackName} ${WaitConditionUrl} ${Region} ${AutoTerminate}

set -euo pipefail

WORK=/opt/{{ vla }}
ROBOLAB_DIR="${WORK}/RoboLab"
SERVER_DIR="${WORK}/policy-server"
OUT_DIR="${WORK}/out"
CACHE_DIR="${WORK}/cache"
HF_CACHE="${CACHE_DIR}/huggingface"
STATE_DIR=/var/lib/{{ vla }}
ROBOLAB_IMAGE="robolab-local:{{ robolab_commit[:12] }}"   # robolab:<pin> + imageio-ffmpeg
SERVER_IMAGE="{{ backend }}-server:{{ server_commit[:12] }}"
RUN_ID=$(date '+%Y-%m-%d-%H%M')

S3_BUCKET="${S3BucketName}"
SNS_TOPIC_ARN="${SnsTopicArn}"
STACK_NAME="${StackName}"
WAIT_CONDITION_URL="${WaitConditionUrl}"
REGION="${Region}"
AUTO_TERMINATE="${AutoTerminate}"

export HOME=/root
export DEBIAN_FRONTEND=noninteractive
LOG=/var/log/{{ vla }}-userdata.log

log() { echo "[{{ vla|upper }}] $(date '+%H:%M:%S') $*" | tee -a "$LOG"; }

cfn_signal() {
    local exit_code=$1
    local _status
    [ "$exit_code" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
    log "cfn_signal: $_status -> WaitCondition"
    local _token
    _token=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
    local _instance_id
    _instance_id=$(curl -s -H "X-aws-ec2-metadata-token: $_token" \
        "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
    local _data
    _data="{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_instance_id}\",\"Data\":\"${_status}\"}"
    curl -s -X PUT -H 'Content-Type:' \
        --data-binary "$_data" \
        "$WAIT_CONDITION_URL" \
        2>&1 | tee -a "$LOG" \
        && log "cfn_signal $_status sent" \
        || log "[warn] cfn_signal send failed (continuing)"
}

upload_diag() {
    [ -n "${S3_BUCKET:-}" ] && [ -n "${REGION:-}" ] || return 0
    local _diag="s3://${S3_BUCKET}/${RUN_ID:-unknown-run}/diag"
    aws s3 cp "$LOG" "${_diag}/userdata.log" --region "$REGION" 2>/dev/null || true
    for _f in /tmp/{{ vla }}_*.log; do
        [ -f "$_f" ] || continue
        aws s3 cp "$_f" "${_diag}/$(basename "$_f")" --region "$REGION" 2>/dev/null || true
    done
    for _c in $(docker ps -a --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null | grep -E '^(policy|robolab)-shard-' || true); do
        docker logs "$_c" > "/tmp/{{ vla }}_container_${_c}.log" 2>&1 || true
        aws s3 cp "/tmp/{{ vla }}_container_${_c}.log" "${_diag}/container_${_c}.log" --region "$REGION" 2>/dev/null || true
    done
}

die() {
    log "ERROR: $*"
    upload_diag
    cfn_signal 1
    exit 1
}

_trap_sent=false
_trap_handler() {
    if [ "$_trap_sent" = false ]; then
        _trap_sent=true
        log "ERROR: Script exited abnormally (line ${BASH_LINENO[0]:-?})"
        upload_diag
        cfn_signal 1
    fi
}
trap '_trap_handler' ERR

log "===== {{ display_name }} UserData start (RUN_ID: ${RUN_ID}, variant {{ variant }}) ====="

META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "unknown")
INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" \
    "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo "unknown")
log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"

# ── [0/9] ECC off on L40S/L4 (Isaac Sim / Omniverse crash with ECC on, NGC #331666) ──────────
# Same two-boot pattern as openarm-isaac (see that template for the deploy history): the ECC mode is
# unreadable this early, so boot 1 writes the pending mode unconditionally and reboots; a systemd
# oneshot re-runs this script on boot 2 with the bootstrap's exported variables.
mkdir -p "$STATE_DIR"
if [ ! -f "${STATE_DIR}/userdata-done" ] && [ ! -f "${STATE_DIR}/ecc-done" ]; then
    _driver_ready=false
    for _attempt in $(seq 1 60); do
        if nvidia-smi -L 2>/dev/null | grep -q '^GPU 0:'; then _driver_ready=true; break; fi
        log "[0/9] waiting for the NVIDIA driver (${_attempt}/60)"
        sleep 5
    done
    [ "$_driver_ready" = true ] || die "[0/9] nvidia-smi never listed a GPU"
    USERDATA_SRC=$(readlink -f "$0" 2>/dev/null || echo /var/lib/cloud/instance/scripts/part-001)
    [ -f "$USERDATA_SRC" ] || USERDATA_SRC=/var/lib/cloud/instance/scripts/part-001
    [ -f "$USERDATA_SRC" ] || die "[0/9] user-data source not found for the post-reboot resume"
    cp "$USERDATA_SRC" "${STATE_DIR}/userdata-resume.sh"
    chmod +x "${STATE_DIR}/userdata-resume.sh"
    awk '/^export /' /var/lib/cloud/instance/scripts/part-001 | sed 's/^export //' > "${STATE_DIR}/userdata-env"
    chmod 600 "${STATE_DIR}/userdata-env"
    cat > /etc/systemd/system/{{ vla }}-resume.service <<UNIT
[Unit]
Description={{ vla }} UserData resume (post-ECC-disable reboot)
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=${STATE_DIR}/ecc-done
ConditionPathExists=!${STATE_DIR}/userdata-done

[Service]
Type=oneshot
EnvironmentFile=${STATE_DIR}/userdata-env
ExecStart=${STATE_DIR}/userdata-resume.sh
StandardOutput=journal
StandardError=journal
RemainAfterExit=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable {{ vla }}-resume.service 2>&1 | tee -a "$LOG" || die "[0/9] could not enable the resume unit"
    nvidia-smi -e 0 2>&1 | tee -a "$LOG" || die "[0/9] nvidia-smi -e 0 failed"
    touch "${STATE_DIR}/ecc-done"
    aws s3 cp "$LOG" "s3://${S3_BUCKET}/${RUN_ID}-boot1/logs/userdata.log" --region "$REGION" 2>/dev/null || true
    log "[0/9] ECC disable pending; rebooting (boot 2 gets a new RUN_ID, the WaitCondition stays open)"
    systemctl reboot
    sleep 120
    exit 0
fi
log "[0/9] post-reboot resume (ECC already disabled)"

# ── [1/9] System packages + hardening of the GPU-container host ────────────────────────────────
log "[1/9] System packages..."
systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
# apt-daily-upgrade's systemctl daemon-reload revokes GPU access from running containers on this
# cgroup-v2 host; stop and mask the timers before any GPU container starts.
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl disable apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl mask apt-daily.service apt-daily-upgrade.service unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
pkill -9 -f "unattended-upgrade" 2>/dev/null || true
sleep 5
rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
dpkg --configure -a > /tmp/{{ vla }}_dpkg_fix.log 2>&1 || true
rm -f /etc/apt/apt.conf.d/50command-not-found 2>/dev/null || true
APT_RETRY=0
until timeout 600 apt-get update -qq -o DPkg::Lock::Timeout=300 > /tmp/{{ vla }}_apt_update.log 2>&1; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get update failed after 3 retries"
    sleep 30
done
APT_RETRY=0
until apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
    git git-lfs curl ca-certificates awscli jq python3 > /tmp/{{ vla }}_apt.log 2>&1; do
    APT_RETRY=$((APT_RETRY + 1))
    [ $APT_RETRY -ge 3 ] && die "apt-get install failed after 3 retries"
    sleep 30
done
command -v docker >/dev/null 2>&1 || die "docker not found (the Deep Learning AMI ships Docker + the NVIDIA Container Toolkit)"
git lfs install --system > /dev/null 2>&1 || true

log "[1.5/9] CloudWatch Logs agent..."
if [ -f /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
    cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/{{ vla }}-userdata.log",
            "log_group_name": "/{{ vla }}/userdata",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWEOF
    /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s > /tmp/{{ vla }}_cwagent.log 2>&1 \
        && log "  CW agent started (log group /{{ vla }}/userdata)" || log "[warn] CW agent start failed"
fi

# Docker: cgroupfs driver so a stray daemon-reload cannot revoke GPU device access mid-run (same fix
# as cosmos-policy), and the NVIDIA runtime registered.
nvidia-ctk runtime configure --runtime=docker > /dev/null 2>&1 || true
python3 - <<'PYEOF' || die "could not set the Docker cgroup driver"
import json, os
p = "/etc/docker/daemon.json"
cfg = json.load(open(p)) if os.path.exists(p) and os.path.getsize(p) else {}
opts = [o for o in cfg.get("exec-opts", []) if not o.startswith("native.cgroupdriver=")]
cfg["exec-opts"] = opts + ["native.cgroupdriver=cgroupfs"]
json.dump(cfg, open(p, "w"), indent=2)
PYEOF
systemctl restart docker 2>/dev/null || true

# ── [2/9] GPU layout, VRAM / host RAM / driver floors ──────────────────────────────────────────
log "[2/9] GPU check..."
nvidia-smi --query-gpu=index,name,memory.total,driver_version,ecc.mode.current --format=csv 2>&1 | tee -a "$LOG" || true
N_GPU=$(nvidia-smi -L 2>/dev/null | grep -c '^GPU ' || echo 0)
GPU_MEM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | sort -n | head -1 | tr -d ' ' || echo 0)
DRIVER_MAJOR=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 | cut -d. -f1 | tr -d ' ' || echo 0)
HOST_MEM_MIB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
log "  GPUs: ${N_GPU} (smallest ${GPU_MEM_MIB} MiB), driver ${DRIVER_MAJOR}, host RAM ${HOST_MEM_MIB} MiB"
[ "${GPU_MEM_MIB:-0}" -ge {{ min_gpu_mib }} ] || die "every GPU needs >= {{ min_gpu_mib }} MiB (Isaac Sim + policy); smallest has ${GPU_MEM_MIB} MiB. See models/{{ vla }}.yaml"
[ "${HOST_MEM_MIB:-0}" -ge {{ min_host_mib }} ] || die "needs >= {{ min_host_mib }} MiB host RAM; host has ${HOST_MEM_MIB} MiB. See models/{{ vla }}.yaml"
[ "${DRIVER_MAJOR:-0}" -ge {{ min_driver_major }} ] || die "NVIDIA driver ${DRIVER_MAJOR} < {{ min_driver_major }} (needed by the policy-server CUDA image)"
SHARDS=$(( N_GPU / {{ gpus_per_shard }} ))
if [ "$SHARDS" -gt {{ shards }} ]; then SHARDS={{ shards }}; fi
[ "$SHARDS" -ge 1 ] || die "variant {{ variant }} needs {{ gpus_per_shard }} GPU(s) per shard; instance has ${N_GPU}"
log "  shards: ${SHARDS} (max {{ shards }}, {{ gpus_per_shard }} GPU(s) each)"
sim_gpu() { echo $(( $1 * {{ gpus_per_shard }} )); }
server_gpu() { echo $(( $1 * {{ gpus_per_shard }} + {{ gpus_per_shard }} - 1 )); }

mkdir -p "$WORK" "$OUT_DIR" "$HF_CACHE" "${CACHE_DIR}/openpi"
HF_TOKEN=$(aws ssm get-parameter --name /vla-simulator/hf-token --with-decryption \
    --query 'Parameter.Value' --output text --region "$REGION" 2>/dev/null || echo "")
if [ -z "$HF_TOKEN" ] || [ "$HF_TOKEN" = "None" ]; then HF_TOKEN=""; log "  no HF token in SSM (optional: the repos are public)"; fi
export HF_TOKEN
NGC_API_KEY=$(aws ssm get-parameter --name /vla-simulator/ngc-api-key --with-decryption \
    --query 'Parameter.Value' --output text --region "$REGION" 2>/dev/null || echo "")
if [ -n "$NGC_API_KEY" ] && [ "$NGC_API_KEY" != "None" ]; then
    echo "$NGC_API_KEY" | docker login nvcr.io --username '$oauthtoken' --password-stdin > /tmp/{{ vla }}_ngc_login.log 2>&1 \
        && log "  NGC login OK" || log "[warn] NGC login failed, trying an anonymous pull"
fi

# Clone a repo at a pinned commit (fails loudly on a mismatch).
clone_pinned() {
    local _url=$1 _dir=$2 _commit=$3
    if [ ! -d "${_dir}/.git" ]; then
        GIT_LFS_SKIP_SMUDGE=1 git clone -q "$_url" "$_dir" > "/tmp/{{ vla }}_clone_$(basename "$_dir").log" 2>&1 || return 1
    fi
    GIT_LFS_SKIP_SMUDGE=1 git -C "$_dir" checkout -q "$_commit" || return 1
    [ "$(git -C "$_dir" rev-parse HEAD)" = "$_commit" ]
}

# ── [3/9] RoboLab @ pin + its Git LFS assets + its Docker image ────────────────────────────────
log "[3/9] RoboLab {{ robolab_commit[:8] }}..."
clone_pinned "{{ robolab_repo }}" "$ROBOLAB_DIR" "{{ robolab_commit }}" || die "RoboLab clone/checkout failed"
# ~6.2 GB of USD scenes / objects / robots (1,620 of the pin's 1,644 LFS objects live under assets/; the other
# 24 are docs/ images and an example .hdf5 that the benchmark never reads). The Dockerfile COPYs assets/.
for _i in 1 2 3; do
    timeout 3600 git -C "$ROBOLAB_DIR" lfs pull --include "assets/**" > /tmp/{{ vla }}_lfs.log 2>&1 && break
    log "[warn] git lfs pull attempt ${_i} failed, retrying in 60s"; sleep 60
done
# Count only assets/: `lfs ls-files` lists the whole repo, and the 24 docs/examples objects are never pulled
# (the first GPU run died here on exactly those 24 with every asset present).
_lfs_missing=$(git -C "$ROBOLAB_DIR" lfs ls-files 2>/dev/null | awk '$2 == "-" && $3 ~ /^assets\// {n++} END {print n+0}')
log "  LFS objects still pointers: ${_lfs_missing} ($(du -sh "${ROBOLAB_DIR}/assets" 2>/dev/null | cut -f1))"
[ "${_lfs_missing:-1}" -eq 0 ] || die "RoboLab assets incomplete (${_lfs_missing} LFS objects not downloaded, see /tmp/{{ vla }}_lfs.log)"

log "[3/9] docker build ${ROBOLAB_IMAGE} (RoboLab docker/build_docker.sh on isaac-lab:{{ isaac_lab_tag.split('@')[0] }})..."
( cd "$ROBOLAB_DIR" && bash docker/build_docker.sh "--isaaclab-tag={{ isaac_lab_tag }}" "{{ robolab_commit[:12] }}" ) \
    > /tmp/{{ vla }}_robolab_build.log 2>&1 || die "RoboLab image build failed (see /tmp/{{ vla }}_robolab_build.log)"
# RoboLab's VideoWriter pipes frames to ffmpeg through imageio; the Dockerfile installs no ffmpeg, so add the
# imageio-ffmpeg wheel (bundled static ffmpeg) when the Kit python cannot import it.
docker build --network=host -t "$ROBOLAB_IMAGE" - > /tmp/{{ vla }}_robolab_build2.log 2>&1 <<'DFEOF' || die "RoboLab ffmpeg layer build failed (see /tmp/{{ vla }}_robolab_build2.log)"
FROM robolab:{{ robolab_commit[:12] }}
RUN /workspace/isaaclab/_isaac_sim/python.sh -c "import imageio_ffmpeg" 2>/dev/null \
    || /workspace/isaaclab/_isaac_sim/python.sh -m pip install --no-cache-dir imageio-ffmpeg==0.6.0
DFEOF
log "  built $(docker image inspect "$ROBOLAB_IMAGE" --format '{{ '{{' }}.Size{{ '}}' }}' | awk '{printf "%.1f GB", $1/1e9}')"

# ── [4/9] Policy-server image ──────────────────────────────────────────────────────────────────
log "[4/9] {{ backend }} policy server {{ server_commit[:8] }}..."
clone_pinned "{{ server_repo }}" "$SERVER_DIR" "{{ server_commit }}" || die "policy-server clone/checkout failed"
{% if backend == "cosmos3" %}
# NVIDIA/cosmos-framework Dockerfile: CUDA base + uv sync --all-extras --group=<cu>-train; apex skipped as
# its docs do for serving. A derived image adds the policy-server group (openpi-server) the README syncs
# at container start, so every shard starts from the same pre-synced environment.
( cd "$SERVER_DIR" && DOCKER_BUILDKIT=1 docker build --network=host \
    --build-arg "BASE_IMAGE={{ server_base_image }}" --build-arg "CUDA_VERSION={{ server_cuda_version }}" \
    --build-arg INSTALL_APEX=0 -t cosmos-framework:local . ) > /tmp/{{ vla }}_server_build.log 2>&1 \
    || die "cosmos-framework image build failed (see /tmp/{{ vla }}_server_build.log)"
docker build --network=host -t "$SERVER_IMAGE" - > /tmp/{{ vla }}_server_build2.log 2>&1 <<'DFEOF' || die "policy-server layer build failed (see /tmp/{{ vla }}_server_build2.log)"
FROM cosmos-framework:local
RUN cd /workspace && uv sync --locked --all-extras{% for g in server_uv_groups %} --group={{ g }}{% endfor %}

DFEOF
{% else %}
# openpi serve_policy.Dockerfile (CUDA 12.2 runtime, uv sync --frozen). Same UV_HTTP_TIMEOUT bump as the pi target.
sed -i 's/uv sync --frozen/UV_HTTP_TIMEOUT=300 uv sync --frozen/g' "${SERVER_DIR}/scripts/docker/serve_policy.Dockerfile"
# The fork's models_pytorch/gemma_pytorch.py does `import pytest` at import time, but pytest is a dev
# dependency and the Dockerfile syncs --no-dev: the first robolab-pi05 GPU run died in serve_policy.py with
# ModuleNotFoundError: pytest. Add it (version = the fork's uv.lock) before the CMD line.
sed -i '/^CMD /i RUN uv pip install --python /.venv/bin/python pytest==8.3.5' "${SERVER_DIR}/scripts/docker/serve_policy.Dockerfile"
grep -q '^RUN uv pip install --python /.venv/bin/python pytest==8.3.5' "${SERVER_DIR}/scripts/docker/serve_policy.Dockerfile" \
    || die "openpi Dockerfile: pytest layer not inserted"
( cd "$SERVER_DIR" && DOCKER_BUILDKIT=1 docker build --network=host -t "$SERVER_IMAGE" \
    -f scripts/docker/serve_policy.Dockerfile . ) > /tmp/{{ vla }}_server_build.log 2>&1 \
    || die "openpi server image build failed (see /tmp/{{ vla }}_server_build.log)"
{% endif %}
log "  built ${SERVER_IMAGE}"

# GPU visible inside both images (cheap gate before the long downloads).
docker run --rm --gpus "device=0" --entrypoint nvidia-smi "$ROBOLAB_IMAGE" -L > /tmp/{{ vla }}_gpu_check.log 2>&1 \
    || die "GPU not visible inside the RoboLab image (see /tmp/{{ vla }}_gpu_check.log)"

# ── [5/9] Checkpoint (one download, shared read-only by every shard) ───────────────────────────
{% if backend == "cosmos3" %}
log "[5/9] {{ hf_repo }} @ {{ hf_model_revision[:8] }}..."
for _i in 1 2; do
    # Same code path the server uses (CheckpointDirHf -> the framework's locked `hf download` CLI), so the
    # servers find every file in the shared cache.
    timeout 3600 docker run --rm --network host -e HF_TOKEN -e HF_HOME=/hf -e UV_CACHE_DIR=/hf/uv-cache \
        -e HF_XET_CLIENT_READ_TIMEOUT=60 -e HF_XET_CLIENT_CONNECT_TIMEOUT=30 -v "${HF_CACHE}:/hf" -w /workspace \
        --entrypoint /workspace/.venv/bin/python "$SERVER_IMAGE" -c \
        "from cosmos_framework.utils.checkpoint_db import CheckpointDirHf; print(CheckpointDirHf(repository='{{ hf_repo }}', revision='{{ hf_model_revision }}').download())" \
        > /tmp/{{ vla }}_hf_download.log 2>&1 && break
    log "[warn] checkpoint download attempt ${_i} failed or stalled, retrying (resumes from the cache)"
    [ "$_i" -eq 2 ] && die "checkpoint download failed (see /tmp/{{ vla }}_hf_download.log)"
done
log "  $(tail -1 /tmp/{{ vla }}_hf_download.log) ($(du -sh "$HF_CACHE" | cut -f1))"
{% else %}
log "[5/9] {{ checkpoint_dir }} (public GCS, ~12 GB)..."
for _i in 1 2; do
    timeout 3600 docker run --rm --network host -e OPENPI_DATA_HOME=/openpi -v "${CACHE_DIR}/openpi:/openpi" \
        -e PYTHONPATH=/app/src -v "${SERVER_DIR}:/app" -w /app "$SERVER_IMAGE" /.venv/bin/python -c \
        "from openpi.shared import download; print(download.maybe_download('{{ checkpoint_dir }}'))" \
        > /tmp/{{ vla }}_ckpt_download.log 2>&1 && break
    log "[warn] checkpoint download attempt ${_i} failed, retrying"
    [ "$_i" -eq 2 ] && die "checkpoint download failed (see /tmp/{{ vla }}_ckpt_download.log)"
done
log "  $(tail -1 /tmp/{{ vla }}_ckpt_download.log) ($(du -sh "${CACHE_DIR}/openpi" | cut -f1))"
{% endif %}

# ── [6/9] Start one policy server per shard and wait until it accepts connections ──────────────
log "[6/9] Starting ${SHARDS} policy server(s)..."
start_server() {
    local _s=$1 _gpu _port
    _gpu=$(server_gpu "$_s"); _port=$((8000 + _s))
    docker rm -f "policy-shard-${_s}" > /dev/null 2>&1 || true
{% if backend == "cosmos3" %}
    docker run -d --name "policy-shard-${_s}" --gpus "device=${_gpu}" --network host --ipc=host \
        -e HF_TOKEN -e HF_HOME=/hf -e UV_CACHE_DIR=/hf/uv-cache -v "${HF_CACHE}:/hf" -w /workspace \
        --entrypoint /workspace/.venv/bin/python "$SERVER_IMAGE" \
        -m cosmos_framework.scripts.action_policy_server_robolab \
        --checkpoint-path "{{ hf_repo }}" --hf-revision "{{ hf_model_revision }}" --port "$_port"{% for a in server_args %} {{ a }}{% endfor %} \
        > /dev/null
{% else %}
    docker run -d --name "policy-shard-${_s}" --gpus "device=${_gpu}" --network host \
        -e XLA_PYTHON_CLIENT_MEM_FRACTION=0.5 -e OPENPI_DATA_HOME=/openpi -v "${CACHE_DIR}/openpi:/openpi" \
        -e PYTHONPATH=/app/src -v "${SERVER_DIR}:/app" -w /app "$SERVER_IMAGE" \
        /.venv/bin/python scripts/serve_policy.py --port "$_port" policy:checkpoint \
        --policy.config={{ policy_config }} --policy.dir={{ checkpoint_dir }} > /dev/null
{% endif %}
}
for _s in $(seq 0 $((SHARDS - 1))); do
    start_server "$_s" || die "could not start policy-shard-${_s}"
done
_deadline=$(( $(date +%s) + {{ server_warmup_timeout }} ))
for _s in $(seq 0 $((SHARDS - 1))); do
    _port=$((8000 + _s))
    until (exec 3<>"/dev/tcp/127.0.0.1/${_port}") 2>/dev/null; do
        [ "$(docker inspect -f '{{ '{{' }}.State.Running{{ '}}' }}' "policy-shard-${_s}" 2>/dev/null)" = true ] \
            || die "policy-shard-${_s} exited during warmup (see diag/container_policy-shard-${_s}.log)"
        [ "$(date +%s)" -lt "$_deadline" ] || die "policy-shard-${_s} not listening on :${_port} after {{ server_warmup_timeout }}s"
        sleep 15
    done
    log "  policy-shard-${_s} listening on :${_port} (GPU $(server_gpu "$_s"))"
done

# ── [7/9] RoboLab shards (parallel), each over its slice of the task list ──────────────────────
TASKS=({% for t in tasks %}{{ t }} {% endfor %})
if [ "${{ '{#' }}TASKS[@]}" -eq 0 ]; then
    mapfile -t TASKS < <(jq -r '.[].task_name' "${ROBOLAB_DIR}/robolab/tasks/_metadata/task_metadata.json" | sort)
fi
log "[7/9] {{ label }}: ${{ '{#' }}TASKS[@]} task(s) x {{ num_envs }} env(s) x {{ num_runs }} run(s), ${SHARDS} shard(s)"
run_shard() {
    local _s=$1 _gpu _port _t _i
    _gpu=$(sim_gpu "$_s"); _port=$((8000 + _s))
    local _mine=()
    for _i in "${!TASKS[@]}"; do
        [ $(( _i % SHARDS )) -eq "$_s" ] && _mine+=("${TASKS[$_i]}")
    done
    [ "${{ '{#' }}_mine[@]}" -gt 0 ] || return 0
    mkdir -p "${OUT_DIR}/shard-${_s}" "${CACHE_DIR}/shard-${_s}/ov" "${CACHE_DIR}/shard-${_s}/kit"
    echo "shard ${_s}: GPU ${_gpu}, server :${_port}, tasks: ${_mine[*]}"
    docker rm -f "robolab-shard-${_s}" > /dev/null 2>&1 || true
    # timeout -> SIGTERM to `docker run`, which proxies it to the container; RoboLab has already written
    # every finished episode to episode_results.jsonl, so a timeout still yields a partial report.
    timeout --signal=TERM --kill-after=180 {{ eval_timeout_min * 60 }} \
        docker run --rm --name "robolab-shard-${_s}" --gpus "device=${_gpu}" --network host \
        --entrypoint /workspace/isaaclab/_isaac_sim/python.sh \
        -e ACCEPT_EULA=Y -e OMNI_KIT_ACCEPT_EULA=YES -e PRIVACY_CONSENT=Y -e OMNI_KIT_ALLOW_ROOT=1 \
        -v "${CACHE_DIR}/shard-${_s}/ov:/root/.cache/ov" -v "${CACHE_DIR}/shard-${_s}/kit:/isaac-sim/kit/cache" \
        -v "${OUT_DIR}/shard-${_s}:/workspace/robolab/output" -w /workspace/robolab \
        "$ROBOLAB_IMAGE" {{ client_script }} --headless{% for a in client_args %} {{ a }}{% endfor %} \
        --remote-host 127.0.0.1 --remote-port "$_port" --task "${_mine[@]}" \
        --num-envs {{ num_envs }} --num-runs {{ num_runs }} --seed {{ seed }} \
        --instruction-type {{ instruction_type }} --video-mode {{ video_mode }} --output-folder-name run
}
set +e
trap - ERR
SHARD_PIDS=()
for _s in $(seq 0 $((SHARDS - 1))); do
    run_shard "$_s" > "/tmp/{{ vla }}_shard${_s}.log" 2>&1 &
    SHARD_PIDS+=($!)
    sleep 20   # stagger Isaac Sim first boots (shader cache, asset loads)
done
EVAL_FAILED=0
for _s in "${!SHARD_PIDS[@]}"; do
    wait "${SHARD_PIDS[$_s]}"
    _rc=$?
    log "  shard ${_s} exit=${_rc} ($(grep -c . "${OUT_DIR}/shard-${_s}/run/episode_results.jsonl" 2>/dev/null || echo 0) episode(s))"
    [ "$_rc" -eq 0 ] || EVAL_FAILED=1
done
set -e
trap '_trap_handler' ERR
for _s in $(seq 0 $((SHARDS - 1))); do
    docker logs "policy-shard-${_s}" > "/tmp/{{ vla }}_server${_s}.log" 2>&1 || true
    docker rm -f "policy-shard-${_s}" > /dev/null 2>&1 || true
done

# ── [8/9] Report (summary.txt + robolab_results.json + videos with success= in the name) ───────
log "[8/9] Report + S3 upload..."
base64 -d > "${WORK}/robolab_report.py" << 'REPORT_PY_EOF'
{{ report_py_b64 -}}
REPORT_PY_EOF
UPLOAD_DIR="${WORK}/upload/task-0"
rm -rf "$UPLOAD_DIR"; mkdir -p "$UPLOAD_DIR"
RUN_DIRS=()
for _s in $(seq 0 $((SHARDS - 1))); do RUN_DIRS+=(--run-dir "${OUT_DIR}/shard-${_s}/run"); done
KN=$(python3 "${WORK}/robolab_report.py" "${RUN_DIRS[@]}" --upload-dir "$UPLOAD_DIR" \
    --label "{{ label }}" --tasks "${TASKS[*]}" --episodes-per-task {{ num_envs * num_runs }} \
    --task-metadata "${ROBOLAB_DIR}/robolab/tasks/_metadata/task_metadata.json" \
    --max-videos-per-task {{ max_videos_per_task }} \
    --meta "model={{ vla }} ({{ policy_label }})" \
    --meta "checkpoint={{ checkpoint_ref }}" \
    --meta "code={{ server_repo }}@{{ server_commit[:8] }}" \
    --meta "description={{ description }}" \
    --meta "variant={{ variant }}" \
    --meta "instruction_type={{ instruction_type }}" \
    --meta "leaderboard_reference={{ leaderboard }}" \
    --meta "stack_robolab={{ robolab_commit[:8] }}" \
    --meta "stack_isaac_lab={{ isaac_lab_tag.split('@')[0] }}" \
    --meta "stack_server={{ server_commit[:8] }}" \
    --meta "shards=${SHARDS}" \
    --meta "instance=${INSTANCE_TYPE}" 2> /tmp/{{ vla }}_report.log | tail -1) || die "report failed (see /tmp/{{ vla }}_report.log)"
N_EPISODES=${KN#*/}
log "  {{ label }}: ${KN} episodes succeeded ($(jq -r '.success_rate // "n/a"' "${UPLOAD_DIR}/robolab_results.json"))"

S3_TASK_PREFIX="s3://${S3_BUCKET}/${RUN_ID}/task-0"
aws s3 cp "${UPLOAD_DIR}/summary.txt" "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true
{% from "_protocol-card.sh.j2" import protocol_card with context %}{{ protocol_card('"${UPLOAD_DIR}/summary.txt"', '"${S3_TASK_PREFIX}"') }}
aws s3 cp "${UPLOAD_DIR}/robolab_results.json" "${S3_TASK_PREFIX}/robolab_results.json" --region "$REGION" || true
for _s in $(seq 0 $((SHARDS - 1))); do
    [ -f "${OUT_DIR}/shard-${_s}/run/episode_results.jsonl" ] && aws s3 cp "${OUT_DIR}/shard-${_s}/run/episode_results.jsonl" \
        "${S3_TASK_PREFIX}/raw/shard-${_s}/episode_results.jsonl" --region "$REGION" || true
    aws s3 cp "/tmp/{{ vla }}_shard${_s}.log" "${S3_TASK_PREFIX}/logs/robolab-shard-${_s}.log" --region "$REGION" || true
    aws s3 cp "/tmp/{{ vla }}_server${_s}.log" "${S3_TASK_PREFIX}/logs/policy-shard-${_s}.log" --region "$REGION" || true
done
UPLOAD_COUNT=0
VIDEO_COUNT=$(find "${UPLOAD_DIR}/videos" -name '*.mp4' | wc -l)
while IFS= read -r mp4_file; do
    fname=$(basename "$mp4_file")
    if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" --region "$REGION" >> "$LOG" 2>&1; then
        UPLOAD_COUNT=$((UPLOAD_COUNT + 1))
        aws s3 cp "${mp4_file%.mp4}.txt" "${S3_TASK_PREFIX}/videos/${fname%.mp4}.txt" --region "$REGION" > /dev/null 2>&1 || true
    fi
done < <(find "${UPLOAD_DIR}/videos" -name '*.mp4' | sort)
log "  videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"
upload_diag

if [ "${N_EPISODES:-0}" -eq 0 ]; then
    die "no RoboLab episode finished (see ${S3_TASK_PREFIX}/logs/)"
fi
if [ "$EVAL_FAILED" -ne 0 ]; then
    die "a RoboLab shard failed or timed out after ${KN} episodes; partial results are in ${S3_TASK_PREFIX}/"
fi

# ── [9/9] SNS + cfn-signal ─────────────────────────────────────────────────────────────────────
log "[9/9] SNS notification..."
{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} complete (RUN_ID: ${RUN_ID})
{{ label }} (variant {{ variant }}): ${KN} episodes succeeded, success_rate=$(jq -r '.success_rate // "n/a"' "${UPLOAD_DIR}/robolab_results.json")
Leaderboard reference (RoboLab-120, 10 ep/task): {{ leaderboard }}

Policy: {{ policy_label }} ({{ checkpoint_ref }})
Benchmark: NVIDIA RoboLab {{ robolab_commit[:8] }}, Isaac Lab {{ isaac_lab_tag.split('@')[0] }}, instructions={{ instruction_type }}
License: {{ license }}
Instance: ${INSTANCE_TYPE}, shards: ${SHARDS}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} complete - ${STACK_NAME}" \
    --message "$SNS_MESSAGE" --region "$REGION" || log "[warn] SNS notification failed (continuing)"

touch "${STATE_DIR}/userdata-done"
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances --instance-ids "$INSTANCE_ID" --region "$REGION" \
        || log "[warn] EC2 terminate failed - please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

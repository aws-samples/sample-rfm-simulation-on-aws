        echo "stack_lerobot_commit: ${ACTUAL_COMMIT}"
        echo "stack_robotwin_commit: ${ROBOTWIN_COMMIT}"
        echo "stack_robotwin_assets: {{ assets_repo }}@{{ assets_revision[:8] }}"
        echo "stack_sapien: ${STACK_SAPIEN}"
        echo "stack_curobo: ${CUROBO_COMMIT:0:8}"
        echo "stack_eval_args: ${EVAL_ARGS[*]}"

            echo ""
            echo "--- Environment ---"
            printf "Benchmark:  RoboTwin 2.0 (%s, task_config %s)\n" "${SETTING}" "${TASK_CONFIG}"
            printf "Robot:      Aloha-AgileX bimanual (2 x 6-DOF arm + gripper, 14-D joint actions)\n"
            printf "Simulator:  SAPIEN %s (Vulkan) + CuRobo, RoboTwin %s\n" "${STACK_SAPIEN}" "${ROBOTWIN_COMMIT:0:8}"
            echo ""
            echo "--- Model ---"
            printf "Checkpoint: %s (rev %s)\n" "{{ hf_repo }}" "{{ hf_model_revision[:8] }}"
            printf "LeRobot:    %s@%s\n" "{{ lerobot_repo }}" "{{ lerobot_commit[:8] }}"
            printf "Policy:     %s\n" "{{ policy_desc }}"
            printf "License:    %s\n" "{{ license }}"
            echo ""
            echo "--- Rollout ---"
            printf "run_id:        %s\n"  "${RUN_ID}"
            printf "task_idx:      %s\n"  "${TASK_IDX}"
            printf "task_success:  %s (pc_success/100 over %s episodes)\n" "${SR}" "${N_EPISODES}"
            echo ""
            echo "--- Infrastructure ---"
            printf "Instance: %s (%s)\n"  "${INSTANCE_ID}" "${INSTANCE_TYPE}"
            printf "Region:   %s\n"  "${REGION}"
            printf "Stack:    %s (CDK)\n" "${STACK_NAME}"
        } > "$txt_file"

        if aws s3 cp "$mp4_file" "${S3_TASK_PREFIX}/videos/${fname}" \
            --region "$REGION" 2>&1 | tee -a /var/log/{{ vla }}-userdata.log; then
            UPLOAD_COUNT=$((UPLOAD_COUNT+1))
            aws s3 cp "$txt_file" "${S3_TASK_PREFIX}/videos/${base}.txt" \
                --region "$REGION" 2>/dev/null || true
        else
            log "  [warn] Upload failed: $fname"
        fi
    done < <(find "$VIDEO_DIR" -name "*.mp4" 2>/dev/null | sort)
    log "  Videos uploaded: ${UPLOAD_COUNT}/${VIDEO_COUNT}"

    aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}.log" \
        "${S3_TASK_PREFIX}/eval.log" --region "$REGION" || true
    [ -f "${INFO_JSON}" ] && \
        aws s3 cp "${INFO_JSON}" \
        "${S3_TASK_PREFIX}/eval_info.json" --region "$REGION" || true
    # Only a finished eval gets a summary.txt: `vlasim results` shows a task without one as running/failed.
    if [ "${EVAL_EXIT}" -eq 0 ] && [ -f "${INFO_JSON}" ]; then
        aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" \
            "${S3_TASK_PREFIX}/summary.txt" --region "$REGION" || true
    else
        aws s3 cp "/tmp/{{ vla }}_task${TASK_IDX}_summary.txt" \
            "${S3_TASK_PREFIX}/summary.failed.txt" --region "$REGION" || true
    fi
    if [ "${EVAL_EXIT}" -eq 0 ] && [ "${VIDEO_COUNT}" -eq 0 ]; then
        log "  [error] Task ${TASK_IDX} produced 0 rollout videos"
        FAILED_TASKS="${FAILED_TASKS} ${TASK_IDX}:${RT_TASK}:no-videos"
    fi

    SUMMARY_ALL="${SUMMARY_ALL}
[Task $((TASK_IDX+1))] ${SUITE} ${RT_TASK} — success_rate=${SR} (${N_EPISODES} ep, exit ${EVAL_EXIT})"
    log "  Task $((TASK_IDX+1)) done"
done

# ── [8/8] SNS notification + cfn-signal ──────────────────────────
log "[8/8] Sending SNS notification..."

{% include "_gallery-sns.sh.j2" %}
SNS_MESSAGE="[${STACK_NAME}] {{ display_name }} RoboTwin 2.0 simulation complete (RUN_ID: ${RUN_ID})
${SUMMARY_ALL}
${FAILED_TASKS:+
Failed tasks:${FAILED_TASKS}
}
Model: {{ policy_desc }}
Checkpoint: {{ hf_repo }} (rev {{ hf_model_revision[:8] }})
LeRobot: {{ lerobot_repo }}@{{ lerobot_commit[:8] }}
License: {{ license }}
Simulation: RoboTwin 2.0 @{{ robotwin_commit[:8] }} (SAPIEN + CuRobo, Aloha-AgileX), plan {{ protocol }}{% if shard %} shard {{ shard }}{% endif %}
Instance: ${INSTANCE_TYPE}

${GALLERY_BLOCK}Download results:
  aws s3 sync s3://${S3_BUCKET}/${RUN_ID}/ ./{{ vla }}-results/${RUN_ID}/ --region ${REGION}

Teardown:
  python destroy.py --vla {{ vla }}"

aws sns publish \
    --topic-arn "$SNS_TOPIC_ARN" \
    --subject "{{ display_name }} RoboTwin 2.0 simulation complete — ${STACK_NAME}" \
    --message "$SNS_MESSAGE" \
    --region "$REGION" \
    || log "[warn] SNS notification failed (continuing)"

if [ -n "${FAILED_TASKS}" ]; then
    die "RoboTwin task(s) failed:${FAILED_TASKS} — see s3://${S3_BUCKET}/${RUN_ID}/task-N/eval.log"
fi

log "[8/8] Sending cfn-signal..."
cfn_signal 0

if [ "${AUTO_TERMINATE}" = "true" ]; then
    log "[auto-terminate] Terminating EC2 instance..."
    TOKEN=$(curl -s -X PUT \
        "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    INSTANCE_ID=$(curl -s \
        -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
    aws ec2 terminate-instances \
        --instance-ids "$INSTANCE_ID" \
        --region "$REGION" \
        || log "[warn] EC2 terminate failed — please terminate manually"
fi

log "===== {{ display_name }} UserData complete ====="

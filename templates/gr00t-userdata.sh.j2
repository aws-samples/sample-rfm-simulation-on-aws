register_simpler_envs()
env = gym.make(sys.argv[1])
obs, _ = env.reset()
print("verify OK:", sys.argv[1], sorted(k for k in obs if k.startswith(("video.", "state."))))
env.close()
GR00T_SIMPLER_VERIFY_EOF
{%- else -%}

log "[3/6] Installing LIBERO sim environment (10-20 min)..."
cd "${ISAAC_GROOT_DIR}"

# setup_libero.sh line 29 uses $HOME (rm -rf $HOME/.libero).
# In root's non-interactive cloud-init shell $HOME may be unset → set -u failure.
export HOME="${HOME:-/root}"

